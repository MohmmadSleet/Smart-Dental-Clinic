<!DOCTYPE html>
<html dir="<%= typeof lang === 'string' && lang === 'en' ? 'ltr' : 'rtl' %>" lang="<%= typeof lang === 'string' && lang === 'en' ? 'en' : 'ar' %>"><head>
    <meta charset="utf-8">
    <meta content="width=device-width,initial-scale=1" name="viewport">
    <title>المتابعات | Smart Dental Doctor</title>
    <!-- Structural fallback: the original Bootstrap stylesheet stays available in both languages. -->
    <link href="/assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <% if (typeof lang === 'string' && lang === 'en') { %><link href="/assets/vendor/bootstrap.ltr.min.css" rel="stylesheet"><% } %>
    <link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
  <link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  <link rel="stylesheet" href="/assets/i18n.css">
  </head>
  <body><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
    <%- include('../partials/doctor/header') %>
    
    <main class="page-shell" id="main-content"><section class="container py-4 py-lg-5"><div class="mb-4"><span class="badge badge-soft mb-2">Follow-ups</span><h1 class="fw-bold">المتابعات التي أوصيت بها</h1><p class="text-secondary mb-0">حالات المتابعة الفعلية بعد الزيارات المكتملة؛ الحجز يتم من العيادة أو المريض.</p></div>
<div class="row g-3 mb-4 doctor-metrics" aria-label="ملخص المتابعات">
<% const followupStats=[['المتابعات',followups.length],['بانتظار الحجز',followups.filter(f=>f.status==='waiting').length],['متأخرة',followups.filter(f=>f.status==='overdue').length]]; %>
<% for(const m of followupStats){ %><div class="col-6 col-lg-4"><div class="soft-card p-3 h-100"><small class="text-secondary"><%= m[0] %></small><div class="fs-3 fw-bold"><%= m[1] %></div></div></div><% } %></div>
<div class="doctor-section-title mb-3"><h2 class="h5 fw-bold mb-0">تصفية المتابعات</h2><span class="small text-secondary">10 متابعات في الصفحة</span></div>
<div class="filter-panel mb-4"><div class="row g-3"><div class="col-md-8"><div class="input-group"><span class="input-group-text bg-white"><i class="bi bi-search"></i></span><input class="form-control" id="followupSearch" type="search" aria-label="بحث في المتابعات" placeholder="ابحث بالمريض أو نوع المتابعة" autocomplete="off"></div></div><div class="col-md-4"><select class="form-select" id="followupFilter" aria-label="حالة المتابعة"><option value="all">كل الحالات</option><option value="waiting">بانتظار الحجز</option><option value="booked">تم الحجز</option><option value="overdue">متأخرة</option></select></div></div></div>
<div class="doctor-section-title mb-3"><h2 class="h5 fw-bold mb-0">قائمة المتابعات</h2></div><div class="row g-3"><% if(!followups.length){ %><div class="col-12"><div class="soft-card p-4 text-secondary">لا توجد متابعات مقترحة في هذه العيادة.</div></div><% } %>
<% const followLabels={waiting:'بانتظار الحجز',booked:'تم الحجز',overdue:'متأخرة'}; %><% for(const f of followups){ %><div class="col-md-6 followup-filter-item" data-search="<%= f.name+' '+f.type %>" data-status="<%= f.status %>"><div class="patient-card"><div class="d-flex justify-content-between gap-2"><div><h5 class="fw-bold"><%= f.name %></h5><div class="small text-secondary"><%= f.type %></div></div><span class="badge <%= f.status==='booked'?'text-bg-success':f.status==='overdue'?'text-bg-danger':'text-bg-warning' %>"><%= followLabels[f.status] %></span></div><hr><div class="d-flex justify-content-between"><span>التاريخ المقترح</span><strong><%= f.date %></strong></div><% if(f.plan){ %><div class="small text-primary mt-3"><%= sdcT("مرتبط بخطة") %> <%= f.plan %></div><% } %><div class="small text-secondary mt-1"><%= f.notes||'لا توجد ملاحظات إضافية.' %></div><a class="btn btn-outline-primary btn-sm mt-3" href="patient-details?id=<%= f.patient_id %>">ملف المريض</a></div></div><% } %></div>
<div class="doctor-pagination soft-card p-3 mt-3" data-doctor-pager="followups" aria-live="polite" hidden>
  <span class="doctor-pagination-info" data-page-summary></span>
  <nav aria-label="صفحات followups" class="doctor-pagination-controls" data-page-controls></nav>
</div><div class="alert alert-light border mt-3" data-doctor-empty="followups" hidden role="status">لا توجد نتائج تطابق البحث أو الفلاتر المحددة.</div>
</section></main>
    <%- include('../partials/doctor/footer') %>
    <div class="toast-container position-fixed bottom-0 start-0 p-3">
      <div class="toast align-items-center text-bg-primary border-0" id="appToast">
        <div class="d-flex">
          <div class="toast-body">تمت العملية</div>
          <button class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" type="button"></button>
        </div>
      </div>
    </div>
    <script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
  <!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="assets/app.js"></script>


<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button><div class="toast-container position-fixed bottom-0 start-0 p-3"><div id="backendPendingNotice" class="toast align-items-center text-bg-secondary border-0" role="status" aria-live="polite"><div class="d-flex"><div class="toast-body">هذه العملية بانتظار ربط الباك إند. لم تُحفظ أو تتغيّر أي بيانات.</div><button type="button" class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" aria-label="إغلاق"></button></div></div></div><form id="backend-form-1" method="get" data-ui-unbound="" data-backend-binding="filter" hidden=""></form><script defer src="/assets/i18n.js"></script>
  </body></html>