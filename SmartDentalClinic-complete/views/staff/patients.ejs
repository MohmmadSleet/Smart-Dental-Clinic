<!DOCTYPE html>
<html dir="<%= typeof lang === 'string' && lang === 'en' ? 'ltr' : 'rtl' %>" lang="<%= typeof lang === 'string' && lang === 'en' ? 'en' : 'ar' %>"><head>
    <meta charset="utf-8">
    <meta content="width=device-width,initial-scale=1" name="viewport">
    <title>المرضى | Clinic Staff</title>
    <!-- Structural fallback: the original Bootstrap stylesheet stays available in both languages. -->
    <link href="/assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <% if (typeof lang === 'string' && lang === 'en') { %><link href="/assets/vendor/bootstrap.ltr.min.css" rel="stylesheet"><% } %>
    <link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
  <link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  <link rel="stylesheet" href="/assets/i18n.css">
  </head>
  <body data-page-permission="patients.page" data-staff-account-status="active" data-staff-permissions="<%= typeof staffPermissions !== 'undefined' ? staffPermissions : '' %>" data-staff-user-id="<%= typeof currentUser !== 'undefined' && currentUser ? currentUser.userId : '' %>" data-rendered-clinic-id="<%= typeof activeClinic !== 'undefined' && activeClinic ? activeClinic.id : '' %>" data-active-clinic-id="<%= typeof activeClinic !== 'undefined' && activeClinic ? activeClinic.id : '' %>" data-staff-clinic-role="<%= typeof staffClinicRole !== 'undefined' ? staffClinicRole : '' %>"><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
    <%- include('../partials/staff/header') %>
    
    <main class="page-shell" id="main-content" data-staff-workspace="">
      <div class="container pt-3"><div class="staff-context-bar"><div class="staff-context-heading"><i class="bi bi-building"></i><div><small class="text-secondary">تعمل الآن في</small><strong><%= typeof activeClinic !== 'undefined' && activeClinic ? activeClinic.name : 'العيادة' %></strong></div></div><label class="visually-hidden" for="activeClinicContext">العيادة الحالية</label><select class="form-select" id="activeClinicContext" name="active_clinic_id" data-context-switcher="" aria-describedby="staffClinicContextHelp"><% if(typeof activeClinic !== 'undefined' && activeClinic){ %><option value="<%= activeClinic.id %>" data-membership-status="active" data-clinic-role="<%= typeof staffClinicRole !== 'undefined' ? staffClinicRole : 'موظف' %>" data-clinic-permissions="<%= typeof staffPermissions !== 'undefined' ? staffPermissions : '' %>"><%= activeClinic.name %></option><% } %></select><a class="btn btn-outline-primary btn-sm" href="choose-clinic" data-choose-clinic-link><i class="bi bi-arrow-left-right ms-1"></i>تبديل العيادة</a><small class="visually-hidden" id="staffClinicContextHelp">تظهر بيانات وصلاحيات العيادة المختارة فقط.</small></div></div><section class="container py-4 py-lg-5 staff-work-content staff-module-page" data-clinic-content="">
<div class="staff-section-heading d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div><h1 class="fw-bold fs-2 mb-2">المرضى</h1>
    <p class="text-secondary mb-0">ملفات المرضى المرتبطين بالعيادة الحالية — معلومات إدارية محدودة فقط.</p></div>
  <% if(hasStaffPermission('patients.create')){ %><button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#addPatientModal"><i class="bi bi-person-plus"></i> إضافة مريض</button><% } %>
</div>
<% if(message){ %><div class="alert alert-success" role="status"><%= message %></div><% } %>
<% if(typeof staffDirectory !== 'undefined' && staffDirectory){ %>
  <form method="get" action="patients" class="filter-panel d-flex flex-wrap gap-2 mb-3" role="search">
    <label for="staffPatientSearch" class="visually-hidden">بحث باسم المريض أو رقم الملف</label>
    <input class="form-control flex-grow-1" style="max-width:460px" id="staffPatientSearch" name="q" value="<%= staffDirectory.search %>" maxlength="80" placeholder="ابحث بالاسم أو رقم الملف...">
    <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> بحث</button>
    <% if(staffDirectory.search){ %><a class="btn btn-light border" href="patients">مسح البحث</a><% } %>
  </form>
  <div class="staff-list-heading d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><h2 class="h6 fw-bold mb-0">دليل المرضى</h2><span class="badge badge-soft"><%= sdcT("النتائج في هذه الصفحة:") %> <%= staffDirectory.rows.length %></span></div>
  <div class="table-responsive mobile-stack-wrapper table-ui-shell staff-main-table">
    <table class="table align-middle mb-0 responsive-stack-table system-data-table">
      <thead><tr><th>المريض</th><th>رقم الملف</th><th>الهاتف (جزئي)</th></tr></thead>
      <tbody>
        <% if(!staffDirectory.rows.length){ %><tr><td colspan="3" class="text-center py-4">لا توجد ملفات مرضى مطابقة في هذه العيادة.</td></tr><% } %>
        <% for(const p of staffDirectory.rows){ %><tr>
          <td data-label="المريض" class="table-primary-cell"><strong><%= p.name %></strong></td>
          <td data-label="رقم الملف"><%= p.id %></td>
          <td data-label="الهاتف (جزئي)" dir="ltr"><%= p.phone_tail ? '•••• '+p.phone_tail : '—' %></td>
        </tr><% } %>
      </tbody>
    </table>
  </div>
  <nav class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3" aria-label="صفحات قائمة المرضى">
    <small class="text-secondary">رقم الهاتف مخفي جزئيًا؛ لا تظهر هنا عناوين البريد الإلكتروني أو البيانات الصحية أو تواريخ الزيارات.</small>
    <div class="d-flex gap-2">
      <% if(staffDirectory.hasPrevious){ %><a class="btn btn-outline-secondary btn-sm" href="patients?q=<%= encodeURIComponent(staffDirectory.search) %>&page=<%= staffDirectory.page-1 %>">السابق</a><% } %>
      <% if(staffDirectory.hasNext){ %><a class="btn btn-outline-primary btn-sm" href="patients?q=<%= encodeURIComponent(staffDirectory.search) %>&page=<%= staffDirectory.page+1 %>">التالي</a><% } %>
    </div>
  </nav>
<% }else{ %>
  <div class="alert alert-light border"><i class="bi bi-shield-lock text-primary"></i> يمكنك إضافة مريض جديد، لكن ليس لديك صلاحية استعراض ملفات المرضى. يمكن لمدير العيادة منح صلاحية عرض الدليل الإداري المحدود.</div>
<% } %>

      </section>
    <section class="container py-4" id="staffScopeNotice" hidden><div class="soft-card p-4 text-center"><i class="bi bi-building-lock fs-1 text-primary"></i><h3 class="fw-bold mt-3" id="staffScopeTitle">اختر العيادة للمتابعة</h3><p class="text-secondary" id="staffScopeMessage">حدد عيادة لديك عضوية فعّالة فيها لعرض بياناتها وصلاحياتك.</p><a href="choose-clinic" class="btn btn-primary">اختيار العيادة</a></div></section></main>
    <div class="toast-container position-fixed bottom-0 start-0 p-3">
      <div class="toast align-items-center text-bg-primary border-0" id="appToast">
        <div class="d-flex">
          <div class="toast-body">تمت العملية</div>
          <button class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" type="button"></button>
        </div>
      </div>
    </div>
    <script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
  <!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="assets/app.js"></script>


<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button><% if(hasStaffPermission('patients.create')){ %><form id="staff-add-patient-form" action="/staff/workspace/patient" method="post" hidden><input type="hidden" name="csrf_token" value="<%= csrfToken %>"></form><div class="modal fade" id="addPatientModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="fw-bold mb-0">إضافة مريض</h5>
              <button class="btn-close" data-bs-dismiss="modal" type="button"></button>
            </div>
            <div class="modal-body">
              <div class="entity-form-summary mb-3">
                يمكنك إنشاء ملف مريض إداري بدون حساب. لا يجمع موظف الاستقبال معلومات صحية أو يعرض تفاصيل الحساب الشخصية.
              </div>
              <div class="entity-form-section mb-3">
                <div class="entity-form-section-title">
                  <i class="bi bi-person"></i>البيانات الشخصية
                </div>
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label entity-form-required">الاسم الأول</label><input class="form-control" id="clinicPatientFirstName" value="" name="clinic_patient_first_name" required form="staff-add-patient-form">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label entity-form-required">الاسم الأخير</label><input class="form-control" id="clinicPatientLastName" value="" name="clinic_patient_last_name" required form="staff-add-patient-form">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label entity-form-required">تاريخ الميلاد</label><input class="form-control" id="clinicPatientBirthdate" type="date" value="" name="clinic_patient_birthdate" required form="staff-add-patient-form">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label entity-form-required">الجنس</label><select class="form-select" id="clinicPatientGender" name="clinic_patient_gender" form="staff-add-patient-form"><option value="male" selected>ذكر</option><option value="female">أنثى</option></select>
                  </div>
                </div>
              </div>
              <div class="entity-form-section mb-3">
                <div class="entity-form-section-title">
                  <i class="bi bi-telephone"></i>التواصل
                </div>
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label entity-form-required">الهاتف</label><input class="form-control" id="clinicPatientPhone" placeholder="0599 000 000" value="" name="clinic_patient_phone" required form="staff-add-patient-form">
                  </div>

                </div>
              </div>
              <p class="small text-secondary mt-3 mb-0">المعلومات الصحية لا يجمعها موظف الاستقبال؛ يتم استكمالها بصورة مستقلة من المريض أو الطبيب المخوّل.</p>
            </div>
            <div class="modal-footer">
              <button class="btn btn-light" data-bs-dismiss="modal" type="button">
                إلغاء</button><button class="btn btn-primary" id="saveClinicPatientBtn" type="submit" form="staff-add-patient-form">
                إضافة المريض
              </button>
            </div>
          </div>
        </div>
      </div>
<% } %>    <%- include('../partials/staff/footer') %><script defer src="/assets/i18n.js"></script>
  </body></html>