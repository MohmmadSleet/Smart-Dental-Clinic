<!DOCTYPE html>
<html dir="<%= typeof lang === 'string' && lang === 'en' ? 'ltr' : 'rtl' %>" lang="<%= typeof lang === 'string' && lang === 'en' ? 'en' : 'ar' %>"><head>
    <meta charset="utf-8">
    <meta content="width=device-width,initial-scale=1" name="viewport">
    <title>الرئيسية | Clinic Staff</title>
    <!-- Structural fallback: the original Bootstrap stylesheet stays available in both languages. -->
    <link href="/assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <% if (typeof lang === 'string' && lang === 'en') { %><link href="/assets/vendor/bootstrap.ltr.min.css" rel="stylesheet"><% } %>
    <link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
  <link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  <link rel="stylesheet" href="/assets/i18n.css">
  </head>
  <body data-staff-account-status="active" data-staff-permissions="<%= typeof staffPermissions !== 'undefined' ? staffPermissions : '' %>" data-staff-user-id="<%= typeof currentUser !== 'undefined' && currentUser ? currentUser.userId : '' %>" data-rendered-clinic-id="<%= typeof activeClinic !== 'undefined' && activeClinic ? activeClinic.id : '' %>" data-active-clinic-id="<%= typeof activeClinic !== 'undefined' && activeClinic ? activeClinic.id : '' %>" data-staff-clinic-role="<%= typeof staffClinicRole !== 'undefined' ? staffClinicRole : '' %>"><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
    <%- include('../partials/staff/header') %>
    
    <main class="page-shell" id="main-content" data-staff-workspace="">
      <div class="container pt-3"><div class="staff-context-bar"><div class="staff-context-heading"><i class="bi bi-building"></i><div><small class="text-secondary">تعمل الآن في</small><strong><%= typeof activeClinic !== 'undefined' && activeClinic ? activeClinic.name : 'العيادة' %></strong></div></div><label class="visually-hidden" for="activeClinicContext">العيادة الحالية</label><select class="form-select" id="activeClinicContext" name="active_clinic_id" data-context-switcher="" aria-describedby="staffClinicContextHelp"><% if(typeof activeClinic !== 'undefined' && activeClinic){ %><option value="<%= activeClinic.id %>" data-membership-status="active" data-clinic-role="<%= typeof staffClinicRole !== 'undefined' ? staffClinicRole : 'موظف' %>" data-clinic-permissions="<%= typeof staffPermissions !== 'undefined' ? staffPermissions : '' %>"><%= activeClinic.name %></option><% } %></select><a class="btn btn-outline-primary btn-sm" href="choose-clinic" data-choose-clinic-link><i class="bi bi-arrow-left-right ms-1"></i>تبديل العيادة</a><small class="visually-hidden" id="staffClinicContextHelp">تظهر بيانات وصلاحيات العيادة المختارة فقط.</small></div></div><section class="container py-4 py-lg-5 staff-work-content" data-clinic-content="">
        <header class="staff-page-heading staff-dashboard-heading dashboard-hero mb-4">
          <div><span class="staff-eyebrow">مساحة العمل اليومية</span><h1><%= sdcT("مرحبًا،") %> <%= currentUser?.fullName || "بك" %></h1>
          <p>ابدأ من مهامك اليومية داخل <strong><%= activeClinic?.name || 'العيادة' %></strong>. تظهر لك الأدوات المتاحة وفق تكليفك.</p></div>
          <% if(hasStaffPermission('appointments.view')){ %><a class="btn btn-primary" href="appointments"><i class="bi bi-calendar3 ms-1"></i> فتح جدول المواعيد</a><% } %>
        </header>
        <div class="row g-3 mb-4 staff-dashboard-stats">
          <% if(hasStaffPermission('appointments.view')){ %><div class="col-6 col-lg-3">
            <a class="stat-card d-block text-dark" href="appointments" data-requires-permission="appointments.view"><small class="text-secondary">مواعيد اليوم</small>
              <div class="stat-value"><%= typeof staffStats!=="undefined"?staffStats.appointments:"—" %></div>
              <small class="text-secondary">من مواعيد اليوم</small></a>
          </div><% } %>
          <% if(hasStaffPermission('patients.page')){ %><div class="col-6 col-lg-3">
            <a class="stat-card d-block text-dark" href="patients" data-requires-permission="patients.page"><small class="text-secondary">المرضى</small>
              <div class="stat-value"><i class="bi bi-person-plus"></i></div>
              <small class="text-secondary">دليل إداري محدود حسب الصلاحية</small></a>
          </div><% } %>
          <% if(hasStaffPermission('lab_orders.view')){ %><div class="col-6 col-lg-3">
            <a class="stat-card d-block text-dark" href="lab-cases" data-requires-permission="lab_orders.view"><small class="text-secondary">حالات المختبر المفتوحة</small>
              <div class="stat-value"><%= typeof staffStats!=="undefined"?staffStats.labs:"—" %></div>
              <small class="text-secondary">بانتظار الإرسال أو الاستلام</small></a>
          </div><% } %>
          <% if(hasStaffPermission('invoices.view')){ %><div class="col-6 col-lg-3">
            <a class="stat-card d-block text-dark" href="invoices" data-requires-permission="invoices.view"><small class="text-secondary">دفعات اليوم</small>
              <div class="stat-value"><%= typeof staffStats!=="undefined"?staffStats.payments.toFixed(2):"—" %></div>
              <small class="text-secondary">شيكل محصل اليوم</small></a>
          </div><% } %>
          
        </div>
        <div class="staff-section-heading mb-3"><h2 class="h5 fw-bold mb-1">مهامك وأدوات العمل</h2><p class="text-secondary small mb-0">إجراءات يومية وأقسام يمكنك الوصول إليها ضمن الصلاحيات الممنوحة.</p></div>
        <div class="row g-4 staff-dashboard-panels">
          <div class="col-lg-7">
            <div class="soft-card p-4 h-100">
              <h3 class="section-title mb-3">مهام سريعة</h3>
              <% if(hasStaffPermission('appointments.view')){ %><div class="action-row">
                <span class="icon-box"><i class="bi bi-calendar-check"></i></span>
                <div class="flex-grow-1">
                  <strong>مراجعة طلبات مواعيد جديدة</strong>
                  <div class="small text-secondary">افتح صفحة المواعيد للاطلاع على الحالات.</div>
                </div>
                <a class="btn btn-sm btn-primary" href="appointments" data-requires-permission="appointments.view">فتح</a>
              </div><% } %>
              <% if(hasStaffPermission('invoices.view')){ %><div class="action-row">
                <span class="icon-box"><i class="bi bi-receipt"></i></span>
                <div class="flex-grow-1">
                  <strong><%= hasStaffPermission('payments.record')?'تسجيل دفعة فاتورة':'مراجعة الفواتير' %></strong>
                  <div class="small text-secondary">ضمن صلاحية الفواتير.</div>
                </div>
                <a class="btn btn-sm btn-outline-primary" href="invoices" data-requires-permission="invoices.view">الفواتير</a>
              </div><% } %>
            </div>
          </div>
          <div class="col-lg-5">
            <div class="soft-card p-4 h-100">
              <h3 class="section-title mb-2">أدواتك المتاحة</h3>
              <p class="text-secondary small mb-3">لا تحتاج إلى حفظ أكواد الصلاحيات؛ اختر القسم وابدأ عملك.</p>
              <nav class="staff-tools-list" aria-label="الأقسام المسموح بها">
                <% if(hasStaffPermission('appointments.view')){ %><a href="appointments"><i class="bi bi-calendar-week"></i><span>المواعيد</span><i class="bi bi-arrow-left-short"></i></a><% } %>
                <% if(hasStaffPermission('patients.page')){ %><a href="patients"><i class="bi bi-people"></i><span>دليل المرضى</span><i class="bi bi-arrow-left-short"></i></a><% } %>
                <% if(hasStaffPermission('invoices.view')){ %><a href="invoices"><i class="bi bi-receipt"></i><span>الفواتير</span><i class="bi bi-arrow-left-short"></i></a><% } %>
                <% if(hasStaffPermission('lab_orders.view')){ %><a href="lab-cases"><i class="bi bi-box-seam"></i><span>الحالات المخبرية</span><i class="bi bi-arrow-left-short"></i></a><% } %>
              </nav>
              <a class="staff-link-muted mt-3 d-inline-flex" href="profile"><i class="bi bi-shield-check ms-2"></i>مراجعة صلاحيات حسابي</a>
            </div>
          </div>
        </div>
      </section>
    <section class="container py-4" id="staffScopeNotice" hidden><div class="soft-card p-4 text-center"><i class="bi bi-building-lock fs-1 text-primary"></i><h3 class="fw-bold mt-3" id="staffScopeTitle">اختر العيادة للمتابعة</h3><p class="text-secondary" id="staffScopeMessage">حدد عيادة لديك عضوية فعّالة فيها لعرض بياناتها وصلاحياتك.</p><a href="choose-clinic" class="btn btn-primary">اختيار العيادة</a></div></section></main>
    <div class="toast-container position-fixed bottom-0 start-0 p-3">
      <div class="toast align-items-center text-bg-primary border-0" id="appToast">
        <div class="d-flex">
          <div class="toast-body">تمت العملية</div>
          <button class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" type="button"></button>
        </div>
      </div>
    </div>
    <script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
  <!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="assets/app.js"></script>


<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button><%- include('../partials/staff/footer') %><script defer src="/assets/i18n.js"></script>
  </body></html>