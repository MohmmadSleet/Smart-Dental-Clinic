<!DOCTYPE html>
<html dir="<%= typeof lang === 'string' && lang === 'en' ? 'ltr' : 'rtl' %>" lang="<%= typeof lang === 'string' && lang === 'en' ? 'en' : 'ar' %>"><head>
    <meta charset="utf-8">
    <meta content="width=device-width,initial-scale=1" name="viewport">
    <title>المختبرات | Clinic Staff</title>
    <!-- Structural fallback: the original Bootstrap stylesheet stays available in both languages. -->
    <link href="/assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <% if (typeof lang === 'string' && lang === 'en') { %><link href="/assets/vendor/bootstrap.ltr.min.css" rel="stylesheet"><% } %>
    <link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
  <link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  <link rel="stylesheet" href="/assets/i18n.css">
  </head>
  <body data-page-permission="lab_orders.view" data-staff-account-status="active" data-staff-permissions="<%= typeof staffPermissions !== 'undefined' ? staffPermissions : '' %>" data-staff-user-id="<%= typeof currentUser !== 'undefined' && currentUser ? currentUser.userId : '' %>" data-rendered-clinic-id="<%= typeof activeClinic !== 'undefined' && activeClinic ? activeClinic.id : '' %>" data-active-clinic-id="<%= typeof activeClinic !== 'undefined' && activeClinic ? activeClinic.id : '' %>" data-staff-clinic-role="<%= typeof staffClinicRole !== 'undefined' ? staffClinicRole : '' %>"><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
    <%- include('../partials/staff/header') %>
    

    
    <main class="page-shell" id="main-content" data-staff-workspace=""><div class="container pt-3"><div class="staff-context-bar"><div class="staff-context-heading"><i class="bi bi-building"></i><div><small class="text-secondary">تعمل الآن في</small><strong><%= typeof activeClinic !== 'undefined' && activeClinic ? activeClinic.name : 'العيادة' %></strong></div></div><label class="visually-hidden" for="activeClinicContext">العيادة الحالية</label><select class="form-select" id="activeClinicContext" name="active_clinic_id" data-context-switcher="" aria-describedby="staffClinicContextHelp"><% if(typeof activeClinic !== 'undefined' && activeClinic){ %><option value="<%= activeClinic.id %>" data-membership-status="active" data-clinic-role="<%= typeof staffClinicRole !== 'undefined' ? staffClinicRole : 'موظف' %>" data-clinic-permissions="<%= typeof staffPermissions !== 'undefined' ? staffPermissions : '' %>"><%= activeClinic.name %></option><% } %></select><a class="btn btn-outline-primary btn-sm" href="choose-clinic" data-choose-clinic-link><i class="bi bi-arrow-left-right ms-1"></i>تبديل العيادة</a><small class="visually-hidden" id="staffClinicContextHelp">تظهر بيانات وصلاحيات العيادة المختارة فقط.</small></div></div><section class="container py-4 py-lg-5 staff-work-content staff-module-page" data-clinic-content="">
<% const staffLabRows=typeof staffLabs==='undefined'?{labs:[]}:staffLabs; %>

<div class="staff-section-heading mb-4"><h1 class="fw-bold fs-2 mb-2">المختبرات والحالات المخبرية</h1><p class="text-secondary mb-0">المختبرات المرتبطة بهذه العيادة وحالاتها الفعلية.</p></div>
<div class="staff-live-overview row g-3 mb-4"><div class="col-6 col-lg-4"><div class="stat-card"><small>المختبرات المرتبطة</small><div class="stat-value"><%= staffLabRows.labs.length %></div></div></div><div class="col-6 col-lg-4"><div class="stat-card"><small>حالات مفتوحة</small><div class="stat-value"><%= staffLabRows.labs.reduce((v,l)=>v+Number(l.open_cases||0),0) %></div></div></div><div class="col-12 col-lg-4"><div class="stat-card"><small>حالات متأخرة</small><div class="stat-value text-danger"><%= staffLabRows.labs.reduce((v,l)=>v+Number(l.overdue_cases||0),0) %></div></div></div></div>
<div class="staff-list-heading mb-3"><h2 class="h6 fw-bold mb-0">قائمة المختبرات</h2></div>
<div class="row g-4" id="staffLabsGrid"><% if(!staffLabRows.labs.length){ %><div class="col-12"><div class="soft-card p-4">لا توجد مختبرات مرتبطة بالعيادة.</div></div><% } %>
<% for(const l of staffLabRows.labs){ %><div class="col-md-6 col-xl-4"><div class="soft-card p-4 h-100"><div class="d-flex justify-content-between mb-3"><div><h5 class="fw-bold mb-1"><%= l.Laboratory_Name %></h5><small class="text-secondary"><%= l.Address||'—' %> • <%= l.Phone||'—' %></small></div><span class="badge text-bg-light"><%= l.Relationship_Status==='active'?'نشط':'غير نشط' %></span></div><div class="d-flex justify-content-between py-2 border-top"><span>حالات مفتوحة</span><strong><%= l.open_cases %></strong></div><div class="d-flex justify-content-between py-2"><span>متأخرة</span><strong class="text-danger"><%= l.overdue_cases %></strong></div><a class="btn btn-primary w-100 mt-2" href="lab-details?lab=<%= l.Laboratory_ID %>">فتح الحالات</a></div></div><% } %></div>

      </section>
    <section class="container py-4" id="staffScopeNotice" hidden><div class="soft-card p-4 text-center"><i class="bi bi-building-lock fs-1 text-primary"></i><h3 class="fw-bold mt-3" id="staffScopeTitle">اختر العيادة للمتابعة</h3><p class="text-secondary" id="staffScopeMessage">حدد عيادة لديك عضوية فعّالة فيها لعرض بياناتها وصلاحياتك.</p><a href="choose-clinic" class="btn btn-primary">اختيار العيادة</a></div></section></main>
    <div class="toast-container position-fixed bottom-0 start-0 p-3">
      <div class="toast align-items-center text-bg-primary border-0" id="appToast">
        <div class="d-flex">
          <div class="toast-body">تمت العملية</div>
          <button class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" type="button"></button>
        </div>
      </div>
    </div>
    <script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
  <!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="assets/app.js"></script>


<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button><%- include('../partials/staff/footer') %><script defer src="/assets/i18n.js"></script>
  </body></html>