<!DOCTYPE html>
<html dir="<%= typeof lang === 'string' && lang === 'en' ? 'ltr' : 'rtl' %>" lang="<%= typeof lang === 'string' && lang === 'en' ? 'en' : 'ar' %>"><head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <title>الرئيسية | Smart Dental Clinic</title>
    <!-- Structural fallback: the original Bootstrap stylesheet stays available in both languages. -->
    <link href="/assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <% if (typeof lang === 'string' && lang === 'en') { %><link href="/assets/vendor/bootstrap.ltr.min.css" rel="stylesheet"><% } %>
    <link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
    <link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">
    
      
  <link rel="stylesheet" href="/assets/i18n.css">
  </head>
  <body class="patient-visual-page patient-page-index"><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
    <!-- شريط التنقل العلوي -->
    <%- include('../partials/patient/header') %>

    <!-- القائمة الجانبية للموبايل -->
    

    <!-- محتوى الصفحة الرئيسي -->
    <main class="page-shell bg-light min-vh-100 py-4" id="main-content">
      <section class="container">
        
        <% if(typeof healthSetupCompleted !== 'undefined' && healthSetupCompleted){ %><div class="alert alert-success d-flex align-items-center gap-2" role="status"><i class="bi bi-check-circle-fill"></i>تم حفظ معلوماتك الصحية بنجاح، وأصبح بإمكانك استخدام حسابك.</div><% } %>
        <!-- القسم الترحيبي: نفس التصميم الأصلي، ببيانات فعلية -->
        <div class="hero patient-home-hero bg-primary text-white p-4 p-lg-5 rounded-4 shadow-sm mb-4">
          <div class="row align-items-center g-4">
            <div class="col-lg-7">
              <span class="badge bg-white text-primary mb-3 px-3 py-2 rounded-pill fw-bold"><%= sdcT("مرحباً،") %> <%= currentUser.fullName %> 👋</span>
              <h1 class="display-6 fw-bold mb-3">مواعيدك ورعايتك الصحية في مكان واحد</h1>
              <p class="lead opacity-87 mb-4 fs-6">تابع موعدك القادم، احجز زيارة جديدة، واطّلع على تقاريرك وفواتيرك بسهولة.</p>
              <div class="d-flex flex-wrap gap-3">
                <a class="btn btn-light text-primary px-4 py-2 fw-bold shadow-sm" href="clinics"><i class="bi bi-calendar2-plus ms-1"></i> حجز موعد جديد</a>
                <a class="btn btn-outline-light px-4 py-2 fw-bold" href="appointments">عرض مواعيدي</a>
              </div>
            </div>
            <div class="col-lg-5">
              <div class="home-next-appointment bg-white text-dark p-4 rounded-4 shadow">
                <div class="d-flex justify-content-between align-items-start mb-3">
                  <div><small class="text-muted fw-bold">موعدك القادم</small>
                    <h4 class="fw-bold mt-1 mb-0 text-primary"><%= dashboard.next ? dashboard.next.date : 'لا يوجد موعد قادم' %></h4></div>
                  <% if (dashboard.next) { %><span class="badge bg-success-subtle text-success px-2 py-1"><%= dashboard.next.status==='confirmed' ? 'مؤكد' : 'بانتظار الموافقة' %></span><% } %>
                </div>
                <% if (dashboard.next) { %>
                  <div class="mb-2 d-flex align-items-center gap-2 text-secondary"><i class="bi bi-clock text-primary"></i><span><%= dashboard.next.time %></span></div>
                  <div class="mb-2 d-flex align-items-center gap-2 text-secondary"><i class="bi bi-person-badge text-primary"></i><span><%= sdcT("د.") %> <%= dashboard.next.doctor_name %></span></div>
                  <div class="mb-3 d-flex align-items-center gap-2 text-secondary"><i class="bi bi-hospital text-primary"></i><span><%= dashboard.next.clinic_name %></span></div>
                  <a class="btn btn-sm btn-primary w-100 py-2" href="/patient/booking-details?id=<%= dashboard.next.id %>">عرض تفاصيل الموعد</a>
                <% } else { %>
                  <p class="small text-secondary my-3">يمكنك حجز موعد جديد من العيادات المتاحة.</p>
                  <a class="btn btn-sm btn-primary w-100 py-2" href="clinics">حجز موعد</a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
        <div class="patient-dashboard-group" aria-label="الإجراءات السريعة">
        <div class="patient-dashboard-heading"><span class="patient-dashboard-heading-icon"><i class="bi bi-grid"></i></span><div><h2>إجراءات سريعة</h2><p>اختر الخدمة التي تحتاجها دون البحث بين الصفحات.</p></div></div>
        <!-- الأزرار السريعة -->
        <div class="row g-3 mb-4 patient-quick-actions"><div class="col-6 col-md-4 col-xl-2"><a class="text-decoration-none" href="appointments"><div class="card border-0 shadow-sm quick-action p-4 h-100 rounded-4 text-center text-lg-start"><div class="icon-box bg-primary-subtle text-primary rounded-3 d-inline-flex align-items-center justify-content-center fs-4 mb-3"><i class="bi bi-calendar-check"></i></div><h6 class="fw-bold text-dark mb-1">مواعيدي</h6><small class="text-muted">الحجوزات وحالاتها</small></div></a></div>
          <div class="col-6 col-md-4 col-xl-2">
            <a class="text-decoration-none" href="clinics">
              <div class="card border-0 shadow-sm quick-action p-4 h-100 rounded-4 text-center text-lg-start hover-card transition-all">
                <div class="icon-box bg-primary-subtle text-primary rounded-3 d-inline-flex align-items-center justify-content-center fs-4 mb-3" style="width: 50px; height: 50px;">
                  <i class="bi bi-calendar2-plus"></i>
                </div>
                <h6 class="fw-bold text-dark mb-1">حجز موعد</h6>
                <small class="text-muted">ابدأ باختيار العيادة</small>
              </div>
            </a>
          </div>
          <div class="col-6 col-md-4 col-xl-2">
            <a class="text-decoration-none" href="ai-diagnosis">
              <div class="card border-0 shadow-sm quick-action p-4 h-100 rounded-4 text-center text-lg-start">
                <div class="icon-box bg-success-subtle text-success rounded-3 d-inline-flex align-items-center justify-content-center fs-4 mb-3" style="width: 50px; height: 50px;">
                  <i class="bi bi-cpu"></i>
                </div>
                <h6 class="fw-bold text-dark mb-1">التشخيص الذكي</h6>
                <small class="text-muted">توجيه أولي للأعراض</small>
              </div>
            </a>
          </div>
          <div class="col-6 col-md-4 col-xl-2">
            <a class="text-decoration-none" href="diagnosis-history">
              <div class="card border-0 shadow-sm quick-action p-4 h-100 rounded-4 text-center text-lg-start">
                <div class="icon-box bg-info-subtle text-info rounded-3 d-inline-flex align-items-center justify-content-center fs-4 mb-3" style="width: 50px; height: 50px;">
                  <i class="bi bi-file-medical"></i>
                </div>
                <h6 class="fw-bold text-dark mb-1">السجل الطبي</h6>
                <small class="text-muted">التقارير والوصفات</small>
              </div>
            </a>
          </div>
          <div class="col-6 col-md-4 col-xl-2">
            <a class="text-decoration-none" href="invoices">
              <div class="card border-0 shadow-sm quick-action p-4 h-100 rounded-4 text-center text-lg-start">
                <div class="icon-box bg-warning-subtle text-warning rounded-3 d-inline-flex align-items-center justify-content-center fs-4 mb-3" style="width: 50px; height: 50px;">
                  <i class="bi bi-receipt"></i>
                </div>
                <h6 class="fw-bold text-dark mb-1">فواتيري</h6>
                <small class="text-muted">المدفوع والمتبقي</small>
              </div>
            </a>
          </div>
          <div class="col-6 col-md-4 col-xl-2"><a class="text-decoration-none" href="profile"><div class="card border-0 shadow-sm quick-action p-4 h-100 rounded-4 text-center text-lg-start"><div class="icon-box bg-info-subtle text-info rounded-3 d-inline-flex align-items-center justify-content-center fs-4 mb-3"><i class="bi bi-person-gear"></i></div><h6 class="fw-bold text-dark mb-1">حسابي</h6><small class="text-muted">بياناتي وصحتي</small></div></a></div>
        </div>

        
        </div>
<div class="patient-dashboard-group" aria-label="رعايتي الطبية">
        <div class="patient-dashboard-heading"><span class="patient-dashboard-heading-icon"><i class="bi bi-heart-pulse"></i></span><div><h2>متابعة صحتك</h2><p>آخر زيارة طبية والتوصيات القادمة.</p></div></div>
        <!-- آخر زيارة طبية والتوجيه الأولي: بطاقتان بالشكل الأصلي -->
        <div class="row g-4 mb-5">
          <div class="col-lg-7">
            <div class="card border-0 shadow-sm p-4 h-100 rounded-4">
              <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                  <span class="badge bg-primary-subtle text-primary mb-2 px-2 py-1">آخر زيارة طبية</span>
                  <% if (dashboard.medical.visits.length) { const v=dashboard.medical.visits[0]; %>
                    <h4 class="fw-bold mb-1 text-dark"><%= v.service %></h4>
                    <div class="text-muted small"><%= sdcT("د.") %> <%= v.doctor %> • <%= v.date %></div>
                  <% } else { %><h4 class="fw-bold mb-1 text-dark">لا توجد زيارات مسجلة</h4><% } %>
                </div>
                <% if (dashboard.medical.visits.length) { %><span class="badge <%= dashboard.medical.visits[0].approved?'bg-success':'bg-secondary' %>"><%= dashboard.medical.visits[0].approved?'تقرير معتمد':'بانتظار الاعتماد' %></span><% } %>
              </div>
              <hr class="text-muted opacity-25">
              <% if (dashboard.medical.visits.length) { const v=dashboard.medical.visits[0]; %>
                <div class="row g-3 py-2">
                  <div class="col-md-6"><small class="text-muted d-block mb-1">التشخيص</small><div class="fw-bold text-dark"><%= v.approved ? (v.diagnosis||'لم يسجل تشخيص مفصّل') : 'متاح بعد اعتماد التقرير' %></div></div>
                  <div class="col-md-6"><small class="text-muted d-block mb-1">المتابعة</small><div class="fw-bold text-dark"><%= v.followup ? (v.followup+' • '+(v.suggested_date||'')) : 'لا توجد متابعة مقترحة' %></div></div>
                </div>
                <div class="mt-4"><a class="btn btn-outline-primary btn-sm px-3" href="/patient/appointment-details?visit_id=<%= v.id %>">عرض الزيارة الطبية</a></div>
              <% } else { %><p class="text-secondary small">ستظهر زياراتك هنا بعد تسجيلها من العيادة.</p><div class="mt-auto"><a class="btn btn-outline-primary btn-sm px-3" href="appointments">عرض المواعيد</a></div><% } %>
            </div>
          </div>
          <div class="col-lg-5">
            <div class="card border-0 shadow-sm p-4 h-100 rounded-4">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div><span class="badge bg-warning-subtle text-warning mb-2 px-2 py-1">آخر تقييم أولي</span>
                  <h5 class="fw-bold text-dark"><%= dashboard.medical.assessments.length?(dashboard.medical.assessments[0].result||'تقييم محفوظ'):'لا يوجد تقييم سابق' %></h5></div>
              </div>
              <% if(dashboard.medical.assessments.length){ const a=dashboard.medical.assessments[0]; %><p class="text-muted small mt-2"><%= a.symptoms %></p>
                <div class="bg-light rounded-3 p-3 my-3"><small class="text-muted d-block mb-1">التوجيه الأولي</small><div class="fw-bold text-dark small"><%= a.advice||'راجع طبيب أسنان للتقييم السريري' %></div></div>
              <% } else { %><p class="text-muted small mt-2">صف الأعراض للحصول على إرشاد أولي وخيارات مواعيد متاحة.</p><% } %>
              <a class="btn btn-outline-primary btn-sm px-3 mt-auto align-self-start" href="ai-diagnosis">فتح التوجيه الأولي</a>
            </div>
          </div>
        </div>

        <!-- المتابعة: يظهر التنبيه فقط عندما توجد توصية طبية حقيقية -->
        <% if (dashboard.medical.followups.length) { const f=dashboard.medical.followups[0]; %>
        <div class="card border-0 shadow-sm bg-white p-4 rounded-4 mb-5 border-start border-4 border-success">
          <div class="d-flex align-items-start gap-3 flex-column flex-md-row justify-content-between align-items-md-center">
            <div class="d-flex align-items-start gap-3">
              <div class="bg-success-subtle text-success p-3 rounded-circle fs-4 d-flex align-items-center justify-content-center" style="width:50px;height:50px"><i class="bi bi-arrow-repeat"></i></div>
              <div><span class="badge bg-success mb-2"><%= f.linked_id?'تم الحجز':'متابعة مقترحة' %></span>
                <h5 class="fw-bold mb-1 text-dark"><%= f.followup %> — <%= f.date %></h5>
                <p class="text-muted small mb-0"><%= f.doctor %> • <%= f.clinic %></p></div>
            </div>
            <a class="btn btn-outline-success btn-sm px-3 text-nowrap" href="diagnosis-history">عرض المتابعة</a>
          </div>
        </div>
        <% } %>
        
        </div>
<div class="patient-dashboard-group" aria-label="فواتيري وملخص الحساب">
        <div class="patient-dashboard-heading"><span class="patient-dashboard-heading-icon"><i class="bi bi-receipt"></i></span><div><h2>حسابك وفواتيرك</h2><p>ملخص مالي واضح دون الحاجة للانتقال بين الصفحات.</p></div></div>
        <!-- ملخص الحساب ونصيحة اليوم: الإشعارات توجد بالجرس أعلى الصفحة، دون صفحة منفصلة -->
        <div class="row g-4">
          <div class="col-lg-7">
            <div class="card border-0 shadow-sm p-4 h-100 rounded-4">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div><small class="text-muted fw-bold">ملخص الفواتير</small><h3 class="fw-bold text-dark mt-1"><%= dashboard.billing.remaining.toFixed(2) %> <%= sdcT("₪ متبقي") %></h3></div>
                <div class="bg-primary-subtle text-primary p-3 rounded-3 fs-4 d-flex align-items-center justify-content-center" style="width:50px;height:50px"><i class="bi bi-wallet2"></i></div>
              </div>
              <p class="text-muted small my-2"><%= sdcT("الإجمالي:") %> <%= dashboard.billing.total.toFixed(2) %> ₪ • المدفوع: <%= dashboard.billing.paid.toFixed(2) %> ₪</p>
              <a class="btn btn-outline-primary btn-sm px-3 mt-auto align-self-start" href="invoices">عرض كافة فواتيري</a>
            </div>
          </div>
          <div class="col-lg-5">
            <div class="card patient-tip-card border-0 shadow-sm p-4 h-100 rounded-4 bg-primary text-white d-flex flex-column justify-content-center">
              <i class="bi bi-lightbulb fs-2 text-warning mb-2"></i><h5 class="fw-bold mb-2 fs-6">نصيحة لصحة الفم</h5>
              <p class="mb-0 small opacity-87">استخدم خيط الأسنان يوميًا لتنظيف المناطق التي لا تصل إليها الفرشاة التقليدية.</p>
            </div>
          </div>
        </div>
        

        </div>
<div class="patient-dashboard-group" aria-label="استكشف العيادات والأطباء">
        <div class="patient-dashboard-heading"><span class="patient-dashboard-heading-icon"><i class="bi bi-search"></i></span><div><h2>استكشف واحجز</h2><p>خيارات مقترحة لمساعدتك على العثور على العيادة والطبيب.</p></div></div>
        <!-- العيادات المقترحة: بيانات العيادات المعتمدة -->
        <div class="d-flex justify-content-between align-items-end mb-3">
          <div><h3 class="fw-bold text-dark mb-1 fs-4">عيادات مقترحة</h3><p class="text-muted mb-0 small">خيارات سريعة من العيادات المسجلة والفعالة.</p></div>
          <a class="text-decoration-none fw-bold small text-primary" href="clinics">عرض الكل <i class="bi bi-chevron-left small"></i></a>
        </div>
        <div class="row g-3 patient-featured-row mb-5">
          <% dashboard.clinics.forEach(c=>{ %>
          <div class="col-md-6 col-xl-4"><div class="card border-0 shadow-sm p-4 rounded-4 h-100 d-flex flex-column justify-content-between">
            <div><div class="d-flex align-items-center gap-2 mb-2"><img src="<%= c.has_cover?'/media/clinics/'+c.id+'/cover':c.has_logo?'/media/clinics/'+c.id+'/logo':'../assets/vendor/1a7676da86a2-photo-1629909613654-28e377c37b09.jpg' %>" alt="صورة عيادة <%= c.name %>" loading="lazy" style="width:50px;height:50px;object-fit:cover;border-radius:10px"><div class="d-flex justify-content-between gap-2 mb-2 flex-grow-1"><h5 class="fw-bold text-dark mb-0 fs-6"><%= c.name %></h5><span class="badge bg-primary">عيادة معتمدة</span></div></div>
            <div class="text-muted small mb-3"><i class="bi bi-geo-alt ms-1 text-primary"></i><%= [c.city,c.area].filter(Boolean).join(' • ')||'معلومات الموقع في الملف' %></div>
            <div class="d-flex flex-wrap gap-1 mb-3"><span class="badge bg-light text-secondary border"><%= c.doctor_count||0 %> <%= sdcT("أطباء") %></span><span class="badge bg-light text-secondary border"><%= c.service_count||0 %> <%= sdcT("خدمات") %></span><span class="badge bg-light text-secondary border"><% if(c.rating != null && Number(c.rating_count)>0){ %><span class="patient-rating" aria-label="متوسط التقييم <%= c.rating %> <%= sdcT("من 5 بناء على") %> <%= c.rating_count %> تقييم"><i class="bi bi-star-fill text-warning" aria-hidden="true"></i> <%= c.rating %>/5 <small class="text-secondary">(<%= c.rating_count %> تقييم)</small></span><% }else{ %><span class="small text-secondary">لا توجد تقييمات بعد</span><% } %></span></div></div>
            <a class="btn btn-sm btn-outline-primary w-100" href="/patient/clinic-details?clinic_id=<%= c.id %>">عرض العيادة</a></div></div>
          <% }); %>
          <% if (!dashboard.clinics.length) { %><div class="col-12 text-secondary small">لا توجد عيادات معتمدة متاحة حاليًا.</div><% } %>
        </div>
        <!-- الأطباء المقترحون: معلومات الطبيب والعيادة الأصلية -->
        <div class="d-flex justify-content-between align-items-end mb-3">
          <div><h3 class="fw-bold text-dark mb-1 fs-4">أطباء مقترحون</h3><p class="text-muted mb-0 small">أطباء موثّقون يعملون في العيادات المسجلة.</p></div>
          <a class="text-decoration-none fw-bold small text-primary" href="doctors">عرض الكل <i class="bi bi-chevron-left small"></i></a>
        </div>
        <div class="row g-3 patient-featured-row mb-5">
          <% dashboard.doctors.forEach(d=>{ %>
          <div class="col-md-6 col-xl-4"><div class="card border-0 shadow-sm p-3 rounded-4 d-flex flex-row gap-3 align-items-center h-100">
            <div class="rounded-circle bg-primary-subtle text-primary d-flex justify-content-center align-items-center flex-shrink-0" style="width:65px;height:65px"><img src="/media/doctors/<%= d.id %>/photo" alt="د. <%= d.name %>" loading="lazy" style="width:65px;height:65px;border-radius:50%;object-fit:cover"></div>
            <div class="flex-grow-1"><h6 class="fw-bold mb-1 text-dark"><%= sdcT("د.") %> <%= d.name %></h6>
              <div class="small text-muted"><%= d.specialties %></div><div class="small text-secondary mt-1"><%= d.clinic_name %></div><div class="small mt-1"><% if(d.rating != null && Number(d.rating_count)>0){ %><span class="patient-rating" aria-label="متوسط التقييم <%= d.rating %> <%= sdcT("من 5 بناء على") %> <%= d.rating_count %> تقييم"><i class="bi bi-star-fill text-warning" aria-hidden="true"></i> <%= d.rating %>/5 <small class="text-secondary">(<%= d.rating_count %> تقييم)</small></span><% }else{ %><span class="small text-secondary">لا توجد تقييمات بعد</span><% } %></div>
              <a class="small text-decoration-none fw-bold text-primary mt-1 d-inline-block" href="/patient/doctor-details?doctor_id=<%= d.id %>&clinic_id=<%= d.clinic_id %>">عرض الملف</a>
            </div></div></div>
          <% }); %>
          <% if (!dashboard.doctors.length) { %><div class="col-12 text-secondary small">لا يوجد أطباء متاحون حاليًا.</div><% } %>
        </div>
        
        </div>
      </section>
    </main>

    <!-- الفوتر -->
    <%- include('../partials/patient/footer') %>

    <!-- التوست (Toast) -->
    <div class="toast-container position-fixed bottom-0 start-0 p-3">
      <div class="toast align-items-center text-bg-primary border-0 shadow" id="appToast" role="alert">
        <div class="d-flex">
          <div class="toast-body">تمت العملية بنجاح</div>
          <button class="btn-close btn-close-white ms-2 m-auto" data-bs-dismiss="toast" type="button"></button>
        </div>
      </div>
    </div>

    <!-- السكريبتات -->
    <script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
    <!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="assets/app.js"></script>
  
<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button><div class="toast-container position-fixed bottom-0 start-0 p-3"><div id="backendPendingNotice" class="toast align-items-center text-bg-secondary border-0" role="status" aria-live="polite"><div class="d-flex"><div class="toast-body">هذه العملية بانتظار ربط الباك إند. لم تُحفظ أو تتغيّر أي بيانات.</div><button type="button" class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" aria-label="إغلاق"></button></div></div></div><script defer src="/assets/i18n.js"></script>
  </body></html>