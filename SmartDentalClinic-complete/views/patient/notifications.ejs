<!DOCTYPE html>
<html dir="<%= typeof lang === 'string' && lang === 'en' ? 'ltr' : 'rtl' %>" lang="<%= typeof lang === 'string' && lang === 'en' ? 'en' : 'ar' %>"><head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <title>الإشعارات | Smart Dental Clinic</title>
    <!-- Structural fallback: the original Bootstrap stylesheet stays available in both languages. -->
    <link href="/assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <% if (typeof lang === 'string' && lang === 'en') { %><link href="/assets/vendor/bootstrap.ltr.min.css" rel="stylesheet"><% } %>
    <link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
  <link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  <link rel="stylesheet" href="/assets/i18n.css">
  </head>
  <body class="patient-visual-page patient-page-notifications"><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
    <%- include('../partials/patient/header') %>
    
    <main class="page-shell" id="main-content"><section class="container py-4 py-lg-5">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4"><div><span class="badge badge-soft mb-2">Notifications</span><h1 class="fw-bold">الإشعارات</h1><p class="text-secondary mb-0">التحديثات الفعلية المرتبطة بحسابك</p></div>
  <form method="post" action="/patient/notifications/all"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button class="btn btn-light" type="submit" <%= !notices.some(n=>!n.read)?'disabled':'' %>><i class="bi bi-check2-all ms-1"></i>تحديد الكل كمقروء</button></form></div>
  <div class="d-grid gap-3">
   <% if(!notices.length){ %><div class="soft-card p-4 text-secondary">لا توجد إشعارات في حسابك حتى الآن.</div><% } %>
   <% notices.forEach(n=>{ %><div class="notification-item <%= n.read?'':'border border-primary' %>" data-record-id="<%= n.id %>">
     <div class="notification-icon success"><i class="bi bi-bell"></i></div>
     <div class="flex-grow-1"><h6 class="fw-bold mb-1"><%= n.title %></h6><div class="text-secondary"><%= n.body %></div><small class="text-secondary"><%= n.date %></small></div>
     <div class="d-flex flex-column gap-2 align-items-start"><span class="badge <%= n.read?'text-bg-light':'text-bg-primary' %>"><%= n.read?'مقروء':'جديد' %></span>
     <form method="post" action="/patient/notifications/open"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="notice_id" value="<%= n.id %>"><button class="btn btn-sm btn-outline-primary">فتح</button></form>
     <% if(!n.read){ %><form method="post" action="/patient/notifications/read"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="notice_id" value="<%= n.id %>"><button class="btn btn-sm btn-outline-secondary">تمت القراءة</button></form><% } %>
     <form method="post" action="/patient/notifications/delete"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="notice_id" value="<%= n.id %>"><button class="btn btn-sm btn-link text-danger" onclick="return confirm('حذف هذا الإشعار؟')">حذف</button></form>
     </div></div><% }); %>
  </div></section></main>
    <%- include('../partials/patient/footer') %>
    <div class="toast-container position-fixed bottom-0 start-0 p-3">
      <div class="toast align-items-center text-bg-primary border-0" id="appToast" role="alert">
        <div class="d-flex">
          <div class="toast-body">تمت العملية بنجاح</div>
          <button class="btn-close btn-close-white ms-2 m-auto" data-bs-dismiss="toast" type="button"></button>
        </div>
      </div>
    </div>
    <script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
  <!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="assets/app.js"></script>




<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button><div class="toast-container position-fixed bottom-0 start-0 p-3"><div id="backendPendingNotice" class="toast align-items-center text-bg-secondary border-0" role="status" aria-live="polite"><div class="d-flex"><div class="toast-body">هذه العملية بانتظار ربط الباك إند. لم تُحفظ أو تتغيّر أي بيانات.</div><button type="button" class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" aria-label="إغلاق"></button></div></div></div><script defer src="/assets/i18n.js"></script>
  </body></html>