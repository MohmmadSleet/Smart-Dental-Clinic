<!DOCTYPE html>
<html dir="<%= typeof lang === 'string' && lang === 'en' ? 'ltr' : 'rtl' %>" lang="<%= typeof lang === 'string' && lang === 'en' ? 'en' : 'ar' %>"><head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <title>تفاصيل العيادة | Smart Dental Clinic</title>
    <!-- Structural fallback: the original Bootstrap stylesheet stays available in both languages. -->
    <link href="/assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <% if (typeof lang === 'string' && lang === 'en') { %><link href="/assets/vendor/bootstrap.ltr.min.css" rel="stylesheet"><% } %>
    <link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
  <link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  <link rel="stylesheet" href="/assets/i18n.css">
  </head>
  <body class="patient-visual-page patient-page-clinic-details"><a class="ux-skip" href="#patientClinicDetailPage">تخطي إلى المحتوى</a>
    <%- include('../partials/patient/header') %>
    
    <main class="page-shell" id="patientClinicDetailPage">
      <section class="container py-4 py-lg-5">
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="clinics">العيادات</a></li><li class="breadcrumb-item active" id="clinicDetailBreadcrumb"><%= clinic.name %></li></ol></nav>
        <header class="soft-card clinic-compact-header mb-3">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="flex-grow-1">
              <div class="d-flex gap-2 align-items-center mb-1"><span class="availability-dot bg-primary" id="clinicAvailabilityDot"></span><span class="text-secondary small" id="clinicAvailabilityText">تفاصيل العيادة</span></div>
              <div class="d-flex align-items-center gap-3 mb-2"><img src="<%= clinic.has_cover?'/media/clinics/'+clinic.id+'/cover':clinic.has_logo?'/media/clinics/'+clinic.id+'/logo':'../assets/vendor/1a7676da86a2-photo-1629909613654-28e377c37b09.jpg' %>" alt="صورة عيادة <%= clinic.name %>" loading="lazy" style="width:80px;height:65px;object-fit:cover;border-radius:12px"><div><h1 class="fw-bold mb-1" id="clinicDetailName"><%= clinic.name %></h1></div></div>
              <% if(clinic.description){ %><p class="text-secondary small mb-2" style="white-space:pre-line"><%= clinic.description %></p><% }else{ %><p class="text-secondary small mb-2">لم تضف العيادة وصفًا تعريفيًا بعد.</p><% } %><div class="clinic-compact-facts"><span id="clinicDetailLocation"><i class="bi bi-geo-alt ms-1" aria-hidden="true"></i><%= clinic.city %> — <%= clinic.area %></span><span id="clinicDoctorCount"><i class="bi bi-people ms-1" aria-hidden="true"></i><%= doctors.length %> <%= sdcT("طبيب") %></span></div>
            </div>
            <a href="#clinicDoctorsGrid" class="btn btn-primary btn-sm patient-jump-action">اختر طبيبًا للحجز <i class="bi bi-arrow-down-short" aria-hidden="true"></i></a>
          </div>
        </header>
        <!-- الأطباء أولاً؛ المعلومات الثانوية اختيارية أدناه -->
        <div class="row g-3 clinic-compact-main">
          <div class="col-lg-8">
            <div class="d-flex align-items-center justify-content-between gap-2 mb-2"><h2 class="h5 fw-bold mb-0">أطباء العيادة</h2><span class="text-secondary small">اختر الطبيب المناسب</span></div>
            <div class="row g-3" id="clinicDoctorsGrid">
              <% if(!doctors.length){ %><div class="col-12"><div class="alert alert-info">لا يوجد أطباء نشطون في العيادة حاليًا.</div></div><% } %>
              <% for(const d of doctors){ %>
              <div class="col-md-6 clinic-doctor-item" data-name="<%= d.name %>" data-specialty="<%= d.specialties %>" data-availability="<%= d.bookable?'available':'unavailable' %>">
                <article class="soft-card clinic-compact-doctor h-100">
                  <div class="clinic-compact-doctor-head"><img class="doctor-img" src="/media/doctors/<%= d.id %>/photo" alt="صورة د. <%= d.name %>" loading="lazy"><div class="flex-grow-1 min-width-0"><h3 class="h6 fw-bold mb-1"><%= sdcT("د.") %> <%= d.name %></h3><div class="small text-secondary"><%= d.specialties %></div><div class="small mt-1"><% if(d.rating != null && Number(d.rating_count)>0){ %><span class="patient-rating" aria-label="متوسط التقييم <%= d.rating %> <%= sdcT("من 5 بناء على") %> <%= d.rating_count %> تقييم"><i class="bi bi-star-fill text-warning" aria-hidden="true"></i> <%= d.rating %>/5 <small class="text-secondary">(<%= d.rating_count %> تقييم)</small></span><% }else{ %><span class="small text-secondary">لا توجد تقييمات بعد</span><% } %></div></div></div>
                  <div class="clinic-compact-doctor-bottom"><span class="badge <%= d.bookable?'text-bg-success':'text-bg-secondary' %>"><%= d.bookable?'خدمات متاحة':'بدون خدمات للحجز' %></span><div class="d-flex gap-2"><a class="btn btn-outline-primary btn-sm flex-fill" href="/patient/doctor-details?doctor_id=<%= d.id %>&amp;clinic_id=<%= d.clinic_id %>">ملف الطبيب</a><% if(d.bookable){ %><a class="btn btn-primary btn-sm flex-fill" href="/patient/book-appointment?clinic_id=<%= d.clinic_id %>&amp;doctor_id=<%= d.id %>">حجز</a><% } %></div></div>
                </article>
              </div>
              <% } %>
            </div>
          </div>
          <div class="col-lg-4">
            <details class="patient-optional-filters clinic-services-disclosure" open>
              <summary><i class="bi bi-clipboard2-pulse ms-2 text-primary" aria-hidden="true"></i>الخدمات والأسعار</summary>
              <div class="patient-optional-filters-body"><div id="clinicServicesPanel"><% if(!services.length){ %><p class="small text-secondary mb-0">لا توجد خدمات متاحة حاليًا.</p><% } %><% for(const item of services){ %><div class="service-item" data-record-id="<%= item.id %>"><div class="fw-bold"><%= item.name %></div><div class="small text-secondary"><%= item.price %> ₪ • <%= item.duration %> <%= sdcT("دقيقة") %></div></div><% } %></div><p class="text-secondary small mt-2 mb-0">يُثبّت سعر الخدمة عند الحجز.</p></div>
            </details>
          </div>
        </div>
        <details class="patient-optional-filters clinic-secondary-details mt-3">
          <summary><i class="bi bi-clock-history ms-2 text-primary" aria-hidden="true"></i>ساعات العمل ومعلومات العيادة<span class="filter-expand-hint">عرض التفاصيل</span></summary>
          <div class="patient-optional-filters-body">
            <div class="clinic-secondary-facts mb-3">
              <div><small>ساعات العمل</small><strong id="clinicDetailHours">حسب الجدول</strong></div>
              <div><small>أيام العمل</small><strong id="clinicDetailDays">حسب الجدول</strong></div>
              <div><small>التقييم</small><strong><i class="bi bi-star-fill text-warning" aria-hidden="true"></i> <span id="clinicDetailRating"><%= clinic.rating==null||!Number(clinic.rating_count)?'لا توجد تقييمات بعد':clinic.rating+'/5' %></span> <span class="small" id="clinicDetailReviews"><%= Number(clinic.rating_count)?'('+clinic.rating_count+' تقييم)':'' %></span></strong></div>
              <div><small>المسافة</small><strong id="clinicDetailDistance">تُحسب بعد مشاركة الموقع</strong></div>
            </div>
            <div class="d-flex align-items-center justify-content-between mb-2 gap-2"><h3 class="h6 fw-bold mb-0">ساعات عمل العيادة</h3><span class="badge text-bg-secondary" id="clinicHoursStatus">حسب الجدول</span></div>
            <p class="small text-secondary mb-2">يظهر الحجز فقط عند تقاطع دوام الطبيب مع ساعات عمل العيادة.</p>
            <div class="row g-2 small" id="clinicWorkingHours"><% const WEEK=['الأحد','الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت']; %><% for(let day=0;day<7;day++){ const ranges=hours.filter(h=>Number(h.day)===day); %><div class="col-md-6"><div class="work-day"><span><%= WEEK[day] %></span><% if(!ranges.length){ %><span class="badge text-bg-secondary">مغلقة</span><% }else{ %><strong><%= ranges.map(h=>h.start+' – '+h.finish).join('، ') %></strong><% } %></div></div><% } %></div>
          </div>
        </details>
      </section>
    </main>
    <%- include('../partials/patient/footer') %>
    <div class="toast-container position-fixed bottom-0 start-0 p-3">
      <div class="toast align-items-center text-bg-primary border-0" id="appToast" role="alert">
        <div class="d-flex">
          <div class="toast-body">تمت العملية بنجاح</div>
          <button class="btn-close btn-close-white ms-2 m-auto" data-bs-dismiss="toast" type="button"></button>
        </div>
      </div>
    </div>
    <script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
  <!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="assets/app.js"></script>


<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button><div class="toast-container position-fixed bottom-0 start-0 p-3"><div id="backendPendingNotice" class="toast align-items-center text-bg-secondary border-0" role="status" aria-live="polite"><div class="d-flex"><div class="toast-body">هذه العملية بانتظار ربط الباك إند. لم تُحفظ أو تتغيّر أي بيانات.</div><button type="button" class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" aria-label="إغلاق"></button></div></div></div><script defer src="/assets/i18n.js"></script>
  </body></html>