<!DOCTYPE html>
<html dir="<%= typeof lang === 'string' && lang === 'en' ? 'ltr' : 'rtl' %>" lang="<%= typeof lang === 'string' && lang === 'en' ? 'en' : 'ar' %>"><head>
    <meta charset="utf-8">
    <meta content="width=device-width,initial-scale=1" name="viewport">
    <title>حالة طلب إنشاء العيادة | Smart Dental Clinic</title>
    <!-- Bootstrap fallback retained for all layouts. -->
<link rel="stylesheet" href="/assets/vendor/937abe4f713b-bootstrap.rtl.min.css"><% if (typeof lang === "string" && lang === "en") { %><link rel="stylesheet" href="/assets/vendor/bootstrap.ltr.min.css"><% } %>
    <link href="../../../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="../../assets/styles.css">
  <link href="../../../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  <link rel="stylesheet" href="/assets/i18n.css">
  </head>
  <body>
    <div class="auth-page">
      <div class="container">
        <div class="auth-card mx-auto" style="max-width: 780px">
          <div class="auth-form-wrap">
            <div class="text-center mb-4">
              <span class="hero-badge">Clinic Application</span>
              <h1 class="mt-3 mb-2">حالة طلب إنشاء العيادة</h1>
              <p>الحالة والملاحظات والوثائق الناقصة تظهر للطبيب نفسه.</p>
            </div>
            <% if (feedback) { %><div class="alert alert-success" role="status"><%= feedback %></div><% } %>
            <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
            <div class="alert <%= status==='approved'?'alert-success':status==='rejected'?'alert-danger':status==='needs_info'?'alert-warning':'alert-info' %> rounded-4">
              <strong>CA-<%= clinic.Clinic_ID %> • <%= status==='approved'?'تم اعتماد العيادة':status==='rejected'?'تم رفض الطلب':status==='needs_info'?'مطلوب استكمال البيانات':'بانتظار مراجعة المشرف' %></strong>
              <% if (clinic.Review_Notes) { %><div class="small mt-2"><strong>ملاحظة المشرف:</strong> <%= clinic.Review_Notes %></div><% } %>
            </div>
            <div class="row g-3">
              <div class="col-md-6"><strong>اسم العيادة:</strong> <%= clinic.Clinic_Name %></div>
              <div class="col-md-6"><strong>المدينة:</strong> <%= clinic.City %></div>
              <div class="col-md-6"><strong>رقم الترخيص:</strong> <%= clinic.Facility_License_Number %></div>
              <div class="col-md-6"><strong>تاريخ التقديم:</strong> <%= new Date(clinic.Submitted_At).toLocaleDateString('ar-PS') %></div>
            </div>
            <div class="border rounded-3 p-3 mt-4"><strong>الوثائق الحالية</strong>
              <% for (const doc of documents) { %><div class="mt-2"><%= doc.Document_Type==='facility_license'?'ترخيص المنشأة':'وثيقة المدير' %>: <a href="/onboarding/doctor/clinic/document/<%= doc.Document_ID %>"><%= doc.File_Name %></a></div><% } %>
            </div>
            <% if(status==='needs_info') { %>
              <h2 class="h5 mt-4">استكمال الطلب من نفس الصفحة</h2>
              <form action="/onboarding/doctor/clinic/application-status" method="post" enctype="multipart/form-data" class="mt-3">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="clinic_id" value="<%= clinic.Clinic_ID %>">
                <div class="row g-3">
                  <div class="col-md-6"><label class="form-label">اسم العيادة *</label><input class="form-control" maxlength="150" name="clinic_name" required value="<%= clinic.Clinic_Name %>"></div>
                  <div class="col-md-6"><label class="form-label">المدينة *</label><input class="form-control" maxlength="150" name="city" required value="<%= clinic.City %>"></div>
                  <div class="col-md-6"><label class="form-label">المنطقة *</label><input class="form-control" maxlength="150" name="area" required value="<%= clinic.Area %>"></div>
                  <div class="col-md-6"><label class="form-label">رقم ترخيص المنشأة *</label><input class="form-control" maxlength="150" name="facility_license_number" required value="<%= clinic.Facility_License_Number %>"></div>
                  <div class="col-md-6"><label class="form-label">الهاتف *</label><input class="form-control" maxlength="30" name="phone" required value="<%= clinic.Clinic_Phone %>"></div>
                  <div class="col-md-6"><label class="form-label">البريد *</label><input class="form-control" type="email" maxlength="254" name="email" required value="<%= clinic.Clinic_Email %>"></div>
                  <div class="col-12"><label class="form-label">العنوان *</label><input class="form-control" name="address" required value="<%= clinic.Address_Text %>"></div>
                  <div class="col-md-6"><label class="form-label">خط العرض *</label><input id="clinicLatitude" class="form-control" type="number" step="any" name="latitude" required value="<%= clinic.Latitude %>"></div>
                  <div class="col-md-6"><label class="form-label">خط الطول *</label><input id="clinicLongitude" class="form-control" type="number" step="any" name="longitude" required value="<%= clinic.Longitude %>"></div>
                  <div class="col-12"><button type="button" class="btn btn-sm btn-outline-primary" data-use-clinic-location>استخدام موقعي الحالي</button></div>
                  <div class="col-md-6"><label class="form-label">استبدال ترخيص المنشأة (اختياري)</label><input class="form-control" type="file" name="license" accept=".pdf,.jpg,.jpeg,.png"></div>
                  <div class="col-md-6"><label class="form-label">استبدال وثيقة المدير (اختياري)</label><input class="form-control" type="file" name="manager" accept=".pdf,.jpg,.jpeg,.png"></div>
                  <div class="col-12"><label class="form-label">ملاحظات</label><textarea class="form-control" name="notes" rows="3"><%= clinic.Application_Notes||'' %></textarea></div>
                </div>
                <button class="btn btn-primary w-100 mt-4" type="submit">إعادة إرسال الطلب بعد الاستكمال</button>
              </form>
            <% } else if(status==='approved') { %>
              <a class="btn btn-success w-100 mt-4" href="/auth/continue">الدخول إلى العيادة المعتمدة</a>
            <% } %>
            <a class="btn btn-link w-100 mt-3" href="/doctor/profile">العودة إلى الملف الشخصي</a>
          </div>
        </div>
      </div>
    </div>
    <script src="../../../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
  <!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="../../assets/app.js"></script>


<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button><div>
        <!-- زر الدعم الفني العائم -->
        <button class="floating-chat-btn" id="chatToggleBtn" title="تواصل مع الدعم الفني">
            <i class="bi bi-chat-dots-fill"></i>
        </button>

        <!-- نافذة الشات المنبثقة -->
        <div class="chat-window" id="chatWindow">
            <div class="p-3 bg-primary text-white d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-headset fs-5"></i>
                    <div>
                        <h6 class="mb-0 fw-bold text-white">الدعم الفني للحسابات</h6>
                        <small class="text-white-50" style="font-size: 0.75rem;">متواجدون لمساعدتك</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" id="chatCloseBtn"></button>
            </div>
            <div class="p-3 bg-light" style="height: 230px; overflow-y: auto; font-size: 0.9rem;">
                <div class="bg-white p-2.5 rounded-3 border mb-2 shadow-sm text-dark" style="max-width: 85%;">
                    أهلاً بك! كيف يمكننا مساعدتك في حل مشكلة تسجيل الدخول أو حسابك اليوم؟
                </div>
            </div>
            <div class="p-2 border-top bg-white">
                <div class="input-group">
                    <input type="text" class="form-control form-control-sm" placeholder="اكتب رسالتك هنا..." value="" id="field-5" name="field_5">
                    <button class="btn btn-primary btn-sm" type="button" data-ui-pending=""><i class="bi bi-send"></i></button>
                </div>
            </div>
        </div>
    </div><div class="toast-container position-fixed bottom-0 start-0 p-3"><div id="backendPendingNotice" class="toast align-items-center text-bg-secondary border-0" role="status" aria-live="polite"><div class="d-flex"><div class="toast-body">هذه العملية بانتظار ربط الباك إند. لم تُحفظ أو تتغيّر أي بيانات.</div><button type="button" class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" aria-label="إغلاق"></button></div></div></div>
<link rel="stylesheet" href="/assets/form-errors.css">
<script defer src="/assets/form-errors.js"></script>
<script defer src="/assets/i18n.js"></script>
  </body></html>