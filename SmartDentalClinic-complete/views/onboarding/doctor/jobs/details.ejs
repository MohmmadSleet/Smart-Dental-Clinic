<!DOCTYPE html><html lang="<%= typeof lang === 'string' && lang === 'en' ? 'en' : 'ar' %>" dir="<%= typeof lang === 'string' && lang === 'en' ? 'ltr' : 'rtl' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>تفاصيل الوظيفة | Smart Dental Clinic</title><!-- Bootstrap fallback retained for all layouts. -->
<link rel="stylesheet" href="/assets/vendor/937abe4f713b-bootstrap.rtl.min.css"><% if (typeof lang === "string" && lang === "en") { %><link rel="stylesheet" href="/assets/vendor/bootstrap.ltr.min.css"><% } %><link rel="stylesheet" href="../../../assets/vendor/28667e4f82c7-bootstrap-icons.css"><link rel="stylesheet" href="../../assets/styles.css"><link rel="stylesheet" href="../../../assets/vendor/8c34d74036e9-css2-fonts.css"><link rel="stylesheet" href="/assets/i18n.css">
  </head>
<body><div class="auth-page jobs-public-page"><main class="container py-4 py-lg-5"><a class="small text-secondary" href="index">العودة للوظائف</a>
<div class="row g-4 mt-1"><div class="col-xl-8">
 <div class="job-detail-hero mb-4"><div class="d-flex justify-content-between align-items-start gap-3 flex-wrap"><div><div class="d-flex gap-2 mb-3"><span class="badge <%= job.available?'text-bg-success':'text-bg-secondary' %>"><%= job.available?'متاحة للتقديم':'غير متاحة حاليًا' %></span><span class="badge bg-white text-primary">J-<%= job.id %></span></div><h1 class="fw-bold mb-2"><%= job.title %></h1><p class="mb-0 opacity-75"><%= job.clinic %> • <%= job.city %></p></div><span class="job-clinic-icon large"><i class="bi bi-briefcase"></i></span></div></div>
 <section class="soft-public-card p-4 mb-4"><h4 class="fw-bold mb-3">نبذة عن الوظيفة</h4><p class="text-secondary mb-0" style="white-space:pre-wrap"><%= job.summary %></p></section>
 <section class="soft-public-card p-4 mb-4"><h4 class="fw-bold mb-3">المهام والمسؤوليات</h4><p class="text-secondary mb-0" style="white-space:pre-wrap"><%= job.responsibilities %></p></section>
 <section class="soft-public-card p-4 mb-4"><h4 class="fw-bold mb-3">المتطلبات</h4><p class="text-secondary mb-0" style="white-space:pre-wrap"><%= job.requirements %></p></section>
 <section class="soft-public-card p-4"><h4 class="fw-bold mb-3">عن العيادة</h4><div class="row g-3"><div class="col-md-6"><div class="job-info-box"><small>العيادة</small><strong><%= job.clinic %></strong></div></div><div class="col-md-6"><div class="job-info-box"><small>المدينة</small><strong><%= job.city %></strong></div></div><div class="col-md-6"><div class="job-info-box"><small>التخصص المطلوب</small><strong><%= job.specialty %></strong></div></div><div class="col-md-6"><div class="job-info-box"><small>نوع الدوام</small><strong><%= ({full_time:'دوام كامل',part_time:'دوام جزئي',contract:'عقد'})[job.employment]||job.employment %></strong></div></div></div></section>
 </div><div class="col-xl-4"><section class="soft-public-card p-4 job-apply-sidebar" id="apply"><h4 class="fw-bold mb-3">ملخص الوظيفة</h4><div class="summary-row"><span>الخبرة المطلوبة</span><strong><%= job.experience %> <%= sdcT("سنوات+") %></strong></div><div class="summary-row"><span>ساعات العمل</span><strong><%= job.schedule %></strong></div><div class="summary-row"><span>الراتب</span><strong><%= job.salary %></strong></div><div class="summary-row"><span>آخر موعد</span><strong><%= job.deadline %></strong></div><hr>
 <div class="verified-profile-box mb-3"><i class="bi bi-patch-check-fill"></i><div><strong>ملف الطبيب الحالي</strong><small><%= profile.name %> • <%= profile.license %></small></div></div>
 <% if(job.application_id){ %><div class="alert alert-info">لقد أرسلت طلبًا لهذه الوظيفة بالفعل.</div><a class="btn btn-outline-primary w-100" href="application-status?application=<%= job.application_id %>">عرض طلبك</a>
 <% }else if(canApply){ %><button class="btn btn-primary w-100 py-2" data-bs-target="#jobApplyModal" data-bs-toggle="modal" id="openJobApply" type="button">التقديم على الوظيفة</button><p class="small text-secondary mt-3">ستراجع بياناتك ومرفقاتك قبل تأكيد الإرسال. لا يتم إنشاء الطلب قبل الضغط على التأكيد.</p>
 <% }else{ %><div class="alert alert-warning small"><%= !job.available?'الإعلان مغلق أو انتهى موعده أو تم تعليقه إداريًا.':profile.license_status!=='verified'?'يجب اعتماد ترخيص الطبيب قبل التقديم.':'تخصص الطبيب لا يطابق التخصص المطلوب.' %></div><% } %>
 </section></div></div></main></div>
 <% if(canApply){ %><div class="modal fade" id="jobApplyModal" tabindex="-1"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content border-0 rounded-4"><div class="modal-header"><div><h5 class="modal-title fw-bold"><%= sdcT("التقديم على") %> <%= job.title %></h5><small class="text-secondary">البيانات المهنية الأساسية محفوظة في حساب الطبيب.</small></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div>
 <form class="job-application-modal-form" id="doctorJobApplicationForm" method="post" action="/onboarding/doctor/jobs/<%= job.id %>/apply" enctype="multipart/form-data" data-job-id="<%= job.id %>" data-job-title="<%= job.title %>" data-clinic-name="<%= job.clinic %>" data-can-apply="true">
  <input type="hidden" name="csrf_token" value="<%= csrfToken %>"><div class="modal-body"><div class="application-section"><div class="section-heading"><span>1</span><div><strong>بيانات المتقدم</strong><small>الاسم والترخيص والبريد والتخصص تُقرأ من حسابك.</small></div></div><div class="row g-3">
  <div class="col-md-6"><label class="form-label">الاسم الكامل</label><input class="form-control" readonly name="full_name" value="<%= profile.name %>"></div>
  <div class="col-md-6"><label class="form-label">التخصص المطلوب</label><input class="form-control" readonly name="specialty_id" value="<%= job.specialty %>"></div>
  <div class="col-md-6"><label class="form-label">رقم الترخيص</label><input class="form-control" readonly name="license_number" value="<%= profile.license %>"></div>
  <div class="col-md-6"><label class="form-label">البريد الإلكتروني</label><input class="form-control" readonly name="email" type="email" value="<%= profile.email %>"></div>
  <div class="col-md-6"><label class="form-label is-required" for="applicantPhone">رقم الهاتف *</label><input id="applicantPhone" class="form-control" required name="applicant_phone" value="<%= profile.phone %>" maxlength="30"></div>
  <div class="col-md-6"><label class="form-label is-required" for="applicantCity">مدينة السكن *</label><input id="applicantCity" class="form-control" required name="applicant_city" maxlength="150" placeholder="مدينة السكن"></div>
  <div class="col-md-6"><label class="form-label is-required" for="applicantExperience">سنوات الخبرة *</label><input id="applicantExperience" class="form-control" required type="number" min="0" max="60" name="applicant_experience" value="<%= profile.years??0 %>"></div>
  <div class="col-md-6"><label class="form-label" for="applicantExpectedSalary">الراتب المتوقع (اختياري)</label><input id="applicantExpectedSalary" class="form-control" name="applicant_expected_salary" type="number" min="0" step="0.01" placeholder="مثال: 3000"></div>
  </div></div><div class="application-section"><div class="section-heading"><span>2</span><div><strong>المرفقات</strong><small>احفظ نسخة من السير الذاتية والوثائق مع الطلب.</small></div></div><div class="row g-3">
  <div class="col-md-6"><label class="form-label is-required" for="applicantCv">السيرة الذاتية *</label><input id="applicantCv" class="form-control" required name="applicant_cv" type="file" accept=".pdf,.doc,.docx"><div class="form-text">PDF أو Word حتى 5MB</div></div>
  <div class="col-md-6"><label class="form-label" for="applicantCertificates">مرفقات داعمة (حتى 3 ملفات)</label><input id="applicantCertificates" class="form-control" name="applicant_certificates" type="file" multiple accept=".pdf,.jpg,.jpeg,.png,.doc,.docx"><div class="form-text">حتى 5MB لكل ملف</div></div>
  </div></div><div class="application-section"><div class="section-heading"><span>3</span><div><strong>رسالة التقديم</strong><small>اختيارية، تساعد العيادة على تقييم طلبك.</small></div></div><textarea id="applicantCoverLetter" class="form-control" name="applicant_cover_letter" rows="4" maxlength="5000"></textarea></div>
  <label class="d-flex align-items-start gap-2 small mt-3"><input class="form-check-input mt-1" type="checkbox" id="applicationConsent" name="application_consent" value="on" required>أوافق على مشاركة بياناتي المهنية والمرفقات مع العيادة لغرض التوظيف.</label></div>
 <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">إلغاء</button><button type="submit" class="btn btn-primary" id="previewJobApplication">معاينة الطلب</button></div></form></div></div></div>
 <div class="modal fade" id="jobApplicationPreviewModal" tabindex="-1" aria-labelledby="jobApplicationPreviewTitle"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h5 id="jobApplicationPreviewTitle" class="modal-title fw-bold">معاينة طلب التقديم</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="العودة للتعديل"></button></div><div class="modal-body p-0"><iframe id="jobApplicationPreviewFrame" title="معاينة طلب التقديم" style="width:100%;height:75vh;border:0;display:block"></iframe></div></div></div></div>
 <% } %>
 <script src="../../../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script><script src="../../assets/jobs-api.js"></script><script src="../../assets/app.js"></script>
<link rel="stylesheet" href="/assets/form-errors.css">
<script defer src="/assets/form-errors.js"></script>
<script defer src="/assets/i18n.js"></script>
  </body></html>
