<!DOCTYPE html><html lang="<%= typeof lang === 'string' && lang === 'en' ? 'en' : 'ar' %>" dir="<%= typeof lang === 'string' && lang === 'en' ? 'ltr' : 'rtl' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>الوظائف المتاحة للأطباء | Smart Dental Clinic</title>
<!-- Bootstrap fallback retained for all layouts. -->
<link rel="stylesheet" href="/assets/vendor/937abe4f713b-bootstrap.rtl.min.css"><% if (typeof lang === "string" && lang === "en") { %><link rel="stylesheet" href="/assets/vendor/bootstrap.ltr.min.css"><% } %><link rel="stylesheet" href="../../../assets/vendor/28667e4f82c7-bootstrap-icons.css"><link rel="stylesheet" href="../../assets/styles.css"><link rel="stylesheet" href="../../../assets/vendor/8c34d74036e9-css2-fonts.css"><link rel="stylesheet" href="/assets/i18n.css">
  </head>
<body><div class="auth-page jobs-public-page"><main class="container py-4 py-lg-5">
 <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><a class="small text-secondary" href="../choose-path">العودة لاختيار المسار</a><h1 class="fw-bold mt-3 mb-2">الوظائف المتاحة للأطباء</h1><p class="text-secondary">إعلانات فعلية منشورة من عيادات معتمدة. راجع التفاصيل وأرسل طلبك من حساب الطبيب.</p></div><a href="application-status" class="btn btn-outline-primary"><i class="bi bi-file-earmark-person ms-1"></i>طلباتي (<%= applications.length %>)</a></div>
 <form method="get" action="index" class="jobs-filter-panel mb-4"><div class="row g-3 align-items-end">
 <div class="col-lg-4"><label class="form-label" for="q">المسمى أو العيادة</label><input id="q" class="form-control" name="q" value="<%= filters.q %>" placeholder="ابحث عن وظيفة..." maxlength="80"></div>
 <div class="col-md-3 col-lg-2"><label class="form-label" for="city">المدينة</label><input id="city" class="form-control" name="city" value="<%= filters.city %>" maxlength="100" placeholder="كل المدن"></div>
 <div class="col-md-4 col-lg-3"><label class="form-label" for="specialty">التخصص</label><select class="form-select" id="specialty" name="specialty"><option value="">كل التخصصات</option><% for(const s of specialties){ %><option value="<%= s.id %>" <%= filters.specialty===s.id?'selected':'' %>><%= s.name %></option><% } %></select></div>
 <div class="col-md-3 col-lg-2"><label class="form-label" for="employment">نوع الدوام</label><select id="employment" class="form-select" name="employment"><option value="">الكل</option><% for(const [value,name] of Object.entries({full_time:'دوام كامل',part_time:'دوام جزئي',contract:'عقد'})){ %><option value="<%= value %>" <%= filters.employment===value?'selected':'' %>><%= name %></option><% } %></select></div>
 <div class="col-md-2 col-lg-1"><button type="submit" class="btn btn-primary w-100">بحث</button></div></div></form>
 <div class="d-flex justify-content-between align-items-center mb-3"><strong><%= pager.total %> <%= sdcT("وظيفة متاحة") %></strong><span class="text-secondary small">تظهر الإعلانات المنشورة غير المنتهية فقط</span></div>
 <div class="row g-4" id="availableJobsGrid"><% for(const j of jobs){ %><div class="col-lg-6 available-job-item"><article class="public-job-card h-100">
  <div class="d-flex justify-content-between gap-2"><span class="badge text-bg-success">متاحة</span><span class="job-code">J-<%= j.id %></span></div>
  <div class="d-flex align-items-center gap-3 mt-3"><span class="job-clinic-icon"><i class="bi bi-hospital"></i></span><div><h2 class="job-title mb-1"><%= j.title %></h2><span class="small text-secondary"><%= j.clinic %> • <%= j.city %></span></div></div>
  <div class="job-facts"><span><i class="bi bi-clock"></i><%= ({full_time:'دوام كامل',part_time:'دوام جزئي',contract:'عقد'})[j.employment]||j.employment %></span><span><i class="bi bi-award"></i><%= j.specialty %></span><span><i class="bi bi-briefcase"></i><%= j.experience %> <%= sdcT("سنوات خبرة") %></span></div>
  <p class="text-secondary"><%= j.summary.length>220?j.summary.slice(0,220)+'…':j.summary %></p>
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-auto"><small class="text-secondary"><%= sdcT("آخر تقديم:") %> <%= j.deadline %></small><a class="btn btn-primary btn-sm" href="details?id=<%= j.id %>">التفاصيل والتقديم</a></div>
 </article></div><% } %>
 <% if(!jobs.length){ %><div class="col-12"><div class="alert alert-info">لا توجد وظائف منشورة تطابق البحث حاليًا. جرّب تغيير الفلاتر.</div></div><% } %></div>
 <% if(pager.pages>1){ %><nav aria-label="صفحات الوظائف" class="d-flex gap-3 justify-content-center align-items-center mt-4"><% if(pager.page>1){ %><a class="btn btn-outline-primary btn-sm" href="index?<%= new URLSearchParams({...filters,page:String(pager.page-1)}).toString() %>">السابق</a><% } %><span>صفحة <%= pager.page %> <%= sdcT("من") %> <%= pager.pages %></span><% if(pager.page<pager.pages){ %><a class="btn btn-outline-primary btn-sm" href="index?<%= new URLSearchParams({...filters,page:String(pager.page+1)}).toString() %>">التالي</a><% } %></nav><% } %>
 </main></div><script src="../../../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="/assets/form-errors.css">
<script defer src="/assets/form-errors.js"></script>
<script defer src="/assets/i18n.js"></script>
  </body></html>
