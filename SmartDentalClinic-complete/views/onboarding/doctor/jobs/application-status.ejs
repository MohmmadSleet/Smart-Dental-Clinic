<!DOCTYPE html><html lang="<%= typeof lang === 'string' && lang === 'en' ? 'en' : 'ar' %>" dir="<%= typeof lang === 'string' && lang === 'en' ? 'ltr' : 'rtl' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>طلبات التوظيف | Smart Dental Clinic</title><!-- Bootstrap fallback retained for all layouts. -->
<link rel="stylesheet" href="/assets/vendor/937abe4f713b-bootstrap.rtl.min.css"><% if (typeof lang === "string" && lang === "en") { %><link rel="stylesheet" href="/assets/vendor/bootstrap.ltr.min.css"><% } %><link rel="stylesheet" href="../../../assets/vendor/28667e4f82c7-bootstrap-icons.css"><link rel="stylesheet" href="../../assets/styles.css"><link rel="stylesheet" href="../../../assets/vendor/8c34d74036e9-css2-fonts.css"><link rel="stylesheet" href="/assets/i18n.css">
  </head>
<body><main class="auth-page"><div class="container py-4 py-lg-5"><div class="auth-card mx-auto" style="max-width:850px"><div class="auth-form-wrap"><div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><span class="hero-badge">Job Applications</span><h1 class="mt-3 mb-1">طلبات التوظيف</h1><p class="text-secondary">حالة طلباتك المحفوظة والردود الواردة من العيادات.</p></div><a class="btn btn-outline-primary" href="index">الوظائف المتاحة</a></div>
 <% if(saved){ %><div class="alert alert-success">تم تحديث الطلب بنجاح.</div><% } %>
 <% if(error){ %><div class="alert alert-warning" role="alert"><%= error==='expired'?'لم تعد دعوة الانضمام متاحة. قد تكون العيادة ألغتها أو تمت معالجتها.':'تعذّر تأكيد الانضمام؛ تحقق من حالة العيادة والطلب.' %></div><% } %>
 <% if(detail){const a=detail.application; %><section class="soft-card p-4 mb-4"><h4 class="fw-bold mb-3"><%= sdcT("طلب رقم") %> <%= a.Application_ID %></h4><div class="summary-row"><span>الوظيفة</span><strong><%= a.Job_Title %></strong></div><div class="summary-row"><span>العيادة</span><strong><%= a.Clinic_Name %></strong></div><div class="summary-row"><span>الحالة</span><strong><%= ({pending:'قيد المراجعة',accepted:'مقبول لدى العيادة',rejected:'مرفوض',withdrawn:'مسحوب'})[a.Application_Status]||a.Application_Status %></strong></div><div class="summary-row"><span>تاريخ التقديم</span><strong><%= new Date(a.Applied_At).toLocaleDateString('ar-PS') %></strong></div><div class="summary-row"><span>رد العيادة</span><strong><%= a.Clinic_Feedback||'لم ترفق العيادة ردًا بعد.' %></strong></div><% if(a.Application_Status==='accepted'){ %>
  <% if(a.job_membership_status==='pending'){ %>
   <div class="alert alert-info mt-3" role="status">تم قبول طلبك من العيادة. اختر تأكيد الانضمام أو الاعتذار. لن تتاح لحجز المرضى حتى تُحدد العيادة خدماتك ودوامك.</div>
   <div class="d-flex flex-wrap gap-2 mb-3"><form method="post" action="/onboarding/doctor/jobs/applications/<%= a.Application_ID %>/join"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="action" value="accept"><button type="submit" class="btn btn-primary">تأكيد الانضمام إلى العيادة</button></form>
   <form method="post" action="/onboarding/doctor/jobs/applications/<%= a.Application_ID %>/join" onsubmit="return confirm('هل تريد الاعتذار عن الانضمام إلى هذه العيادة؟')"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="action" value="decline"><button type="submit" class="btn btn-outline-danger">الاعتذار عن الانضمام</button></form></div>
  <% } else if(a.job_membership_status==='active'){ %><div class="alert alert-success mt-3" role="status"><%= a.ready_for_booking?'أكّدت الانضمام وأصبحت خدماتك ودوامك مجهزين للحجز في العيادة.':'أكّدت الانضمام إلى العيادة. تستطيع العيادة الآن تجهيز الخدمات والدوام؛ لا تتاح المواعيد حتى يكتمل الإعداد.' %></div>
  <% } else if(a.job_membership_status==='inactive'){ %><div class="alert alert-secondary mt-3" role="status">اعتذرت عن الانضمام إلى العيادة بعد قبول طلبك.</div>
  <% } else { %><div class="alert alert-warning mt-3">دعوة الانضمام غير متاحة حاليًا. تواصل مع العيادة.</div><% } %>
 <% } %>
 <div class="d-flex flex-wrap gap-2 mt-3"><a class="btn btn-outline-primary" href="application-preview?application=<%= a.Application_ID %>">عرض الطلب والمرفقات</a><% if(a.Application_Status==='pending'){ %><form method="post" action="/onboarding/doctor/jobs/applications/<%= a.Application_ID %>/withdraw" onsubmit="return confirm('هل تريد سحب الطلب قبل اتخاذ القرار؟')"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button class="btn btn-outline-danger" type="submit">سحب الطلب</button></form><% } %></div></section><% } %>
 <h4 class="fw-bold mb-3">جميع طلباتي</h4><% for(const a of applications){ %><div class="soft-card p-3 mb-3"><div class="d-flex gap-3 justify-content-between align-items-center flex-wrap"><div><h5 class="fw-bold mb-1"><%= a.title %></h5><p class="text-secondary small mb-1"><%= a.clinic %> • <%= new Date(a.applied).toLocaleDateString('ar-PS') %></p><span class="badge text-bg-light border"><%= ({pending:'قيد المراجعة',accepted:'مقبول لدى العيادة',rejected:'مرفوض',withdrawn:'مسحوب'})[a.status]||a.status %></span></div><a class="btn btn-outline-primary btn-sm" href="application-status?application=<%= a.id %>">التفاصيل</a></div></div><% } %>
 <% if(!applications.length){ %><div class="alert alert-info">لم ترسل طلب توظيف بعد.</div><% } %>
 </div></div></div></main><script src="../../../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="/assets/form-errors.css">
<script defer src="/assets/form-errors.js"></script>
<script defer src="/assets/i18n.js"></script>
  </body></html>
