<!DOCTYPE html><html lang="<%= typeof lang === 'string' && lang === 'en' ? 'en' : 'ar' %>" dir="<%= typeof lang === 'string' && lang === 'en' ? 'ltr' : 'rtl' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>معاينة طلب التوظيف | Smart Dental Clinic</title><!-- Bootstrap fallback retained for all layouts. -->
<link rel="stylesheet" href="/assets/vendor/937abe4f713b-bootstrap.rtl.min.css"><% if (typeof lang === "string" && lang === "en") { %><link rel="stylesheet" href="/assets/vendor/bootstrap.ltr.min.css"><% } %><link rel="stylesheet" href="../../../assets/vendor/28667e4f82c7-bootstrap-icons.css"><link rel="stylesheet" href="../../assets/styles.css"><link rel="stylesheet" href="../../../assets/vendor/8c34d74036e9-css2-fonts.css"><link rel="stylesheet" href="/assets/i18n.css">
  </head><body><main class="auth-page"><div class="container py-4"><div class="auth-card mx-auto" style="max-width:960px"><div class="auth-form-wrap"><div class="mb-4"><span class="hero-badge">Job Application</span><h1 id="applicationPreviewHeading" class="mt-3 mb-2"><%= before?'راجع طلبك قبل الإرسال':'طلب التوظيف المقدم' %></h1><p class="text-secondary" id="applicationPreviewDescription">معلومات الطلب والمرفقات وقت تقديمه</p></div>
 <div id="previewWaiting" class="alert alert-info" <%= before?'':'hidden' %>>تُحمّل المعاينة من نموذج التقديم قبل إرسالها.</div>
 <div id="jobApplicationPreviewContent" <%= before?'hidden':'' %>>
  <section class="soft-card p-3 mb-3"><h5 class="fw-bold mb-3">الوظيفة والعيادة</h5><div class="summary-row"><span>الوظيفة</span><strong data-preview="job_title"><%= detail?.application?.Job_Title||'' %></strong></div><div class="summary-row"><span>رقم الوظيفة</span><strong data-preview="job_id"><%= detail?.application?.Job_ID||'' %></strong></div><div class="summary-row"><span>العيادة</span><strong data-preview="clinic_name"><%= detail?.application?.Clinic_Name||'' %></strong></div>
  <div data-submitted-only><div class="summary-row"><span>رقم الطلب</span><strong><%= detail?.application?.Application_ID||'' %></strong></div><div class="summary-row"><span>الحالة</span><strong><%= detail?({pending:'قيد المراجعة',accepted:'مقبول',rejected:'مرفوض',withdrawn:'مسحوب'})[detail.application.Application_Status]||detail.application.Application_Status:'' %></strong></div></div></section>
  <section class="soft-card p-3 mb-3"><h5 class="fw-bold mb-3">بيانات الطبيب عند التقديم</h5>
  <% for(const [key,label,value] of [['full_name','الاسم',detail?.application?.Full_Name],['email','البريد',detail?.application?.Email],['phone','الهاتف',detail?.application?.Phone],['residence_city','المدينة',detail?.application?.Residence_City],['specialty','التخصص',detail?.application?.Specialty_Name],['license_number','رقم الترخيص',detail?.application?.License_Number],['license_status','حالة الترخيص',detail?.application?.License_Status],['experience_years','سنوات الخبرة',detail?.application?.Years_Of_Experience],['expected_salary','الراتب المتوقع',detail?.application?.Expected_Salary]]){ %><div class="summary-row"><span><%= label %></span><strong data-preview="<%= key %>"><%= value??'غير محدد' %></strong></div><% } %></section>
  <section class="soft-card p-3 mb-3"><h5 class="fw-bold mb-3">رسالة التقديم</h5><p data-preview="cover_letter" style="white-space:pre-wrap;overflow-wrap:anywhere"><%= detail?.application?.Cover_Letter||'بدون رسالة' %></p></section>
  <section class="soft-card p-3 mb-3"><h5 class="fw-bold mb-3">المرفقات</h5><ul class="list-group" id="applicationPreviewAttachments"><% if(detail){ %><% for(const f of detail.attachments){ %><li class="list-group-item"><a href="/onboarding/doctor/jobs/applications/<%= detail.application.Application_ID %>/attachments/<%= f.id %>"><%= f.name %></a></li><% } %><% } %></ul></section>
  <section class="soft-card p-3 mb-3"><h5 class="fw-bold">الموافقة</h5><p data-preview="consent" class="mb-0">تمت الموافقة على مشاركة البيانات المهنية لغرض التوظيف.</p></section>
  <% if(detail){ %><section class="soft-card p-3 mb-3" data-submitted-only><h5 class="fw-bold">ملاحظة العيادة</h5><p class="mb-0"><%= detail.application.Clinic_Feedback||'لا توجد ملاحظات بعد.' %></p></section><% } %>
 </div>
 <div id="beforeApplicationActions" class="d-flex flex-wrap gap-2 mt-4" hidden><button type="button" id="editPreviewApplication" class="btn btn-outline-primary">العودة والتعديل</button><button type="button" id="confirmPreviewApplication" class="btn btn-primary">تأكيد وإرسال الطلب</button></div>
 <div id="submittedApplicationActions" class="d-flex gap-2 mt-4" <%= before?'hidden':'' %>><a class="btn btn-outline-primary" href="application-status<%= detail?'?application='+detail.application.Application_ID:'' %>">حالة الطلب</a><a class="btn btn-light border" href="index">العودة للوظائف</a></div>
 <div id="applicationPreviewError" class="alert alert-danger mt-3" role="alert" hidden></div>
 </div></div></div></main><script src="../../../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script><script src="../../assets/app.js"></script>
<link rel="stylesheet" href="/assets/form-errors.css">
<script defer src="/assets/form-errors.js"></script>
<script defer src="/assets/i18n.js"></script>
  </body></html>
