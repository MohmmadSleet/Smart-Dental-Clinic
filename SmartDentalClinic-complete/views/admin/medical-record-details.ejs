<!DOCTYPE html><html lang="<%= typeof lang === 'string' && lang === 'en' ? 'en' : 'ar' %>" dir="<%= typeof lang === 'string' && lang === 'en' ? 'ltr' : 'rtl' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>حالة التقرير الطبي | Smart Dental Clinic</title>
<!-- Bootstrap fallback retained for all layouts. -->
<link rel="stylesheet" href="/assets/vendor/937abe4f713b-bootstrap.rtl.min.css"><% if (typeof lang === "string" && lang === "en") { %><link rel="stylesheet" href="/assets/vendor/bootstrap.ltr.min.css"><% } %><link rel="stylesheet" href="../assets/vendor/28667e4f82c7-bootstrap-icons.css"><link rel="stylesheet" href="assets/styles.css"><link rel="stylesheet" href="../assets/vendor/8c34d74036e9-css2-fonts.css"><link rel="stylesheet" href="/assets/i18n.css">
  </head><body class="admin-workspace"><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a><%- include('../partials/admin/header') %>
<main class="page-shell" id="main-content"><section class="container py-4 py-lg-5">
<nav class="admin-crumbs" aria-label="مسار الصفحة"><a href="/admin/index"><i class="bi bi-house-door ms-1"></i>الرئيسية</a><i class="bi bi-chevron-left" aria-hidden="true"></i><span class="admin-crumb-current">الرقابة على التقرير</span></nav><% const v=typeof medicalRecord!=='undefined'?medicalRecord:null;const logs=typeof medicalAudit!=='undefined'?medicalAudit:[];const notice=typeof medicalNotice!=='undefined'?medicalNotice:'';const visitNames={draft:'مسودة',in_progress:'قيد التنفيذ',completed:'مكتملة'}; %>
<nav aria-label="مسار التنقل"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/admin/medical-records">السجلات والتقارير الطبية</a></li><li class="breadcrumb-item active"><%= sdcT("حالة الزيارة") %> <%= v?'#'+v.id:'' %></li></ol></nav>
<% if(v){ %><div class="d-flex flex-wrap justify-content-between gap-3 align-items-start mb-4"><div><span class="badge badge-soft mb-2">عرض إداري محدود</span><h1 class="fw-bold fs-2 mb-2"><%= sdcT("الزيارة #") %><%= v.id %></h1><p class="text-secondary mb-0">البيانات التشغيلية الخاصة باعتماد التقرير، دون كشف المحتوى السريري.</p></div><span class="badge fs-6 <%= v.report_approved?'text-bg-success':'text-bg-secondary' %>"><%= v.report_approved?'تقرير معتمد':'تقرير غير معتمد' %></span></div>
<div class="alert alert-info rounded-4"><i class="bi bi-shield-lock ms-2"></i>الشكوى والتشخيص والعلاج والوصفة الطبية والأشعة والتقرير المعتمد نفسه محجوبة عن هذه الشاشة. اعتماد التقرير وتعديله مسؤولية الطبيب المخوّل.</div>
<% if(notice){ %><div role="status" class="alert <%= notice==='noted'?'alert-success':'alert-warning' %>"><%= notice==='noted'?'تم حفظ الملاحظة الرقابية دون أي تعديل على السجل الطبي.':notice==='invalid'?'يجب كتابة ملاحظة من 8 إلى 1000 حرف دون أسطر جديدة.':'تعذّر حفظ الملاحظة؛ لم تتغير بيانات الزيارة.' %></div><% } %>
<div class="row g-4 mb-4"><div class="col-lg-7"><section class="soft-card p-4 h-100"><h2 class="h5 fw-bold mb-3">بيانات الزيارة الإدارية</h2><dl class="row g-3 mb-0"><dt class="col-sm-5 text-secondary">رقم الزيارة</dt><dd class="col-sm-7">#<%= v.id %></dd><dt class="col-sm-5 text-secondary">الحجز المرتبط</dt><dd class="col-sm-7"><a href="/admin/appointment-details?id=<%= v.booking_id %>">#<%= v.booking_id %></a></dd><dt class="col-sm-5 text-secondary">العيادة</dt><dd class="col-sm-7"><%= v.clinic_name %></dd><dt class="col-sm-5 text-secondary">الطبيب</dt><dd class="col-sm-7"><%= v.doctor_name %></dd><dt class="col-sm-5 text-secondary">تاريخ الموعد</dt><dd class="col-sm-7" dir="ltr"><%= v.appointment_date %></dd><dt class="col-sm-5 text-secondary">حالة الزيارة</dt><dd class="col-sm-7"><%= visitNames[v.visit_status]||v.visit_status %></dd></dl></section></div>
<div class="col-lg-5"><section class="soft-card p-4 h-100"><h2 class="h5 fw-bold mb-3">اعتماد التقرير</h2><p class="mb-2"><strong><%= v.report_approved?'معتمد':'لم يُعتمد بعد' %></strong></p><p class="text-secondary mb-0"><%= v.approved_at?'تاريخ الاعتماد: '+new Date(v.approved_at).toLocaleString('ar-PS'):'لم يُسجل تاريخ اعتماد.' %></p><hr><p class="small text-secondary mb-0">لا توجد هنا إجراءات إبطال أو اعتماد أو تنزيل التقرير الطبي. تُسجل أي ملاحظة رقابية في سجل التدقيق فقط.</p></section></div></div>
<div class="row g-4"><div class="col-lg-6"><section class="soft-card p-4 h-100"><h2 class="h5 fw-bold mb-3">الأحداث الرقابية المرتبطة</h2><% if(!logs.length){ %><p class="text-secondary">لا توجد أحداث مدققة بعد.</p><% }else{ %><div class="timeline"><% logs.forEach(log=>{ %><div class="timeline-item"><strong><%= log.action==='visit.admin.oversight_note'?'ملاحظة رقابية من المشرف':log.action==='visit.report.approved'?'اعتماد التقرير':'حدث مرتبط بالزيارة' %></strong><div class="small text-secondary"><%= log.actor||'النظام' %> · <%= log.occurred_at?new Date(log.occurred_at).toLocaleString('ar-PS'):'—' %></div><% if(log.reason){ %><p class="mb-0 mt-2"><%= log.reason %></p><% } %></div><% }) %></div><% } %></section></div>
<div class="col-lg-6"><section class="soft-card p-4 h-100"><h2 class="h5 fw-bold mb-2">ملاحظة رقابية</h2><p class="small text-secondary">إضافة ملاحظة إدارية عن حالة التقرير أو سير المراجعة فقط، دون إدراج معلومات صحية شخصية.</p><form action="/admin/medical-record-details/<%= v.id %>/note" method="post"><input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>"><label for="medicalAdminNote" class="form-label">سبب الملاحظة</label><textarea id="medicalAdminNote" name="reason" rows="5" minlength="8" maxlength="1000" class="form-control mb-3" required placeholder="ملاحظة إدارية عن اعتماد التقرير أو إجراء المراجعة..."></textarea><button class="btn btn-primary" type="submit"><i class="bi bi-journal-check ms-1"></i> توثيق الملاحظة</button></form></section></div></div>
<% }else{ %><div class="alert alert-info">اختر زيارة من قائمة السجلات لعرض حالتها.</div><% } %>
</section></main><script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script><script src="assets/app.js"></script><%- include('../partials/admin/footer') %><script defer src="/assets/i18n.js"></script>
  </body></html>
