<!DOCTYPE html><html dir="<%= typeof lang === 'string' && lang === 'en' ? 'ltr' : 'rtl' %>" lang="<%= typeof lang === 'string' && lang === 'en' ? 'en' : 'ar' %>"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>مالية المنصة | Smart Dental Clinic</title>
<!-- Bootstrap fallback retained for all layouts. -->
<link rel="stylesheet" href="/assets/vendor/937abe4f713b-bootstrap.rtl.min.css"><% if (typeof lang === "string" && lang === "en") { %><link rel="stylesheet" href="/assets/vendor/bootstrap.ltr.min.css"><% } %>
<link rel="stylesheet" href="../assets/vendor/28667e4f82c7-bootstrap-icons.css">
<link rel="stylesheet" href="assets/styles.css">
<link rel="stylesheet" href="../assets/vendor/8c34d74036e9-css2-fonts.css">
<link rel="stylesheet" href="/assets/i18n.css">
  </head><body class="admin-workspace"><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
<%- include('../partials/admin/header') %>
<main class="page-shell" id="main-content"><section class="container py-4 py-lg-5">
<nav class="admin-crumbs" aria-label="مسار الصفحة"><a href="/admin/index"><i class="bi bi-house-door ms-1"></i>الرئيسية</a><i class="bi bi-chevron-left" aria-hidden="true"></i><span class="admin-crumb-current">المالية والتسويات</span></nav>
<% const f=financeFilters;const rows=financeRows;const tot=financeTotals||{due:0,received:0,remaining:0,settled:0};
const money=n=>Number(n||0).toLocaleString('ar-EG',{minimumFractionDigits:2,maximumFractionDigits:2})+' ₪';
const tab=f.tab;const colors={paid:'text-bg-success',partial:'text-bg-warning',unpaid:'text-bg-secondary',void:'text-bg-danger'};
const states={paid:'مسددة بالكامل',partial:'مدفوعة جزئيًا',unpaid:'غير مسددة',void:'ملغاة سابقًا'};
const base=new URLSearchParams({tab,q:f.q,clinic:f.clinic,status:f.status,from:f.from,to:f.to});
const notice=typeof financeNotice!=='undefined'?financeNotice:'';
const nText={created:'تم إنشاء التسوية وربط الحجوزات المؤهلة بنجاح.',received:'تم تسجيل الدفعة التي استلمتها المنصة بنجاح.',duplicate:'رقم مرجع الدفع مسجل مسبقًا لهذه التسوية.',settled:'التسوية مسددة بالكامل.',excess:'المبلغ أكبر من الرصيد المتبقي.',not_found:'التسوية غير موجودة.',invalid:'المدخلات غير صحيحة. راجع العيادة والتواريخ ونسبة العمولة.',overlap:'توجد تسوية تتداخل مع هذه الفترة للعيادة.',empty:'لا توجد حجوزات مستوفية لشروط العمولة وغير مسوّاة في الفترة.',no_clinic:'العيادة غير نشطة أو غير معتمدة.',failed:'تعذر حفظ العملية. راجع سجل الخادم.'};%>
<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4"><div><span class="badge badge-soft mb-2">المتابعة والرقابة</span><h1 class="fw-bold fs-2 mb-2">مالية المنصة</h1>
<p class="text-secondary mb-0">متابعة عمولات المنصة وفواتير العيادات من مصدر واحد، مع الفصل بين صلاحيات المشرف وإدارة العيادة.</p></div>
<% if(tab==='settlements'){ %><a class="btn btn-outline-primary" href="/admin/settings?section=financeSettings"><i class="bi bi-gear ms-1"></i>إعدادات التسوية التلقائية</a><% } %></div>
<% if(nText[notice]){ %><div role="alert" class="alert <%= ['created','received'].includes(notice)?'alert-success':'alert-warning' %>"><%= nText[notice] %></div><% } %>
<div class="row g-3 mb-4">
<div class="col-6 col-xl-3"><div class="stat-card"><small class="text-secondary">العمولات المستحقة</small><div class="stat-value"><%= money(tot.due) %></div><small>الحجوزات المؤهلة ضمن التسويات</small></div></div>
<div class="col-6 col-xl-3"><div class="stat-card"><small class="text-secondary">المبالغ المستلمة</small><div class="stat-value text-success"><%= money(tot.received) %></div><small>دفعات التسويات المسجلة</small></div></div>
<div class="col-6 col-xl-3"><div class="stat-card"><small class="text-secondary">المبالغ المتبقية</small><div class="stat-value"><%= money(tot.remaining) %></div><small>المتبقي من العمولات المستحقة</small></div></div>
<div class="col-6 col-xl-3"><div class="stat-card"><small class="text-secondary">تسويات مسددة بالكامل</small><div class="stat-value"><%= tot.settled||0 %></div><small>تسويات بعمولة مستحقة</small></div></div>
</div>
<% if(tab==='settlements'){ %><div class="alert alert-info mb-4" role="status">تُنشأ التسويات تلقائيًا عند انتهاء الفترة المحددة في إعدادات المالية. يسجّل المشرف دفعات العيادات المستلمة من تفاصيل كل تسوية فقط، ولا توجد حاجة لإنشاء التسويات يدويًا.</div><% } %>
<div class="d-flex flex-wrap gap-2 mb-4" role="navigation" aria-label="تبويبات المالية"><a class="btn <%= tab==='settlements'?'btn-primary':'btn-light border' %>" href="/admin/finance?tab=settlements">تسويات العيادات</a><a class="btn <%= tab==='invoices'?'btn-primary':'btn-light border' %>" href="/admin/finance?tab=invoices">فواتير المرضى</a></div>
<div class="filter-panel mb-4"><form method="get" action="/admin/finance" class="row g-3"><input type="hidden" name="tab" value="<%= tab %>">
<div class="col-lg-4 col-md-6"><label for="fQuery" class="form-label">بحث</label><input id="fQuery" name="q" type="search" maxlength="80" class="form-control" value="<%= f.q %>" placeholder="<%= tab==='invoices'?'فاتورة، عيادة أو اسم مريض':'عيادة أو رقم تسوية' %>"></div>
<div class="col-lg-3 col-md-6"><label for="fClinic" class="form-label">العيادة</label><select id="fClinic" name="clinic" class="form-select"><option value="">كل العيادات</option><% financeClinics.forEach(c=>{ %><option value="<%= c.id %>" <%= f.clinic===c.id?'selected':'' %>><%= c.name %></option><% }); %></select></div>
<div class="col-lg-2 col-md-6"><label for="fStatus" class="form-label">حالة السداد</label><select id="fStatus" class="form-select" name="status"><option value="">كل الحالات</option><% Object.entries(states).filter(([key])=>tab==='invoices'||key!=='void').forEach(([key,label])=>{ %><option value="<%= key %>" <%= f.status===key?'selected':'' %>><%= label %></option><% }); %></select></div>
<div class="col-lg-3 col-md-6"><label for="fFrom" class="form-label">من تاريخ</label><input id="fFrom" name="from" type="date" class="form-control" value="<%= f.from %>"></div>
<div class="col-lg-3 col-md-6"><label for="fTo" class="form-label">حتى تاريخ</label><input id="fTo" name="to" type="date" class="form-control" value="<%= f.to %>"></div>
<div class="col-12 d-flex gap-2 flex-wrap align-items-center"><button type="submit" class="btn btn-primary"><i class="bi bi-search ms-1"></i> تطبيق الفلاتر</button><a href="/admin/finance?tab=<%= tab %>" class="btn btn-light border">مسح</a><a class="btn btn-outline-secondary" href="/admin/finance/export?<%= base.toString() %>"><i class="bi bi-download ms-1"></i>تصدير CSV</a><span class="small text-secondary me-auto"><%= financeTotal %> <%= sdcT("سجل مطابق") %></span></div>
</form></div>
<% if(tab==='settlements'){ %>
<div class="table-responsive mobile-stack-wrapper table-ui-shell"><table class="table align-middle mb-0 responsive-stack-table system-data-table wide-data-table"><thead><tr><th>التسوية والعيادة</th><th>الفترة / الاستحقاق</th><th>حجوزات مؤهلة</th><th>المستحق</th><th>المستلم</th><th>المتبقي</th><th>الحالة</th><th>التفاصيل</th></tr></thead><tbody>
<% if(!rows.length){ %><tr><td colspan="8" class="text-center py-5 text-secondary">لا توجد تسويات مطابقة.</td></tr><% } %>
<% rows.forEach(r=>{ %><tr><td data-label="التسوية والعيادة" class="table-primary-cell"><strong>#<%= r.id %></strong><div class="small text-secondary"><%= r.clinic_name %></div></td><td data-label="الفترة"><%= r.start %> — <%= r.finish %><div class="small text-secondary"><%= sdcT("الاستحقاق:") %> <%= r.due_date||'غير محدد (تسوية قديمة)' %></div></td><td data-label="حجوزات مؤهلة"><%= r.bookings %></td><td data-label="المستحق"><%= money(r.due) %></td><td data-label="المستلم"><%= money(r.received) %></td><td data-label="المتبقي"><%= money(r.remaining) %></td><td data-label="الحالة"><span class="badge <%= colors[r.state]||'text-bg-secondary' %>"><%= states[r.state]||r.state %></span></td><td data-label="التفاصيل"><a class="btn btn-outline-primary btn-sm" href="/admin/finance?tab=settlements&settlement=<%= r.id %>#settlementDetails">عرض</a></td></tr><% }) %>
</tbody></table></div>
<% } else { %>
<div class="table-responsive mobile-stack-wrapper table-ui-shell"><table class="table align-middle mb-0 responsive-stack-table system-data-table wide-data-table"><thead><tr><th>الفاتورة</th><th>العيادة</th><th>المريض</th><th>الإجمالي</th><th>المدفوع</th><th>المتبقي</th><th>الحالة</th><th>التفاصيل</th></tr></thead><tbody>
<% if(!rows.length){ %><tr><td colspan="8" class="text-center py-5 text-secondary">لا توجد فواتير مطابقة.</td></tr><% } %>
<% rows.forEach(r=>{ %><tr><td data-label="الفاتورة" class="table-primary-cell"><strong>#<%= r.id %></strong><div class="small text-secondary"><%= r.created %></div></td><td data-label="العيادة"><%= r.clinic_name %></td><td data-label="المريض"><%= r.patient_name %></td><td data-label="الإجمالي"><%= money(r.total) %></td><td data-label="المدفوع"><%= money(r.paid) %></td><td data-label="المتبقي"><%= money(r.remaining) %></td><td data-label="الحالة"><span class="badge <%= colors[r.state]||'text-bg-secondary' %>"><%= states[r.state]||r.state %></span></td><td data-label="التفاصيل"><a class="btn btn-outline-primary btn-sm" href="/admin/invoice-details?id=<%= r.id %>">عرض</a></td></tr><% }) %>
</tbody></table></div>
<% } %>
<% if(financePages>1){ %><nav class="mt-4" aria-label="صفحات المالية"><ul class="pagination justify-content-center flex-wrap gap-2"><% if(financePage>1){base.set('page',String(financePage-1));%><li class="page-item"><a class="page-link" href="/admin/finance?<%= base.toString() %>">السابق</a></li><% } %><li class="page-item disabled"><span class="page-link"><%= sdcT("صفحة") %> <%= financePage %> <%= sdcT("من") %> <%= financePages %></span></li><% if(financePage<financePages){base.set('page',String(financePage+1));%><li class="page-item"><a class="page-link" href="/admin/finance?<%= base.toString() %>">التالي</a></li><% } %></ul></nav><% } %>
<% if(tab==='settlements' && financeSettlementDetail){const s=financeSettlementDetail.settlement;%><section id="settlementDetails" class="soft-card p-4 mt-4"><div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3"><div><h2 class="fw-bold fs-5 mb-1"><%= sdcT("تفاصيل التسوية #") %><%= s.id %></h2><p class="text-secondary mb-0"><%= s.clinic_name %> · <%= s.start %> <%= sdcT("إلى") %> <%= s.finish %></p></div><a class="btn btn-light border" href="/admin/finance?tab=settlements">إغلاق التفاصيل</a></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="stat-card"><small>المستحق</small><div class="stat-value"><%= money(s.due) %></div></div></div><div class="col-md-4"><div class="stat-card"><small>المستلم</small><div class="stat-value"><%= money(s.received) %></div></div></div><div class="col-md-4"><div class="stat-card"><small>المتبقي</small><div class="stat-value"><%= money(s.remaining) %></div></div></div></div>
<h3 class="fs-6 fw-bold">الحجوزات المؤهلة ضمن التسوية</h3><div class="table-responsive mb-4"><table class="table table-sm align-middle"><thead><tr><th>الحجز</th><th>التاريخ</th><th>سعر الخدمة عند الحجز</th><th>نسبة العمولة</th><th>العمولة</th></tr></thead><tbody><% if(!financeSettlementDetail.bookings.length){ %><tr><td colspan="5">لا توجد حجوزات مؤهلة حاليًا.</td></tr><% } %><% financeSettlementDetail.bookings.forEach(b=>{ %><tr><td><a href="/admin/appointment-details?id=<%= b.id %>">#<%= b.id %></a></td><td><%= b.date %></td><td><%= money(b.price) %></td><td><%= b.rate %>%</td><td><%= money(b.amount) %></td></tr><% }); %></tbody></table></div>
<h3 class="fs-6 fw-bold">دفعات العمولة المستلمة والمسجلة بواسطة المشرف</h3><div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>التاريخ</th><th>المبلغ</th><th>الطريقة</th><th>المرجع</th><th>المُسجل</th></tr></thead><tbody><% if(!financeSettlementDetail.payments.length){ %><tr><td colspan="5" class="text-secondary">لم تُسجل دفعات بعد.</td></tr><% } %><% financeSettlementDetail.payments.forEach(p=>{ %><tr><td><%= p.at %></td><td><%= money(p.amount) %></td><td><%= ({cash:'نقدًا',card:'بطاقة',bank_transfer:'تحويل بنكي'})[p.method]||p.method %></td><td><%= p.reference||'—' %></td><td><%= p.actor||'—' %></td></tr><% }); %></tbody></table></div>
<% if(Number(s.remaining)>0){ %>
<div class="border-top pt-4 mt-4"><h3 class="fs-6 fw-bold">تسجيل دفعة مستلمة من العيادة</h3>
<p class="small text-secondary">يسجل المشرف فقط المبلغ الذي استلمته المنصة بالفعل. التسجيل لا ينفّذ تحويلًا ماليًا ولا يجوز تكرار مرجع الدفع داخل التسوية.</p>
<form method="post" action="/admin/finance/settlements/payment" class="row g-3">
<input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>">
<input type="hidden" name="settlement_id" value="<%= s.id %>">
<div class="col-md-3"><label class="form-label" for="receivedAmount">المبلغ المستلم (₪)</label><input type="number" class="form-control" id="receivedAmount" name="amount" min="0.01" max="<%= Number(s.remaining).toFixed(2) %>" step="0.01" required></div>
<div class="col-md-3"><label class="form-label" for="receivedMethod">طريقة الاستلام</label><select class="form-select" id="receivedMethod" name="method" required><option value="bank_transfer">تحويل بنكي</option><option value="cash">نقدًا</option><option value="card">بطاقة</option></select></div>
<div class="col-md-6"><label class="form-label" for="receivedReference">مرجع التحويل أو سند القبض</label><input type="text" class="form-control" id="receivedReference" name="reference" minlength="4" maxlength="80" autocomplete="off" required></div>
<div class="col-12"><label class="form-check"><input type="checkbox" class="form-check-input" name="confirm_transfer" value="yes" required><span class="form-check-label">أؤكد أن المنصة استلمت المبلغ بالفعل وأن المرجع صحيح.</span></label></div>
<div class="col-12"><button class="btn btn-primary" type="submit"><i class="bi bi-check-circle ms-1"></i>حفظ الدفعة المستلمة</button></div>
</form></div><% } else { %><p class="small text-success mb-0">التسوية مدفوعة بالكامل؛ لا يمكن تسجيل دفعة إضافية.</p><% } %></section><% } %>
<% if(tab==='settlements' && typeof financeRequestedSettlement!=='undefined' && financeRequestedSettlement && !financeSettlementDetail){ %><div role="alert" class="alert alert-warning mt-3">التسوية المطلوبة غير موجودة.</div><% } %>
</section></main><script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script><script src="assets/app.js"></script><%- include('../partials/admin/footer') %><script defer src="/assets/i18n.js"></script>
  </body></html>
