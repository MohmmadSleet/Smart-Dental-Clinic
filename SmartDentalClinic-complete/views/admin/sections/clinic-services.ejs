<section class="soft-card p-4 mb-4" id="clinicServices" aria-labelledby="csTitle">
 <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2 id="csTitle" class="h4 fw-bold mb-1">خدمات العيادة وأسعارها</h2><p class="text-secondary small mb-0">هنا يُحدَّد السعر والمدة والأطباء المكلَّفون في هذه العيادة فقط؛ لا تتغير أسعار الحجوزات السابقة.</p></div></div>
 <% const offers=services.offers||[]; const assignedDoctors=services.doctors||[]; const catalog=services.catalog||[]; %>
 <% if(!offers.length){ %><div class="alert alert-light border">لا توجد خدمات مفعلة داخل هذه العيادة بعد.</div><% } %>
 <% for(const offer of offers){ %>
 <details class="admin-record-edit mb-3"><summary class="d-flex flex-wrap justify-content-between align-items-center gap-3"><strong><%= offer.Service_Name %></strong><span class="text-secondary"><%= offer.Price %> ₪ • <%= offer.Duration_Minutes %> <%= sdcT("دقيقة") %> • <%= offer.Is_Available?'متاحة':'غير متاحة' %></span><span class="btn btn-sm btn-outline-primary">تعديل</span></summary>
 <form method="post" action="/admin/clinics/<%= clinic.id %>/services/save" class="row g-3 mt-2"><input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>"><input type="hidden" name="service_id" value="<%= offer.Service_ID %>"><input type="hidden" name="installments" value="<%= offer.Allows_Installments?'true':'false' %>">
 <div class="col-md-4"><label class="form-label">السعر (₪)<input type="number" min="0" step="0.01" max="9999999999" class="form-control" name="price" value="<%= offer.Price %>" required></label></div>
 <div class="col-md-4"><label class="form-label">المدة بالدقائق<input type="number" min="1" max="1440" class="form-control" name="duration" value="<%= offer.Duration_Minutes %>" required></label></div>
 <div class="col-md-4"><label class="form-label">حالة توفر الخدمة<select class="form-select" name="available"><option value="true" <%= offer.Is_Available?'selected':'' %>>متاحة للحجز</option><option value="false" <%= !offer.Is_Available?'selected':'' %>>غير متاحة</option></select></label></div>
 <div class="col-12"><strong class="d-block mb-2">الأطباء المخوّلون لهذه الخدمة</strong><div class="row g-2"><% for(const d of assignedDoctors){ %><label class="col-md-4 small"><input type="checkbox" name="doctor_ids" value="<%= d.Doctor_ID %>" <%= Array.isArray(offer.doctor_ids)&&offer.doctor_ids.map(String).includes(String(d.Doctor_ID))?'checked':'' %>> <%= sdcT("د.") %> <%= d.First_Name %> <%= d.Last_Name %></label><% } %></div></div>
 <div class="col-12"><label class="form-label w-100">سبب التعديل الإداري<input type="text" class="form-control" name="reason" required minlength="8" maxlength="1000"></label></div>
 <div class="col-12"><button type="submit" class="btn btn-primary" onclick="return confirm('حفظ سعر وخدمة هذه العيادة؟')">حفظ التعديلات</button></div></form></details>
 <% } %>
 <details class="admin-record-edit mt-3"><summary class="btn btn-outline-primary">إضافة خدمة إلى العيادة</summary>
 <form action="/admin/clinics/<%= clinic.id %>/services/save" method="post" class="row g-3 mt-2"><input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>"><input type="hidden" name="installments" value="false">
 <div class="col-md-6"><label class="form-label">الخدمة العامة<select name="service_id" class="form-select" required><option value="">اختر خدمة</option><% const assignedIds=new Set(offers.map(o=>String(o.Service_ID)));for(const item of catalog.filter(c=>!assignedIds.has(String(c.Service_ID)))){ %><option value="<%= item.Service_ID %>"><%= item.Service_Name %></option><% } %></select></label></div>
 <div class="col-md-3"><label class="form-label">السعر<input name="price" type="number" min="0" step="0.01" class="form-control" required></label></div>
 <div class="col-md-3"><label class="form-label">المدة بالدقائق<input name="duration" type="number" min="1" max="1440" class="form-control" required></label></div>
 <input type="hidden" name="available" value="true"><div class="col-12"><strong class="d-block mb-2">الأطباء المخوّلون</strong><div class="row g-2"><% for(const d of assignedDoctors){ %><label class="col-md-4 small"><input type="checkbox" name="doctor_ids" value="<%= d.Doctor_ID %>"> <%= sdcT("د.") %> <%= d.First_Name %> <%= d.Last_Name %></label><% } %></div></div>
 <div class="col-12"><label class="form-label w-100">سبب الإضافة<input name="reason" class="form-control" required minlength="8" maxlength="1000"></label></div><div class="col-12"><button class="btn btn-primary" type="submit">إضافة الخدمة لهذه العيادة</button></div></form></details>
 <div class="alert alert-light border mt-3 mb-0 small">إضافة خدمة عامة جديدة أو حذفها من المنصة يتم في قسم «الخدمات» الأساسي. هذا القسم يضبط ما تقدمه العيادة، دون إنشاء وظيفة مكررة.</div>
</section>