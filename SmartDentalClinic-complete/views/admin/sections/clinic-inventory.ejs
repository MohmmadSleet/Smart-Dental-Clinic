<section class="soft-card p-4 mb-4" id="clinicInventory" aria-labelledby="ciTitle"><div class="d-flex flex-wrap justify-content-between gap-2 align-items-center mb-3"><div><h2 id="ciTitle" class="h4 fw-bold mb-1">مخزون العيادة</h2><p class="small text-secondary mb-0">إضافة أصناف وتسجيل توريد أو استهلاك أو تسوية جرد مع سبب إداري، دون حذف تاريخ الحركات.</p></div><span class="badge text-bg-light border"><%= inventory.stats.total %> <%= sdcT("صنف") %> • <%= inventory.stats.low %> <%= sdcT("منخفض") %></span></div>
 <div class="table-responsive"><table class="table align-middle"><thead><tr><th>الصنف</th><th>الرصيد</th><th>الحد الأدنى</th><th>الحالة</th><th>حركة مخزون</th></tr></thead><tbody>
 <% for(const item of inventory.items){ %><tr><td><strong><%= item.name %></strong> <span class="small text-secondary"><%= item.unit %></span></td><td><%= item.qty %></td><td><%= item.minQty %></td><td><span class="badge <%= item.state==='available'?'text-bg-success':'text-bg-warning' %>"><%= item.state==='available'?'متوفر':item.state==='low'?'منخفض':'منتهٍ' %></span></td><td><details><summary class="btn btn-sm btn-outline-primary">تسجيل حركة</summary><form action="/admin/clinics/<%= clinic.id %>/inventory/move" method="post" class="d-grid gap-2 mt-2" style="min-width:240px"><input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>"><input type="hidden" name="item_id" value="<%= item.id %>"><select class="form-select form-select-sm" name="inventory_move_type" required><option value="in">توريد</option><option value="issue">استهلاك</option><option value="damaged">تالف</option><option value="adjust">تسوية رصيد</option></select><input name="inventory_move_qty" type="number" min="0.01" step="0.01" class="form-control form-control-sm" placeholder="الكمية / الرصيد الجديد" required><input name="inventory_move_reason" class="form-control form-control-sm" placeholder="وصف الحركة" maxlength="2000"><input name="reason" class="form-control form-control-sm" placeholder="السبب الإداري" minlength="8" maxlength="1000" required><button class="btn btn-sm btn-primary">حفظ الحركة</button></form></details></td></tr><% } %>
 <% if(!inventory.items.length){ %><tr><td colspan="5" class="text-center text-secondary">لا توجد أصناف في مخزون العيادة.</td></tr><% } %></tbody></table></div>
 <details class="admin-record-edit mt-3"><summary class="btn btn-outline-primary">إضافة صنف مخزون</summary><form method="post" action="/admin/clinics/<%= clinic.id %>/inventory/create" class="row g-3 mt-2"><input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>"><div class="col-md-6"><label class="form-label">اسم الصنف<input name="inv_name" required maxlength="150" class="form-control"></label></div><div class="col-md-3"><label class="form-label">الفئة<input name="inv_category" required maxlength="150" class="form-control"></label></div><div class="col-md-3"><label class="form-label">الوحدة<input name="inv_unit" required maxlength="150" class="form-control"></label></div><div class="col-md-3"><label class="form-label">الرصيد الافتتاحي<input name="inv_initial" type="number" min="0" step="0.01" required class="form-control"></label></div><div class="col-md-3"><label class="form-label">الحد الأدنى<input name="inv_min" type="number" min="0" step="0.01" required class="form-control"></label></div><div class="col-md-3"><label class="form-label">تاريخ الصلاحية (اختياري)<input name="inv_exp" type="date" class="form-control"></label></div><div class="col-md-9"><label class="form-label w-100">سبب الإضافة<input name="reason" required minlength="8" maxlength="1000" class="form-control"></label></div><div class="col-12"><button class="btn btn-primary">إضافة الصنف</button></div></form></details>
 </section>