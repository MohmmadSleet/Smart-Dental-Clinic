<section id="staff-section" class="soft-card p-4 mb-4" aria-labelledby="staff-head"><h2 id="staff-head" class="h4 fw-bold mb-3">الموظفون والصلاحيات</h2>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>الموظف</th><th>الدور والصلاحيات</th><th>تعديل العضوية</th><th>التعليق والحذف</th></tr></thead><tbody>
<% for(const u of staff){ %><tr><td><strong><%= u.name %></strong><div class="small text-secondary"><%= u.email %> • <%= u.status %></div></td><td><%= u.roleLabel %><div class="small text-secondary"><%= u.permissions.join('، ')||'بدون صلاحيات' %></div></td>
<td><form action="/admin/clinics/<%= clinic.id %>/staff" method="post" class="d-flex flex-column gap-2">
<input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>"><input type="hidden" name="action" value="update"><input type="hidden" name="staff_id" value="<%= u.id %>">
<label class="form-label mb-0">الدور<select name="clinic_role_id" class="form-select form-select-sm"><% for(const [key,role] of Object.entries(staffRoles)){ %><option value="<%= key %>" <%= u.role===key?'selected':'' %>><%= role.label %></option><% } %></select></label>
<label class="form-label mb-0">الحالة<select name="staff_form_status" class="form-select form-select-sm"><option value="active" <%= u.status==='active'?'selected':'' %>>فعال</option><option value="suspended" <%= u.status==='suspended'?'selected':'' %>>معلّق</option></select></label>
<details><summary>الصلاحيات التشغيلية</summary><div class="row g-1 mt-1"><% for(const perm of staffPermissions){ %><label class="col-lg-6 small"><input type="checkbox" name="permissions[]" value="<%= perm %>" <%= u.permissions.includes(perm)?'checked':'' %>> <%= perm %></label><% } %></div></details>
<input type="text" name="reason" class="form-control form-control-sm" required minlength="8" maxlength="1000" placeholder="سبب التعديل الإداري"><button type="submit" class="btn btn-outline-primary btn-sm">حفظ الدور والصلاحيات</button></form></td>
<td><% if(['active','suspended'].includes(u.status)){ %><form action="/admin/clinics/<%= clinic.id %>/staff" method="post" class="mb-2"><input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>"><input type="hidden" name="staff_id" value="<%= u.id %>"><input type="hidden" name="action" value="<%= u.status==='active'?'suspend':'activate' %>"><input name="reason" required minlength="8" maxlength="1000" class="form-control form-control-sm mb-1" placeholder="سبب تغيير الحالة"><button class="btn btn-sm btn-outline-warning" type="submit"><%= u.status==='active'?'تعليق':'إعادة تفعيل' %></button></form><% } %>
<form action="/admin/clinics/<%= clinic.id %>/staff" method="post" onsubmit="return confirm('حذف عضوية الموظف من هذه العيادة فقط؟')"><input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>"><input type="hidden" name="staff_id" value="<%= u.id %>"><input type="hidden" name="action" value="remove"><input name="reason" required minlength="8" maxlength="1000" class="form-control form-control-sm mb-1" placeholder="سبب حذف العضوية"><button class="btn btn-sm btn-outline-danger" type="submit">حذف من العيادة</button></form></td></tr><% } %>
</tbody></table></div>
