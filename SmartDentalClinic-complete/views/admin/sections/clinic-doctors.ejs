<section class="soft-card p-4 mb-4" id="doctor-section"><h2 class="h4 fw-bold mb-3">أطباء العيادة</h2><p class="small text-secondary">الطبيب الموثّق يُدعَى للانضمام؛ لا يُفعَّل ارتباطه إلا بعد قبوله. لا يمكن تعليق مدير العيادة بهذه العملية.</p>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>الطبيب</th><th>حالة العضوية</th><th>إجراء المشرف</th></tr></thead><tbody><% for(const d of doctors){ %><tr><td><%= d.name %> — D-<%= d.id %> <%= d.manager?'(مدير العيادة)':'' %></td><td><%= d.status %></td><td><% if(!d.manager&&['pending','active','suspended'].includes(d.status)){ const action=d.status==='pending'?'cancel':d.status==='active'?'suspend':'resume'; %><form action="/admin/clinics/<%= clinic.id %>/doctors/membership" method="post" class="d-flex flex-wrap gap-2"><input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>"><input type="hidden" name="doctor_id" value="<%= d.id %>"><input type="hidden" name="action" value="<%= action %>"><input type="text" name="reason" minlength="8" maxlength="1000" required class="form-control form-control-sm" placeholder="سبب الإجراء الإداري"><button type="submit" class="btn btn-outline-warning btn-sm"><%= action==='cancel'?'إلغاء الدعوة':action==='suspend'?'تعليق عضوية الطبيب':'استعادة العضوية' %></button></form><% }else{ %>—<% } %>
<% if(!d.manager&&['pending','suspended','active'].includes(d.status)){ %>
<form action="/admin/clinics/<%= clinic.id %>/doctors/membership" method="post" class="mt-2" onsubmit="return confirm('حذف ارتباط الطبيب بهذه العيادة؟ يُمنع عند وجود حجوزات أو ارتباطات تاريخية.')">
<input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>"><input type="hidden" name="doctor_id" value="<%= d.id %>"><input type="hidden" name="action" value="remove">
<input name="reason" required minlength="8" maxlength="1000" class="form-control form-control-sm mb-1" placeholder="سبب حذف الارتباط"><button class="btn btn-outline-danger btn-sm" type="submit">حذف ارتباط الطبيب</button></form><% } %>
</td></tr><% } %></tbody></table></div>
<details class="mt-3"><summary class="btn btn-primary">دعوة طبيب موثّق للعيادة</summary><form method="post" action="/admin/clinics/<%= clinic.id %>/doctors/invite" class="row g-3 mt-1"><input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>"><div class="col-md-5"><label class="form-label">الطبيب<select name="doctor_id" class="form-select" required><option value="">اختر الطبيب</option><% for(const d of candidates){ %><option value="<%= d.id %>"><%= d.name %> — <%= d.license %></option><% } %></select></label></div><div class="col-md-3"><label class="form-label">تاريخ بدء العمل<input type="date" name="clinic_doctor_start_date" required class="form-control"></label></div><div class="col-md-4"><label class="form-label">ملاحظة دعوة<input name="clinic_doctor_notes" class="form-control" maxlength="2000"></label></div><div class="col-12"><label class="form-label w-100">السبب الإداري<input name="reason" class="form-control" minlength="8" maxlength="1000" required></label></div><div class="col-12"><button class="btn btn-primary" type="submit">إرسال الدعوة</button></div></form></details>
</section>
