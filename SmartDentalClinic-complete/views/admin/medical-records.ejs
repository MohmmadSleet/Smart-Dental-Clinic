<!DOCTYPE html><html lang="<%= typeof lang === 'string' && lang === 'en' ? 'en' : 'ar' %>" dir="<%= typeof lang === 'string' && lang === 'en' ? 'ltr' : 'rtl' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>مراقبة السجلات الطبية | Smart Dental Clinic</title>
<!-- Bootstrap fallback retained for all layouts. -->
<link rel="stylesheet" href="/assets/vendor/937abe4f713b-bootstrap.rtl.min.css"><% if (typeof lang === "string" && lang === "en") { %><link rel="stylesheet" href="/assets/vendor/bootstrap.ltr.min.css"><% } %><link rel="stylesheet" href="../assets/vendor/28667e4f82c7-bootstrap-icons.css"><link rel="stylesheet" href="assets/styles.css"><link rel="stylesheet" href="../assets/vendor/8c34d74036e9-css2-fonts.css"><link rel="stylesheet" href="/assets/i18n.css">
  </head>
<body class="admin-workspace"><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a><%- include('../partials/admin/header') %>
<main class="page-shell" id="main-content"><section class="container py-4 py-lg-5">
<nav class="admin-crumbs" aria-label="مسار الصفحة"><a href="/admin/index"><i class="bi bi-house-door ms-1"></i>الرئيسية</a><i class="bi bi-chevron-left" aria-hidden="true"></i><span class="admin-crumb-current">التقارير الطبية</span></nav>
<% const rows=typeof medicalRows!=='undefined'?medicalRows:[];const clinics=typeof medicalClinics!=='undefined'?medicalClinics:[];const f=typeof medicalFilters!=='undefined'?medicalFilters:{q:'',clinic:'',state:'',from:'',to:''};const total=typeof medicalTotal!=='undefined'?medicalTotal:0;const page=typeof medicalPage!=='undefined'?medicalPage:1;const pages=typeof medicalPages!=='undefined'?medicalPages:1;const qs=new URLSearchParams({q:f.q,clinic:f.clinic,state:f.state,from:f.from,to:f.to});const visitNames={draft:'مسودة',in_progress:'قيد التنفيذ',completed:'مكتملة'}; %>
<div class="mb-4"><span class="badge badge-soft mb-2">المتابعة والرقابة</span><h1 class="fw-bold fs-2 mb-2">السجلات والتقارير الطبية</h1><p class="text-secondary mb-0">متابعة حالات الزيارات واعتماد التقارير فقط. التشخيص والعلاج والوصفات والمرفقات لا تظهر في حساب المشرف العام.</p></div>
<div class="alert alert-info rounded-4"><i class="bi bi-shield-lock ms-2"></i>المعلومات الطبية التفصيلية متاحة للأطراف الطبية المخوّلة فقط. لا يمكن للمشرف تعديل أو إبطال تقرير طبي من هذه الصفحة.</div>
<div class="filter-panel mb-4"><form method="get" action="/admin/medical-records" class="row g-3 align-items-end">
<div class="col-md-4 col-lg-3"><label for="mrSearch" class="form-label">رقم الزيارة</label><input id="mrSearch" name="q" class="form-control" type="search" inputmode="numeric" pattern="[0-9]+" maxlength="18" placeholder="مثال: 17" value="<%= f.q %>"></div>
<div class="col-md-4 col-lg-3"><label for="mrClinic" class="form-label">العيادة</label><select id="mrClinic" name="clinic" class="form-select"><option value="">جميع العيادات</option><% clinics.forEach(c=>{ %><option value="<%= c.id %>" <%= f.clinic===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></div>
<div class="col-md-4 col-lg-2"><label for="mrState" class="form-label">حالة التقرير</label><select id="mrState" name="state" class="form-select"><option value="">الكل</option><option value="approved" <%= f.state==='approved'?'selected':'' %>>معتمد</option><option value="awaiting" <%= f.state==='awaiting'?'selected':'' %>>غير معتمد</option></select></div>
<div class="col-6 col-lg-2"><label for="mrFrom" class="form-label">من تاريخ</label><input id="mrFrom" name="from" type="date" class="form-control" value="<%= f.from %>"></div>
<div class="col-6 col-lg-2"><label for="mrTo" class="form-label">إلى تاريخ</label><input id="mrTo" name="to" type="date" class="form-control" value="<%= f.to %>"></div>
<div class="col-12 d-flex flex-wrap gap-2"><button class="btn btn-primary" type="submit"><i class="bi bi-search ms-1"></i>بحث</button><a href="/admin/medical-records" class="btn btn-outline-secondary">مسح الفلاتر</a></div>
</form></div>
<section class="soft-card p-3 p-lg-4"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h2 class="h5 fw-bold mb-0">سجل حالات الزيارات</h2><span class="badge badge-soft"><%= total %> <%= sdcT("زيارة") %></span></div>
<div class="table-responsive mobile-stack-wrapper table-ui-shell"><table class="table align-middle mb-0 responsive-stack-table system-data-table"><thead><tr><th>الزيارة</th><th>العيادة</th><th>الطبيب</th><th>تاريخ الموعد</th><th>الزيارة</th><th>التقرير</th><th>الإجراء</th></tr></thead><tbody>
<% if(!rows.length){ %><tr><td colspan="7" class="text-center text-secondary py-5">لا توجد سجلات مطابقة للفلاتر الحالية.</td></tr><% } %>
<% rows.forEach(v=>{ %><tr><td data-label="الزيارة" class="table-primary-cell">#<%= v.id %></td><td data-label="العيادة"><%= v.clinic_name %></td><td data-label="الطبيب"><%= v.doctor_name %></td><td data-label="التاريخ"><span dir="ltr"><%= v.appointment_date %></span></td><td data-label="الحالة"><%= visitNames[v.visit_status]||v.visit_status %></td><td data-label="التقرير"><span class="badge <%= v.report_approved?'text-bg-success':'text-bg-secondary' %>"><%= v.report_approved?'معتمد':'غير معتمد' %></span></td><td data-label="التفاصيل"><a class="btn btn-sm btn-outline-primary" href="/admin/medical-record-details?id=<%= v.id %>">عرض الحالة</a></td></tr><% }); %>
</tbody></table></div>
<% if(pages>1){ %><nav aria-label="صفحات السجلات" class="mt-3"><ul class="pagination justify-content-center flex-wrap gap-2"><% if(page>1){qs.set('page',String(page-1));%><li class="page-item"><a class="page-link" href="/admin/medical-records?<%= qs.toString() %>">السابق</a></li><% } %><li class="page-item disabled"><span class="page-link"><%= page %> <%= sdcT("من") %> <%= pages %></span></li><% if(page<pages){qs.set('page',String(page+1));%><li class="page-item"><a class="page-link" href="/admin/medical-records?<%= qs.toString() %>">التالي</a></li><% } %></ul></nav><% } %>
</section></section></main><script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script><script src="assets/app.js"></script><%- include('../partials/admin/footer') %><script defer src="/assets/i18n.js"></script>
  </body></html>
