<!DOCTYPE html>
<html lang="<%= typeof lang === 'string' && lang === 'en' ? 'en' : 'ar' %>" dir="<%= typeof lang === 'string' && lang === 'en' ? 'ltr' : 'rtl' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>تفاصيل الحجز | Smart Dental Clinic</title>
<!-- Bootstrap fallback retained for all layouts. -->
<link rel="stylesheet" href="/assets/vendor/937abe4f713b-bootstrap.rtl.min.css"><% if (typeof lang === "string" && lang === "en") { %><link rel="stylesheet" href="/assets/vendor/bootstrap.ltr.min.css"><% } %><link rel="stylesheet" href="../assets/vendor/28667e4f82c7-bootstrap-icons.css"><link rel="stylesheet" href="assets/styles.css"><link rel="stylesheet" href="../assets/vendor/8c34d74036e9-css2-fonts.css">
<link rel="stylesheet" href="/assets/i18n.css">
  </head><body class="admin-workspace"><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a><%- include('../partials/admin/header') %>
<main class="page-shell" id="main-content"><section class="container py-4 py-lg-5">
<nav class="admin-crumbs" aria-label="مسار الصفحة"><a href="/admin/index"><i class="bi bi-house-door ms-1"></i>الرئيسية</a><i class="bi bi-chevron-left" aria-hidden="true"></i><span class="admin-crumb-current">تفاصيل الحجز</span></nav>
<% const b=typeof appointment!=='undefined'?appointment:null;const visit=typeof appointmentVisit!=='undefined'?appointmentVisit:null;const logs=typeof appointmentAudit!=='undefined'?appointmentAudit:[];const notice=typeof appointmentNotice!=='undefined'?appointmentNotice:'';const statuses={pending:'بانتظار الموافقة',confirmed:'مؤكد',in_progress:'قيد التنفيذ',completed:'مكتمل',cancelled:'ملغى',rejected:'مرفوض',no_show:'لم يحضر'};const colors={confirmed:'text-bg-primary',completed:'text-bg-success',in_progress:'text-bg-info',pending:'text-bg-warning',cancelled:'text-bg-secondary',rejected:'text-bg-danger',no_show:'text-bg-secondary'}; %>
<nav aria-label="مسار التنقل" class="mb-3"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/admin/appointments">المواعيد والحجوزات</a></li><li class="breadcrumb-item active" aria-current="page"><%= sdcT("تفاصيل") %> <%= b?'#'+b.id:'الحجز' %></li></ol></nav>
<% if(b){ %><div class="d-flex flex-wrap justify-content-between gap-3 mb-4 align-items-start"><div><span class="badge badge-soft mb-2">متابعة وإدارة إدارية موثّقة</span><h1 class="fw-bold fs-2 mb-2"><%= sdcT("الحجز #") %><%= b.id %></h1><p class="text-secondary mb-0">البيانات من قاعدة PostgreSQL. يمكن للمشرف إجراء التغييرات التشغيلية المسموحة من هنا عبر نفس قواعد حالة الحجز والتوافر المستخدمة لدى العيادة.</p></div><span class="badge fs-6 <%= colors[b.status]||'text-bg-secondary' %>"><%= statuses[b.status]||b.status %></span></div>
<% if(notice){ %><div class="alert <%= ['noted','updated','ok'].includes(notice)?'alert-success':'alert-warning' %> rounded-4" role="status"><%= notice==='ok'?'تم تنفيذ الإجراء الإداري وتوثيقه.':notice==='closed'?'هذا الحجز مغلق ولا يمكن تعديله.':notice==='in_use'?'توجد سجلات مرتبطة تمنع حذف الحجز.':notice==='unavailable'?'الوقت الجديد غير متاح.':notice==='noted'?'تم توثيق الملاحظة في سجل النظام دون أي تغيير في الحجز.':notice==='updated'?'تم تحديث الملاحظة الإدارية وتوثيق التعديل.':notice==='unchanged'?'لم تتغير الملاحظة الإدارية.':notice==='invalid'?'تحقق من النص وسبب الإجراء (8 أحرف على الأقل).':'تعذّر إتمام الإجراء. لم تتغير بيانات الحجز.' %></div><% } %>
<div class="row g-4 mb-4"><div class="col-lg-7"><div class="soft-card p-4 h-100"><h2 class="h5 fw-bold mb-3">البيانات الأساسية</h2><dl class="row g-3 mb-0">
<dt class="col-sm-4 text-secondary">المريض</dt><dd class="col-sm-8"><a href="/admin/user-details?id=<%= b.patient_user_id %>"><%= b.patient_name %></a></dd>
<dt class="col-sm-4 text-secondary">العيادة</dt><dd class="col-sm-8"><a href="/admin/clinic-details?id=<%= b.clinic_id %>"><%= b.clinic_name %></a></dd>
<dt class="col-sm-4 text-secondary">الطبيب</dt><dd class="col-sm-8"><a href="/admin/doctor-details?id=<%= b.doctor_id %>"><%= sdcT("د.") %> <%= b.doctor_name %></a></dd>
<dt class="col-sm-4 text-secondary">الخدمة</dt><dd class="col-sm-8"><%= b.service_name %></dd>
<dt class="col-sm-4 text-secondary">التاريخ والوقت</dt><dd class="col-sm-8"><span dir="ltr" class="d-inline-block"><%= b.appointment_date %> — <%= b.appointment_time %></span></dd>
<dt class="col-sm-4 text-secondary">المدة</dt><dd class="col-sm-8"><%= b.duration_minutes %> <%= sdcT("دقيقة") %></dd>
<dt class="col-sm-4 text-secondary">مصدر الحجز</dt><dd class="col-sm-8"><%= b.source==='ai'?'التشخيص الذكي':'حجز عادي' %></dd>
<dt class="col-sm-4 text-secondary">السعر عند الحجز</dt><dd class="col-sm-8"><%= b.price %></dd></dl></div></div>
<div class="col-lg-5"><div class="soft-card p-4 h-100"><h2 class="h5 fw-bold mb-3">بيانات المتابعة</h2><dl class="row g-3 mb-0"><dt class="col-sm-5 text-secondary">أُنشئ في</dt><dd class="col-sm-7"><%= b.created_at?new Date(b.created_at).toLocaleString('ar-PS'):'—' %></dd><dt class="col-sm-5 text-secondary">معرّف منشئ الحجز</dt><dd class="col-sm-7"><%= b.created_by_user_id %></dd><dt class="col-sm-5 text-secondary">الزيارة المرتبطة</dt><dd class="col-sm-7"><%= visit?'#'+visit.id:'لا توجد زيارة' %></dd><dt class="col-sm-5 text-secondary">حالة الزيارة</dt><dd class="col-sm-7"><%= visit?visit.status:'—' %></dd><dt class="col-sm-5 text-secondary">اعتماد التقرير</dt><dd class="col-sm-7"><%= visit&&visit.report_approved_at?'معتمد':'غير معتمد' %></dd></dl></div></div></div>
<% if(b.request_status){ %><section class="soft-card p-4 mb-4"><h2 class="h5 fw-bold mb-2">طلب تغيير الموعد</h2><p class="text-secondary small">يمكن للمشرف مراجعة طلب التغيير ضمن الإجراءات الإدارية المسموحة وبنفس شروط تأكيد العيادة.</p><div class="row g-3"><div class="col-md-6"><div class="rounded-3 border p-3 h-100"><strong class="d-block mb-2">الموعد الحالي</strong><span dir="ltr" class="d-inline-block"><%= b.appointment_date %> — <%= b.appointment_time %></span></div></div><div class="col-md-6"><div class="rounded-3 border p-3 h-100"><strong class="d-block mb-2">الموعد المطلوب</strong><span dir="ltr" class="d-inline-block"><%= b.requested_date %> — <%= b.requested_time %></span></div></div></div><p class="mt-3 mb-1">حالة الطلب: <strong><%= b.request_status==='pending'?'بانتظار القرار':b.request_status==='approved'?'تمت الموافقة':'مرفوض' %></strong></p><p class="text-secondary mb-0"><%= b.request_reason||'لم يُذكر سبب' %></p></section><% } %>
<div class="alert alert-light border border-danger-subtle" id="adminDeleteDecision"><strong>الحذف الآمن:</strong> لا يمكن حذف الحجوزات المكتملة أو المرتبطة بزيارة أو فاتورة أو عمولة. للحجوزات المفتوحة استخدم الإلغاء بدل الحذف؛ حذف الحجز المعلق متاح فقط إن كان غير منفّذ وغير مرتبط.</div>
<% if(['pending','confirmed'].includes(b.status) && !visit){ %>
<section class="soft-card p-4 mb-4" id="adminAppointmentActions" aria-label="إجراءات الحجز">
 <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3"><div><h2 class="h5 fw-bold mb-1">إدارة الحجز</h2><p class="text-secondary small mb-0">تأكيد أو رفض أو تعديل الوقت أو إلغاء، مع سبب إلزامي؛ لا يتم تغيير السعر المثبت أو تاريخ الحجوزات القديمة.</p></div><span class="badge text-bg-light border">إجراء مشرف عام</span></div>
 <form method="post" action="/admin/clinics/<%= b.clinic_id %>/bookings/action" class="row g-3">
  <input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>"><input type="hidden" name="booking_id" value="<%= b.id %>"><input type="hidden" name="return_to" value="appointment">
  <div class="col-md-4"><label class="form-label">الإجراء<select class="form-select" name="action" required><% if(b.status==='pending'){ %><option value="confirm">تأكيد</option><option value="reject">رفض</option><% } %><option value="move">تعديل الموعد</option><option value="cancel">إلغاء</option><% if(b.request_status==='pending'){ %><option value="approve_change">قبول طلب التغيير</option><option value="reject_change">رفض طلب التغيير</option><% } %></select></label></div>
  <div class="col-md-4"><label class="form-label">تاريخ جديد (لتعديل الموعد)<input type="date" name="requested_date" class="form-control"></label></div>
  <div class="col-md-4"><label class="form-label">وقت جديد (لتعديل الموعد)<input type="time" name="requested_time" step="1800" class="form-control"></label></div>
  <div class="col-12"><label class="form-label w-100">سبب الإجراء الإداري<input name="reason" class="form-control" minlength="8" maxlength="1000" required></label></div>
  <div class="col-12"><button type="submit" class="btn btn-primary" onclick="return confirm('تأكيد تنفيذ هذا الإجراء على الحجز؟')">تنفيذ الإجراء</button></div>
 </form>
 <% if(b.status==='pending'){ %><details class="admin-record-edit mt-3"><summary class="btn btn-outline-danger btn-sm">حذف الحجز المعلّق غير المرتبط</summary>
 <form action="/admin/clinics/<%= b.clinic_id %>/bookings/delete" method="post" class="row g-2 mt-2" onsubmit="return confirm('تأكيد الحذف النهائي إذا لم توجد سجلات مرتبطة؟')"><input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>"><input type="hidden" name="booking_id" value="<%= b.id %>"><input type="hidden" name="return_to" value="appointment"><div class="col-md-10"><input name="reason" class="form-control" minlength="8" maxlength="1000" required placeholder="السبب الإداري للحذف النهائي"></div><div class="col-md-2"><button class="btn btn-outline-danger w-100">حذف</button></div></form></details><% } %>
</section><% } %>
<section class="soft-card p-4 mb-4" aria-label="تعديل الملاحظات الإدارية للحجز">
 <h2 class="h5 fw-bold mb-2">تعديل الملاحظة الإدارية</h2>
 <p class="text-secondary small">يُسمح بتصحيح حقل الملاحظات الإدارية فقط. لن يتغير المريض أو الطبيب أو الموعد أو حالة الحجز أو السعر أو الفاتورة.</p>
 <form method="post" action="/admin/appointment-details/<%= b.id %>/update-admin-note">
  <input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>">
  <label for="bookingAdminNote" class="form-label">الملاحظة الإدارية</label>
  <textarea id="bookingAdminNote" name="note" class="form-control mb-3" required maxlength="1200" rows="3"><%= b.administrative_notes||'' %></textarea>
  <label for="bookingAdminEditReason" class="form-label">سبب التعديل</label>
  <textarea id="bookingAdminEditReason" name="reason" minlength="8" maxlength="1000" rows="2" required class="form-control mb-3"></textarea>
  <button type="submit" class="btn btn-outline-primary" onclick="return confirm('تأكيد تحديث الملاحظة الإدارية فقط؟')">حفظ التعديل</button>
 </form>
</section>
<div class="row g-4"><div class="col-lg-6"><section class="soft-card p-4 h-100"><h2 class="h5 fw-bold mb-3">سجل العمليات والملاحظات</h2><% if(!logs.length){ %><p class="text-secondary mb-0">لا توجد عمليات مدققة لهذا الحجز حاليًا.</p><% }else{ %><div class="timeline"><% logs.forEach(log=>{ %><div class="timeline-item"><strong><%= log.description||log.action %></strong><div class="small text-secondary"><%= log.actor||'النظام' %> · <%= log.occurred_at?new Date(log.occurred_at).toLocaleString('ar-PS'):'—' %></div><% if(log.reason){ %><p class="mb-1 mt-2"><%= log.reason %></p><% } %></div><% }) %></div><% } %></section></div>
<div class="col-lg-6"><section class="soft-card p-4 h-100"><h2 class="h5 fw-bold mb-2">إضافة ملاحظة رقابية</h2><p class="text-secondary small">تُسجل في Audit Logs فقط، دون تغيير حالة الحجز أو موعده أو بياناته الطبية.</p><form action="/admin/appointment-details/<%= b.id %>/note" method="post"><input type="hidden" name="csrf_token" value="<%= adminCsrfToken %>"><label for="adminAppointmentNote" class="form-label">سبب الملاحظة *</label><textarea id="adminAppointmentNote" name="reason" class="form-control mb-3" rows="5" minlength="8" maxlength="1000" required placeholder="اكتب ملاحظة واضحة للمتابعة الإدارية..."></textarea><button class="btn btn-primary" type="submit"><i class="bi bi-journal-check ms-1"></i> تسجيل الملاحظة</button></form></section></div></div>
<% } else { %><div class="alert alert-info">افتح حجزًا من قائمة المواعيد للاطلاع على التفاصيل.</div><% } %>
</section></main><script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script><script src="assets/app.js"></script><%- include('../partials/admin/footer') %><script defer src="/assets/i18n.js"></script>
  </body></html>
