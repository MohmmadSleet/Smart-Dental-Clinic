<!DOCTYPE html>
<html data-style-sections="section-7" dir="<%= typeof lang === 'string' && lang === 'en' ? 'ltr' : 'rtl' %>" lang="<%= typeof lang === 'string' && lang === 'en' ? 'en' : 'ar' %>"><head>
    <meta charset="utf-8">
    <meta content="width=device-width,initial-scale=1" name="viewport">
    <title>الفواتير والمدفوعات | Smart Dental Clinic</title>
    <!-- Structural fallback: the original Bootstrap stylesheet stays available in both languages. -->
    <link href="/assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <% if (typeof lang === 'string' && lang === 'en') { %><link href="/assets/vendor/bootstrap.ltr.min.css" rel="stylesheet"><% } %>
    <link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
  <link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  <link rel="stylesheet" href="/assets/i18n.css">
  </head>
  <body><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
    <%- include('../partials/clinic/header') %>
    
    <main class="page-shell clinic-invoices-page" id="main-content">
      <section class="container py-4 py-lg-5">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
          <div>
            <span class="badge badge-soft mb-2">Invoices</span>
            <h1 class="fw-bold">الفواتير والمدفوعات</h1>
            <p class="text-secondary mb-0">
              تابع الفواتير والدفعات، أو راجع الزيارات المكتملة لإنشاء مسودة وإصدار فاتورة. كل عملية في تبويب واضح مع الحفاظ على نفس الإجراءات.
            </p>
          </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mb-3">
          <a class="btn btn-primary" href="operations"><i class="bi bi-clipboard2-pulse ms-1" aria-hidden="true"></i>مراجعة الزيارات</a>
          <% if(!financeLoadFailed){ %><a class="btn btn-outline-primary" href="#invoiceDrafts" data-clinic-invoice-open="issue"><i class="bi bi-receipt ms-1" aria-hidden="true"></i>تجهيز فاتورة زيارة</a><% } %>
        </div>
        <% if(financeLoadFailed){ %><div class="alert alert-danger mb-3" role="alert">تعذّر تحميل الفواتير الموجودة مؤقتًا. لم تتغير أي فاتورة أو دفعة. راجع رسالة <code>[CLINIC_INVOICES_LOAD_FAILED]</code> في CMD لمعرفة السبب.</div><% } %><% if(feedback){ %><div class="alert alert-success mb-3"><%= feedback %></div><% } %><% if(error){ %><div class="alert alert-danger mb-3" role="alert"><%= error %></div><% } %><% if(!financeLoadFailed){ %>
        <section class="mb-4" aria-labelledby="clinicInvoiceSummaryTitle">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <h2 class="h5 fw-bold mb-0" id="clinicInvoiceSummaryTitle">الملخص المالي</h2>
            <span class="small text-secondary">جميع المبالغ بالشيكل (₪)</span>
          </div>
          <div class="row g-3">
          <div class="col-md-3">
            <div class="stat-card">
              <small class="text-secondary">إجمالي الفواتير</small>
              <div class="stat-value"><%= finance.stats.count %></div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="stat-card">
              <small class="text-secondary">تم تحصيله</small>
              <div class="stat-value text-success"><%= finance.stats.paid.toFixed(2) %> ₪</div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="stat-card">
              <small class="text-secondary">رصيد مدفوع جزئياً</small>
              <div class="stat-value text-primary"><%= finance.stats.partial.toFixed(2) %> ₪</div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="stat-card">
              <small class="text-secondary">غير مدفوع</small>
              <div class="stat-value text-danger"><%= finance.stats.unpaid %></div>
            </div>
          </div>
          </div>
        </section>
<% } %>
        <% if(!financeLoadFailed){ %>
        <% const invoiceListDefault = finance.items.length > 0 || !invoiceCandidates.length; %>
        <% const invoiceStatesCount = {draft:0,unpaid:0,partial:0,paid:0}; finance.items.forEach(function(i){ if(Object.prototype.hasOwnProperty.call(invoiceStatesCount,i.financialState))invoiceStatesCount[i.financialState]++; }); %>
        <nav class="clinic-invoices-tabs-wrap mb-4" aria-label="أقسام الفواتير">
          <div class="nav nav-pills clinic-invoices-tabs" id="clinicInvoiceTabs" role="tablist">
            <button type="button" class="nav-link <%= invoiceListDefault?'active':'' %>" id="clinic-invoice-tab-list" data-bs-toggle="pill" data-bs-target="#clinic-invoice-pane-list" role="tab" aria-controls="clinic-invoice-pane-list" aria-selected="<%= invoiceListDefault?'true':'false' %>">
              <i class="bi bi-receipt-cutoff ms-1" aria-hidden="true"></i>قائمة الفواتير <span class="clinic-invoice-tab-count"><%= finance.items.length %></span>
            </button>
            <button type="button" class="nav-link <%= !invoiceListDefault?'active':'' %>" id="clinic-invoice-tab-issue" data-bs-toggle="pill" data-bs-target="#clinic-invoice-pane-issue" role="tab" aria-controls="clinic-invoice-pane-issue" aria-selected="<%= !invoiceListDefault?'true':'false' %>">
              <i class="bi bi-file-earmark-plus ms-1" aria-hidden="true"></i>مراجعة وإصدار <span class="clinic-invoice-tab-count"><%= invoiceCandidatesFailed?'!':invoiceCandidates.length %></span>
            </button>
          </div>
        </nav>
        <div class="tab-content clinic-invoices-tab-content" id="clinicInvoiceTabContent">
          <div class="tab-pane fade <%= invoiceListDefault?'show active':'' %>" id="clinic-invoice-pane-list" role="tabpanel" aria-labelledby="clinic-invoice-tab-list" tabindex="0">
            <section class="soft-card p-3 p-lg-4 mb-4" aria-labelledby="clinicInvoiceListTitle">
              <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
                <div><h2 class="h5 fw-bold mb-1" id="clinicInvoiceListTitle">قائمة الفواتير</h2><p class="small text-secondary mb-0">ابحث عن فاتورة، ثم افتح تفاصيلها لعرض البنود والدفعات والإجراءات المتاحة.</p></div>
                <a href="#invoiceDrafts" data-clinic-invoice-open="issue" class="btn btn-outline-primary btn-sm align-self-start"><i class="bi bi-plus-circle ms-1" aria-hidden="true"></i>إعداد مسودة</a>
              </div>
              <div class="clinic-invoice-shortcuts mb-3" role="group" aria-label="تصفية سريعة لحالات الفواتير">
                <button type="button" class="clinic-invoice-shortcut" data-invoice-preset="draft" aria-pressed="false">مسودات <strong><%= invoiceStatesCount.draft %></strong></button>
                <button type="button" class="clinic-invoice-shortcut" data-invoice-preset="unpaid" aria-pressed="false">غير مدفوعة <strong><%= invoiceStatesCount.unpaid %></strong></button>
                <button type="button" class="clinic-invoice-shortcut" data-invoice-preset="partial" aria-pressed="false">مدفوعة جزئياً <strong><%= invoiceStatesCount.partial %></strong></button>
                <button type="button" class="clinic-invoice-shortcut" data-invoice-preset="paid" aria-pressed="false">مدفوعة <strong><%= invoiceStatesCount.paid %></strong></button>
              </div>
        <% if(!financeLoadFailed){ %>
        <div class="filter-panel mb-3">
          <div class="row g-3 align-items-end">
            <div class="col-md-8">
              <label class="form-label small fw-bold" for="invoiceSearch">بحث عن فاتورة</label>
              <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span><input class="form-control" id="invoiceSearch" placeholder="رقم الفاتورة، اسم المريض أو الخدمة" value="" name="invoice_search">
              </div>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold" for="invoiceStatusFilter">الحالة</label><select class="form-select" id="invoiceStatusFilter" name="invoice_status_filter">
                <option value="all" selected>كل الحالات</option>
                <option value="draft">مسودة</option><option value="unpaid">غير مدفوعة</option>
                <option value="partial">مدفوعة جزئياً</option>
                <option value="paid">مدفوعة</option>
              </select>
            </div>
          </div>
          <div class="d-flex justify-content-end mt-3"><button type="button" class="btn btn-light btn-sm border" id="invoiceResetFilters"><i class="bi bi-arrow-counterclockwise ms-1" aria-hidden="true"></i>إعادة ضبط</button></div>
        </div>
        <div class="small text-secondary mb-3" id="invoiceResultCount" role="status" aria-live="polite"><%= finance.items.length %> <%= sdcT("فاتورة") %></div>
        <div class="empty-state d-none mb-3" id="invoiceEmptyState">
          <i class="bi bi-receipt-cutoff fs-1"></i>
          <h5 class="fw-bold mt-3">لا توجد فاتورة مطابقة</h5>
        </div>
        <div class="accordion invoice-accordion" id="invoiceAccordion">
<% finance.items.forEach(function(i,idx){ const state=i.financialState; const badge=state==='paid'?'text-bg-success':state==='partial'?'text-bg-primary':state==='unpaid'?'text-bg-warning':'text-bg-secondary'; const label=state==='paid'?'مدفوعة':state==='partial'?'مدفوعة جزئياً':state==='unpaid'?'غير مدفوعة':state==='draft'?'مسودة':'ملغاة'; %>
 <div class="accordion-item invoice-filter-item" data-search="IN-<%= i.id %> <%= i.patient %> <%= i.service %>" data-status="<%= state %>">
  <h2 class="accordion-header"><button class="accordion-button <%= idx?'collapsed':'' %>" data-bs-target="#invoice<%= i.id %>" data-bs-toggle="collapse" type="button"><div class="w-100 d-flex flex-column flex-md-row justify-content-between gap-2 align-items-md-center"><div><strong>IN-<%= i.id %></strong> — <%= i.patient %></div><div class="small text-secondary"><%= i.service %> • <%= i.total.toFixed(2) %> ₪ • <span class="badge <%= badge %>"><%= label %></span></div></div></button></h2>
  <div class="accordion-collapse collapse <%= idx===0?'show':'' %>" data-bs-parent="#invoiceAccordion" id="invoice<%= i.id %>"><div class="accordion-body">
   <div class="table-responsive mb-4 mobile-stack-wrapper table-ui-shell"><table class="table invoice-items-table mb-0 responsive-stack-table system-data-table"><thead class="table-light"><tr><th>الخدمة</th><th>الطبيب</th><th>القيمة</th></tr></thead><tbody>
   <% i.lines.forEach(function(l){ %><tr><td data-label="الخدمة" class="table-primary-cell"><%= l.description %></td><td data-label="الطبيب"><%= i.doctor %></td><td data-label="القيمة"><%= (Number(l.qty)*Number(l.unit_price)-Number(l.discount)).toFixed(2) %> ₪</td></tr><% }); %></tbody></table></div>
   <div class="row g-4"><div class="col-lg-4"><div class="invoice-summary"><div class="d-flex justify-content-between py-2"><span>الإجمالي</span><strong><%= i.total.toFixed(2) %> ₪</strong></div><div class="d-flex justify-content-between py-2"><span>المدفوع</span><strong><%= i.paid.toFixed(2) %> ₪</strong></div><hr><div class="d-flex justify-content-between py-2 text-danger fs-5 fw-bold"><span>المتبقي</span><span><%= i.remaining.toFixed(2) %> ₪</span></div></div></div>
   <div class="col-lg-8"><h6 class="fw-bold mb-3">الدفعات المسجلة</h6><div class="empty-state py-4 mb-3"><% if(!i.payments.length){ %><div class="small">لا توجد دفعات بعد</div><% }else{i.payments.forEach(function(pay){ %><div class="small mb-1"><%= pay.at %> — <%= pay.amount %> ₪ — <%= ({cash:'نقداً',card:'بطاقة',bank_transfer:'تحويل'})[pay.method]||pay.method %> — <%= pay.actor %></div><% });} %></div><div class="d-flex flex-wrap gap-2"><button class="btn btn-primary btn-sm" data-bs-target="#paymentModal" data-bs-toggle="modal" type="button" data-invoice-id="<%= i.id %>" data-invoice-remaining="<%= i.remaining.toFixed(2) %>" <%= state==='draft'||state==='void'||i.remaining<=0?'disabled':'' %>>إضافة دفعة</button><button class="btn btn-outline-primary btn-sm" data-ui-print="" <%= state==='draft'?'disabled title="المسودة غير مُصدرة"':'' %>>طباعة الفاتورة</button><% if(state==='draft'){ %>
   <form method="post" action="/clinic/invoices/issue" class="d-flex flex-wrap align-items-center gap-2">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="invoice_id" value="<%= i.id %>">
    <label class="small d-flex align-items-center gap-1"><input type="checkbox" class="form-check-input" name="service_delivered" required>أؤكد مطابقة بنود الفاتورة للإجراءات المنفذة والمثبتة</label>
    <button type="submit" class="btn btn-success btn-sm">اعتماد وإصدار الفاتورة</button>
   </form><% } %></div></div></div>
  </div></div>
 </div><% }); %><% if(!finance.items.length){ %><div class="empty-state py-4 text-center">لا توجد فواتير مسجلة لهذه العيادة.</div><% } %>
</div>
        <% } %>
            </section>
          </div>
          <div class="tab-pane fade <%= !invoiceListDefault?'show active':'' %>" id="clinic-invoice-pane-issue" role="tabpanel" aria-labelledby="clinic-invoice-tab-issue" tabindex="0">
        <% if(!financeLoadFailed){ %>
        <section class="soft-card p-3 p-lg-4 mb-4" id="invoiceDrafts" aria-label="مسودات الفواتير للزيارات المكتملة">
          <div class="d-flex flex-column flex-md-row justify-content-between gap-2 mb-3">
            <div><h2 class="fw-bold fs-5 mb-1">مراجعة وإصدار فواتير الزيارات المكتملة</h2>
              <p class="small text-secondary mb-0">ابدأ بسعر الخدمة المحجوزة، ثم اختر يدويًا الإجراءات الإضافية المنفذة وغير المشمولة فقط. لا يُضاف أي إجراء تلقائيًا.</p>
            </div><span class="badge badge-soft align-self-start"><%= invoiceCandidatesFailed ? "تعذر التحميل" : invoiceCandidates.length+" زيارة متاحة" %></span>
          </div>
          <% if(invoiceCandidatesFailed){ %><div class="alert alert-warning small" role="alert">تعذّر تحميل الزيارات المكتملة المؤهلة لإصدار الفواتير. الفواتير الموجودة ما زالت متاحة، لكن إنشاء مسودة جديدة غير متاح حاليًا. راجع رسالة <code>[CLINIC_INVOICES_LOAD_FAILED]</code> في CMD.</div><% } else if(!invoiceCandidates.length){ %><div class="small text-secondary">لا توجد زيارات مكتملة بلا فاتورة، أو مسودات بانتظار المراجعة.</div><% } %>
          <div class="clinic-invoice-guidance mb-3" aria-label="مراحل تجهيز الفاتورة">
            <span><i class="bi bi-1-circle ms-1" aria-hidden="true"></i>مراجعة بنود الزيارة</span>
            <span><i class="bi bi-2-circle ms-1" aria-hidden="true"></i>حفظ المسودة</span>
            <span><i class="bi bi-3-circle ms-1" aria-hidden="true"></i>إصدارها من قائمة الفواتير</span>
          </div>
          <div class="accordion" id="invoiceReviewAccordion">
          <% invoiceCandidates.forEach(function(v,idx){ %>
            <div class="accordion-item" id="invoice-editor-<%= v.id %>">
              <h3 class="accordion-header"><button class="accordion-button <%= idx ? 'collapsed' : '' %>" type="button" data-bs-toggle="collapse" data-bs-target="#reviewVisit<%= v.id %>" aria-expanded="<%= !idx %>">
                <span class="d-flex flex-column gap-1"><strong><%= sdcT("زيارة #") %><%= v.id %> — <%= v.patient %></strong><small class="text-secondary"><%= v.service_name %> • <%= v.day %> • <%= v.base_price %> ₪ <% if(v.invoice_id){ %>• مسودة IN-<%= v.invoice_id %><% } %></small></span>
              </button></h3>
              <div id="reviewVisit<%= v.id %>" class="accordion-collapse collapse <%= idx===0?'show':'' %>" data-bs-parent="#invoiceReviewAccordion">
                <div class="accordion-body">
                  <form action="/clinic/invoices/draft" method="post" class="invoice-draft-form">
                    <input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="visit_id" value="<%= v.id %>">
                    <div class="alert <%= v.base_performed?'alert-light':'alert-warning' %> border py-2 small mb-3">السعر المثبّت وقت الحجز: <strong><%= Number(v.base_price).toFixed(2) %> ₪</strong> — <%= v.service_name %>. <% if(v.base_performed){ %>الخدمة الأصلية موثقة كإجراء مكتمل وتُحتسب مرة واحدة.<% } else { %>لم يُسجّل إجراء مكتمل للخدمة المحجوزة؛ لن تُضاف قيمتها للفاتورة. اختر الإجراءات البديلة المنفذة بالفعل، أو أكمل التوثيق السريري أولًا.<% } %></div>
                    <label class="form-label fw-bold">الإجراءات الإضافية المنفذة (اختر فقط غير المشمول بسعر الحجز)</label>
                    <% if(!v.procedures.length){ %><p class="small text-secondary">لا توجد إجراءات إضافية منفذة مؤهلة للفوترة.</p><% } %>
                    <% v.procedures.forEach(function(p){ %>
                      <label class="d-flex align-items-start gap-2 border rounded-3 p-2 mb-2">
                        <input type="checkbox" class="form-check-input mt-1" name="extra_ids" value="<%= p.id %>" <%= p.selected?'checked':'' %> >
                        <span class="flex-grow-1"><strong><%= p.name %></strong><small class="d-block text-secondary">إجراء #<%= p.id %> • كمية <%= p.qty %> • سعر الوحدة المثبّت <%= Number(p.price).toFixed(2) %> ₪ • الإجمالي <%= (Number(p.qty)*Number(p.price)).toFixed(2) %> ₪</small></span>
                      </label>
                    <% }); %>
                    <div class="row g-3 align-items-end mt-2">
                      <div class="col-md-4"><label class="form-label" for="draftDiscount<%= v.id %>">إجمالي الخصم (₪)</label>
                        <input class="form-control" type="number" id="draftDiscount<%= v.id %>" name="discount" step="0.01" min="0" max="9999999999.99" value="<%= v.discount %>" required></div>
                      <div class="col-md-8"><p class="small text-secondary mb-2">راجع البنود والخصم أولًا، ثم احفظ المسودة. إصدار الفاتورة خطوة منفصلة من تبويب قائمة الفواتير.</p>
                        <button class="btn btn-primary" type="submit"><%= v.invoice_id?'تحديث مسودة الفاتورة':'حفظ مسودة الفاتورة' %></button></div>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          <% }); %>
          </div>
        </section>
        <% } %>
          </div>
        </div>
        <% } %>
      </section>
      <div class="modal fade" id="paymentModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/clinic/invoices/payment"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" id="paymentInvoiceId" name="invoice_id"><div class="modal-header"><h5 class="fw-bold mb-0">إضافة دفعة</h5><button class="btn-close" data-bs-dismiss="modal" type="button"></button></div><div class="modal-body"><label class="form-label" for="paymentAmount">المبلغ</label><input class="form-control mb-3" id="paymentAmount" name="amount" inputmode="decimal" type="number" step="0.01" min="0.01" required><label class="form-label" for="paymentMethod">طريقة الدفع</label><select class="form-select" id="paymentMethod" name="method"><option value="cash">نقداً</option><option value="card">بطاقة</option><option value="bank_transfer">تحويل</option></select></div><div class="modal-footer"><button class="btn btn-light" data-bs-dismiss="modal" type="button">إلغاء</button><button class="btn btn-primary" type="submit">حفظ الدفعة</button></div></form></div></div>
    </main>
    <%- include('../partials/clinic/footer') %>
    <div class="toast-container position-fixed bottom-0 start-0 p-3">
      <div class="toast align-items-center text-bg-primary border-0" id="appToast">
        <div class="d-flex">
          <div class="toast-body">تمت العملية</div>
          <button class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" type="button"></button>
        </div>
      </div>
    </div>
    <script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
  <!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="assets/app.js"></script>




<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button><div class="toast-container position-fixed bottom-0 start-0 p-3"><div id="backendPendingNotice" class="toast align-items-center text-bg-secondary border-0" role="status" aria-live="polite"><div class="d-flex"><div class="toast-body">هذه العملية بانتظار ربط الباك إند. لم تُحفظ أو تتغيّر أي بيانات.</div><button type="button" class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" aria-label="إغلاق"></button></div></div></div><form id="backend-form-3" method="get" data-ui-unbound="" data-backend-binding="filter" hidden=""></form><form id="backend-form-4" method="post" data-ui-unbound="" data-backend-binding="modal" hidden=""></form><script defer src="/assets/i18n.js"></script>
  </body></html>