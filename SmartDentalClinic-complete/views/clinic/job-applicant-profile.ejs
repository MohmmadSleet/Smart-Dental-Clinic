<!DOCTYPE html><html lang="<%= typeof lang === 'string' && lang === 'en' ? 'en' : 'ar' %>" dir="<%= typeof lang === 'string' && lang === 'en' ? 'ltr' : 'rtl' %>"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>الملف المهني للمتقدم | Smart Dental Clinic</title><!-- Structural fallback: the original Bootstrap stylesheet stays available in both languages. -->
    <link href="/assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <% if (typeof lang === 'string' && lang === 'en') { %><link href="/assets/vendor/bootstrap.ltr.min.css" rel="stylesheet"><% } %><link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet"><link rel="stylesheet" href="assets/styles.css"><link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet"><link rel="stylesheet" href="/assets/i18n.css">
  </head><body><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a><%- include('../partials/clinic/header') %><main class="page-shell" id="main-content"><section class="container py-4 py-lg-5"><nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/clinic/job-applicants">المتقدمون</a></li><li class="breadcrumb-item"><a href="/clinic/application-details?id=<%= application.Application_ID %>"><%= sdcT("طلب JA-") %><%= application.Application_ID %></a></li><li class="breadcrumb-item active">الملف المهني</li></ol></nav><div class="mb-4"><h1 class="fw-bold"><%= sdcT("الملف المهني:") %> <%= application.Full_Name %></h1><p class="text-secondary">هذه بيانات الطبيب المسجلة وقت التقديم للوظيفة J-<%= application.Job_ID %>، وليست صفحة إدارة الطبيب أو جدوله في العيادة.</p></div><div class="soft-card p-4 mb-4"><div class="row g-4"><% const fields=[['اسم الطبيب',application.Full_Name],['التخصص',application.Specialty_Name],['حالة الترخيص',application.License_Status==='verified'?'موثق':application.License_Status==='pending'?'قيد المراجعة':'غير موثق'],['رقم الترخيص',application.License_Number],['سنوات الخبرة',application.Years_Of_Experience===null?'غير محددة':application.Years_Of_Experience+' سنوات'],['مدينة السكن',application.Residence_City],['البريد الإلكتروني المقدم مع الطلب',application.Email],['رقم الهاتف المقدم مع الطلب',application.Phone],['الراتب المتوقع',application.Expected_Salary===null?'غير محدد':Number(application.Expected_Salary).toFixed(2)+' ₪']];for(const field of fields){ %><div class="col-md-6"><small class="text-secondary"><%= field[0] %></small><div class="fw-bold"><%= field[1]||'غير محدد' %></div></div><% } %></div></div><div class="soft-card p-4"><h4 class="fw-bold mb-3">المرفقات المهنية</h4><% if(!attachments.length){ %><p class="text-secondary">لا توجد مرفقات مع الطلب.</p><% } %><div class="d-flex flex-wrap gap-2"><% for(const a of attachments){ %><a class="btn btn-outline-primary" href="/clinic/application-details/<%= application.Application_ID %>/attachment/<%= a.Attachment_ID %>"><i class="bi bi-file-earmark-arrow-down ms-1"></i><%= a.File_Name %></a><% } %></div></div><div class="mt-4"><a class="btn btn-outline-secondary" href="/clinic/application-details?id=<%= application.Application_ID %>">العودة إلى الطلب</a></div></section></main><%- include('../partials/clinic/footer') %><script defer src="/assets/i18n.js"></script>
  </body></html>