<!DOCTYPE html>
<html dir="rtl" lang="ar"><head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <title>لوحة الطبيب | Smart Dental Doctor</title>
    <link href="../assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
    <link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">
    
      
  </head>
  <body class="bg-light"><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
    <!-- شريط التنقل العلوي -->
    <%- include('../partials/doctor/header') %>

    <!-- القائمة الجانبية (Offcanvas) للأقسام -->
    

    <!-- المحتوى الرئيسي -->
    <main class="page-shell py-4" id="main-content">
      <section class="container">
        
        <!-- الترويسة الترحيبية -->
        <div class="hero-doctor mb-4 p-4 p-lg-5 bg-primary text-white rounded-4 shadow-sm position-relative overflow-hidden">
          <div class="row align-items-center g-4 position-relative z-1">
            <div class="col-lg-8">
              <span class="badge bg-white text-primary mb-3 px-3 py-2 rounded-pill fw-bold">Doctor Dashboard</span>
              <h1 class="fw-bold mb-2 fs-2">أهلاً د. عمر ناصر</h1>
              <p class="mb-4 opacity-90 fs-6">
                اليوم لديك موعد واحد مكتمل في عيادة الابتسامة الحديثة. يمكنك مراجعة الزيارة والتقرير المرتبطين به.
              </p>
              <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-light text-primary fw-bold px-4 py-2 shadow-sm" href="visit">
                  <i class="bi bi-play-circle-fill ms-1"></i>عرض زيارة أحمد خالد
                </a>
                <a class="btn btn-outline-light px-4 py-2" href="appointments">
                  عرض مواعيدي
                </a>
              </div>
            </div>
            <div class="col-lg-4">
              <div class="bg-white bg-opacity-10 backdrop-blur rounded-4 p-4 border border-white border-opacity-20 shadow-sm">
                <div class="small opacity-75 mb-1">آخر موعد</div>
                <h4 class="fw-bold mb-1">أحمد خالد</h4>
                <div class="text-white-55 small mb-3">علاج جذور • 11:30 ص</div>
                <div class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-semibold w-100 text-center">
                  <i class="bi bi-check-circle-fill ms-1"></i>الزيارة مكتملة
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- بطاقات المؤشرات الإحصائية -->
        <div class="row g-3 mb-4">
          <div class="col-6 col-lg-3">
            <div class="metric-card card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
              <div class="metric-icon text-primary bg-primary-subtle rounded-3 p-2 d-inline-flex mb-3 fs-4" style="width: 45px; height: 45px; align-items: center; justify-content: center;">
                <i class="bi bi-calendar2-check"></i>
              </div>
              <div class="metric-value fw-bold fs-3 text-dark">1</div>
              <div class="text-secondary small">مواعيد اليوم</div>
            </div>
          </div>
          <div class="col-6 col-lg-3">
            <div class="metric-card card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
              <div class="metric-icon text-success bg-success-subtle rounded-3 p-2 d-inline-flex mb-3 fs-4" style="width: 45px; height: 45px; align-items: center; justify-content: center;">
                <i class="bi bi-check2-circle"></i>
              </div>
              <div class="metric-value fw-bold fs-3 text-dark">1</div>
              <div class="text-secondary small">زيارات مكتملة</div>
            </div>
          </div>
          <div class="col-6 col-lg-3">
            <div class="metric-card card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
              <div class="metric-icon text-warning bg-warning-subtle rounded-3 p-2 d-inline-flex mb-3 fs-4" style="width: 45px; height: 45px; align-items: center; justify-content: center;">
                <i class="bi bi-file-earmark-medical"></i>
              </div>
              <div class="metric-value fw-bold fs-3 text-dark">0</div>
              <div class="text-secondary small">تقرير يحتاج اعتماد</div>
            </div>
          </div>
          <div class="col-6 col-lg-3">
            <div class="metric-card card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
              <div class="metric-icon text-info bg-info-subtle rounded-3 p-2 d-inline-flex mb-3 fs-4" style="width: 45px; height: 45px; align-items: center; justify-content: center;">
                <i class="bi bi-arrow-repeat"></i>
              </div>
              <div class="metric-value fw-bold fs-3 text-dark">1</div>
              <div class="text-secondary small">متابعات مقترحة</div>
            </div>
          </div>
        </div>

        <!-- قسم المواعيد والمهام العاجلة -->
        <div class="row g-4">
          <!-- مواعيد اليوم -->
          <div class="col-xl-8">
            <div class="soft-card card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
              <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                  <h4 class="fw-bold mb-1 text-dark fs-5">مواعيدي اليوم</h4>
                  <div class="small text-secondary">الأربعاء، 21 أكتوبر 2026</div>
                </div>
                <a class="btn btn-sm btn-outline-primary px-3" href="appointments">كل المواعيد</a>
              </div>
              <div class="d-grid gap-3">
                
                <!-- موعد 1 -->
                <div class="appointment-row p-3 rounded-3 border bg-light d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-center">
                  <div class="d-flex gap-3 align-items-center">
                    <div class="timeline-time bg-primary text-white px-3 py-2 rounded-3 fw-bold small text-center" style="min-width: 70px;">10:00 ص</div>
                    <div>
                      <strong class="text-dark d-block">أحمد خالد</strong>
                      <div class="small text-secondary">علاج جذور • السن 46</div>
                    </div>
                  </div>
                  <div class="d-flex gap-2 align-items-center justify-content-between justify-content-md-end">
                    <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill">مكتمل</span>
                    <a class="btn btn-primary btn-sm px-3" href="visit">بدء الزيارة</a>
                  </div>
                </div>

                <!-- موعد 2 -->
                

                <!-- موعد 3 -->
                

              </div>
            </div>
          </div>

          <!-- يحتاج انتباهك -->
          <div class="col-xl-4">
            <div class="soft-card card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                  <h4 class="fw-bold mb-1 text-dark fs-5">يحتاج انتباهك</h4>
                  <div class="small text-secondary">أعمال مهمة قبل نهاية الدوام</div>
                </div>
                <span class="badge bg-danger rounded-pill px-2 py-1">5 مهام</span>
              </div>
              <div class="attention-list d-flex flex-column gap-2 mb-3">
                <a class="attention-item text-decoration-none p-3 rounded-3 border bg-light d-flex align-items-center gap-3 text-dark hover-shadow" href="reports">
                  <span class="attention-icon text-warning bg-warning-subtle p-2 rounded-circle d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;"><i class="bi bi-file-earmark-check"></i></span>
                  <span class="attention-copy flex-grow-1">
                    <strong class="d-block text-dark small">اعتماد تقرير طبي</strong>
                    <small class="text-muted" style="font-size: 0.75rem;">تقرير أحمد خالد ما زال مسودة.</small>
                  </span>
                  <span class="attention-side d-flex align-items-center gap-1">
                    <span class="badge text-bg-warning">1</span>
                    <i class="bi bi-chevron-left small text-muted"></i>
                  </span>
                </a>
                <a class="attention-item text-decoration-none p-3 rounded-3 border bg-light d-flex align-items-center gap-3 text-dark hover-shadow" href="lab-cases">
                  <span class="attention-icon text-primary bg-primary-subtle p-2 rounded-circle d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;"><i class="bi bi-box-seam"></i></span>
                  <span class="attention-copy flex-grow-1">
                    <strong class="d-block text-dark small">حالة مخبرية للاستكمال</strong>
                    <small class="text-muted" style="font-size: 0.75rem;">تاج تم استلامه وينتظر الإجراء السريري.</small>
                  </span>
                  <span class="attention-side d-flex align-items-center gap-1">
                    <span class="badge text-bg-primary">1</span>
                    <i class="bi bi-chevron-left small text-muted"></i>
                  </span>
                </a>
                <a class="attention-item text-decoration-none p-3 rounded-3 border bg-light d-flex align-items-center gap-3 text-dark hover-shadow" href="followups">
                  <span class="attention-icon text-info bg-info-subtle p-2 rounded-circle d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;"><i class="bi bi-arrow-repeat"></i></span>
                  <span class="attention-copy flex-grow-1">
                    <strong class="d-block text-dark small">متابعات مقترحة</strong>
                    <small class="text-muted" style="font-size: 0.75rem;">مريض واحد لديهم متابعة مقترحة.</small>
                  </span>
                  <span class="attention-side d-flex align-items-center gap-1">
                    <span class="badge text-bg-info">3</span>
                    <i class="bi bi-chevron-left small text-muted"></i>
                  </span>
                </a>
              </div>
              <div class="attention-note small bg-light p-3 rounded-3 text-muted border text-center">
                <i class="bi bi-info-circle text-primary ms-1"></i>تظهر هنا فقط المهام التي تحتاج إجراء منك كطبيب.
              </div>
            </div>
          </div>
        </div>

      </section>
    </main>

    <!-- الفوتر -->
    <%- include('../partials/doctor/footer') %>

    <!-- التوست (Toast) -->
    <div class="toast-container position-fixed bottom-0 start-0 p-3">
      <div class="toast align-items-center text-bg-primary border-0 shadow" id="appToast" role="alert">
        <div class="d-flex">
          <div class="toast-body">تمت العملية بنجاح</div>
          <button class="btn-close btn-close-white ms-2 m-auto" data-bs-dismiss="toast" type="button"></button>
        </div>
      </div>
    </div>

    <!-- السكريبتات -->
    <script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
    <!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="assets/app.js"></script>
  
<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button><div class="toast-container position-fixed bottom-0 start-0 p-3"><div id="backendPendingNotice" class="toast align-items-center text-bg-secondary border-0" role="status" aria-live="polite"><div class="d-flex"><div class="toast-body">هذه العملية بانتظار ربط الباك إند. لم تُحفظ أو تتغيّر أي بيانات.</div><button type="button" class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" aria-label="إغلاق"></button></div></div></div></body></html>