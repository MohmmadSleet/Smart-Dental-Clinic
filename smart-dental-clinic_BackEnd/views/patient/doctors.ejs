<!DOCTYPE html>
<html dir="rtl" lang="ar"><head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <title>الأطباء | Smart Dental Clinic</title>
    <link href="../assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
  <link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  </head>
  <body><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
    <%- include('../partials/patient/header') %>
    
    <main class="page-shell" id="main-content">
      <section class="container py-4 py-lg-5">
        <div class="row align-items-end g-3 mb-4">
          <div class="col-lg-6">
            <span class="badge badge-soft mb-2">Doctors</span>
            <h1 class="fw-bold">الأطباء</h1>
            <p class="text-secondary mb-0">
              ابحث عن طبيب حسب الاسم، التخصص، العيادة أو حالة التوفر.
            </p>
          </div>
          <div class="col-lg-6">
            <div class="input-group">
              <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
              <input class="form-control" id="doctorSearch" placeholder="ابحث باسم الطبيب أو التخصص" value="" data-ui-unbound-control="" name="doctor_search" form="backend-form-1">
            </div>
          </div>
        </div>
        <div class="filter-panel mb-4">
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label small fw-bold">التخصص</label>
              <select class="form-select" id="doctorSpecialtyFilter" data-ui-unbound-control="" name="doctor_specialty_filter" form="backend-form-2">
                <option value="all" selected>كل التخصصات</option>
                <option value="orthodontics">تقويم الأسنان</option>
                <option value="endodontics">علاج الجذور</option>
                <option value="cosmetic">تجميل الأسنان</option>
                <option value="surgery">جراحة وزراعة</option>
                <option value="children">أسنان الأطفال</option>
                <option value="general">طب أسنان عام</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold">العيادة</label>
              <select class="form-select" id="doctorClinicFilter" data-ui-unbound-control="" data-record-select="doctor" name="doctor_clinic_filter" form="backend-form-2"><option value="all" selected>كل العيادات</option><option value="D-108" data-record-option="doctor">د. عمر ناصر</option></select>
            </div>
            <div class="col-md-2">
              <label class="form-label small fw-bold">التوفر</label>
              <select class="form-select" id="doctorAvailabilityFilter" data-ui-unbound-control="" data-record-select="doctor" name="doctor_availability_filter" form="backend-form-2"><option value="all" selected>الكل</option><option value="D-108" data-record-option="doctor">د. عمر ناصر</option></select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
              <button class="btn btn-light w-100" id="clearDoctorFilters" data-ui-pending="">
                إعادة ضبط
              </button>
            </div>
          </div>
        </div>
        <div class="text-secondary small mb-3" id="doctorResultCount">
          طبيب واحد
        </div>
        <div class="row g-4" id="doctorsGrid">
          
          <div class="col-md-6 col-xl-4 doctor-filter-item" data-availability="available" data-clinic="smile" data-clinic-name="عيادة الابتسامة الحديثة" data-name="د. عمر ناصر" data-specialty="endodontics" data-record-id="D-108">
            <div class="doctor-catalog-card h-100">
              <img class="doctor-catalog-img" src="../assets/vendor/2fb6f2c869b1-photo-1612349317150-e413f6a5b16d.jpg" alt="د. عمر ناصر">
              <div class="p-4">
                <div class="d-flex justify-content-between gap-2">
                  <span class="badge badge-soft">علاج الجذور</span>
                  <span class="badge text-bg-success">متاح اليوم</span>
                </div>
                <h5 class="fw-bold mt-3 mb-1">د. عمر ناصر</h5>
                <div class="text-secondary small">عيادة الابتسامة الحديثة</div>
                <div class="doctor-card-meta mt-3">
                  <span><i class="bi bi-patch-check ms-1"></i>6 سنوات</span>
                  <span><i class="bi bi-star-fill text-warning ms-1"></i>4.8</span>
                </div>
                <div class="d-flex gap-2 mt-3">
                  <a class="btn btn-outline-primary flex-fill" href="doctor-details?doctor=omar">الملف</a>
                  <a class="btn btn-primary flex-fill" href="book-appointment?clinic=smile&amp;doctor=omar&amp;service=root">حجز</a>
                </div>
              </div>
            </div>
          </div>
          
          
          
          
        </div>
        <div class="empty-state d-none" id="doctorEmptyState">
          <i class="bi bi-person-x fs-1"></i>
          <h5 class="fw-bold mt-3">لا يوجد أطباء مطابقون</h5>
          <p class="text-secondary mb-0">
            جرّب تغيير التخصص أو العيادة أو حالة التوفر.
          </p>
        </div>
      </section>
    </main>
    <%- include('../partials/patient/footer') %>
    <div class="toast-container position-fixed bottom-0 start-0 p-3">
      <div class="toast align-items-center text-bg-primary border-0" id="appToast" role="alert">
        <div class="d-flex">
          <div class="toast-body">تمت العملية بنجاح</div>
          <button class="btn-close btn-close-white ms-2 m-auto" data-bs-dismiss="toast" type="button"></button>
        </div>
      </div>
    </div>
    <script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
