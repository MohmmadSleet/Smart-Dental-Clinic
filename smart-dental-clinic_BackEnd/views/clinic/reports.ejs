              <option value="quarter">آخر 3 أشهر</option>
              <option value="year">هذه السنة</option>
              <option value="custom">فترة مخصصة</option>
            </select>
            <div class="d-none align-items-end gap-2 flex-wrap" id="clinicCustomReportDates">
