              <div>
                <label class="form-label small text-secondary mb-1">إلى تاريخ</label>
                <input class="form-control" id="clinicReportTo" type="date" value="2026-10-21" name="clinic_report_to" form="backend-form-1">
              </div>
              <button class="btn btn-primary" id="applyClinicCustomReport" type="button" data-ui-pending="">
