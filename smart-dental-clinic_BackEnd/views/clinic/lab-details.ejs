<!DOCTYPE html>
<html dir="rtl" lang="ar"><head>
    <meta charset="utf-8">
    <meta content="width=device-width,initial-scale=1" name="viewport">
    <title>تفاصيل المختبر | Smart Dental Clinic</title>
    <link href="../assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
  <link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  </head>
  <body><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
    <%- include('../partials/clinic/header') %>
    

    
    <main class="page-shell" data-lab-details-page="" id="main-content">
      <section class="container py-4 py-lg-5">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3 mb-4">
          <div>
            <a class="small text-decoration-none" href="lab-cases"><i class="bi bi-arrow-right ms-1"></i>العودة للمختبرات</a>
            <div class="d-flex align-items-center gap-2 mt-2"><h1 class="fw-bold mb-0" id="labDetailName">Elite Dental Lab</h1><span class="badge text-bg-success" id="labDetailStatus">نشط</span></div>
            <div class="text-secondary mt-2"><span id="labDetailAddress">نابلس - رفيديا</span> • <span id="labDetailPhone">0599 123 456</span></div>
          </div>
          <div class="d-flex gap-2 flex-wrap"><button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editLabModal" type="button">إعدادات التعامل</button><button class="btn btn-outline-secondary" id="archiveCurrentLab" data-ui-pending="">أرشفة تعامل العيادة</button></div>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-6 col-lg-3"><div class="soft-card p-3"><small class="text-secondary">كل الحالات</small><div class="fs-3 fw-bold" id="labCasesTotal">4</div></div></div>
          <div class="col-6 col-lg-3"><div class="soft-card p-3"><small class="text-secondary">تم الإرسال</small><div class="fs-3 fw-bold text-info" id="labCasesSent">1</div></div></div>
          <div class="col-6 col-lg-3"><div class="soft-card p-3"><small class="text-secondary">تم الاستلام</small><div class="fs-3 fw-bold text-success" id="labCasesReceived">1</div></div></div>
          <div class="col-6 col-lg-3"><div class="soft-card p-3"><small class="text-secondary">متأخرة</small><div class="fs-3 fw-bold text-danger" id="labCasesOverdue">1</div></div></div>
        </div>

        <div class="filter-panel mb-4"><div class="row g-3"><div class="col-lg-5"><input class="form-control" id="labCaseSearch" placeholder="ابحث برقم الحالة أو المريض أو الطبيب أو نوع العمل" value="" data-ui-unbound-control="" name="lab_case_search" form="backend-form-1"></div><div class="col-lg-3"><select class="form-select" id="labCaseStatus" name="lab_case_status" form="backend-form-1"><option value="all" selected>كل الحالات</option><option value="waiting">بانتظار الإرسال</option><option value="sent">تم الإرسال</option><option value="received">تم الاستلام</option><option value="installed">تم التركيب</option></select></div><div class="col-lg-4"><select class="form-select" id="labCaseDoctor" data-record-select="doctor" name="lab_case_doctor" form="backend-form-1"><option value="all" selected>كل الأطباء</option><option value="D-108" data-record-option="doctor">د. عمر ناصر</option></select></div></div></div>

        <div class="soft-card p-3"><div class="table-responsive mobile-stack-wrapper table-ui-shell"><table class="table align-middle mb-0 wide-data-table responsive-stack-table system-data-table"><thead class="table-light"><tr><th>الرقم</th><th>المريض</th><th>الطبيب</th><th>العمل / السن</th><th>الحالة</th><th>التسليم المتوقع</th><th>الإجراء</th></tr></thead><tbody id="labCasesBody">
          <tr data-lab-case="" data-lab="elite" data-status="received" data-doctor="omar" data-search="LAB-001 أحمد خالد عمر تاج zirconia 46" data-record-id="LC-001"><td data-label="الرقم" class="table-primary-cell"><strong>LC-001</strong></td><td data-label="المريض">أحمد خالد</td><td data-label="الطبيب">د. عمر ناصر</td><td data-label="العمل / السن">تاج Zirconia<br><small class="text-secondary">سن 46 • A2</small></td><td data-label="الحالة" class="table-status-cell"><span class="badge text-bg-success" data-case-status-badge="">تم الاستلام</span></td><td data-label="التسليم المتوقع">21 أكتوبر 2026</td><td data-label="الإجراء" class="table-actions-cell"><div class="d-flex gap-1 flex-wrap table-action-grid"><button class="btn btn-sm btn-primary" data-lab-case-action="send" data-ui-pending="">تسجيل تم الإرسال</button><button class="btn btn-sm btn-light border" data-lab-transfer="" data-ui-open="#transferLabModal" type="button">نقل لمختبر</button></div></td></tr>
          
          
          

          
          
          
          
          
        </tbody></table></div><div class="text-center p-4 d-none" id="labCasesEmpty"><span class="text-secondary">لا توجد حالات مطابقة للفلاتر.</span></div></div>

        <div class="alert alert-info border-0 rounded-4 mt-4 mb-0"><strong>الصلاحيات:</strong> العيادة أو الموظف المخول يسجل <b>تم الإرسال</b> و<b>تم الاستلام</b>. الطبيب وحده يسجل <b>تم التركيب للمريض</b>.</div>
      </section>
    </main>
    
    <div class="modal fade" id="transferLabModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">
          <div class="modal-header">
            <div>
              <h5 class="modal-title fw-bold">نقل الحالة إلى مختبر آخر</h5>
              <small class="text-secondary" id="transferLabCaseLabel">اختر مختبراً نشطاً قبل تسجيل الإرسال.</small>
            </div>
            <button class="btn-close" data-bs-dismiss="modal" type="button"></button>
          </div>
          <div class="modal-body">
            <label class="form-label">المختبر الجديد</label>
            <select class="form-select" id="transferLabSelect" name="transfer_lab_select" form="backend-form-2"><option value="LAB-001" selected>Elite Dental Lab — مختبر نشط</option></select>
            <div class="alert alert-warning border-0 rounded-3 mt-3 mb-0 small">
              يمكن نقل الحالة فقط وهي بحالة <b>بانتظار الإرسال</b>. بعد تسجيل الإرسال لا يمكن نقلها من هذه الشاشة.
            </div>
          </div>
          <div class="modal-footer">
            <button class="btn btn-light" data-bs-dismiss="modal" type="button">إلغاء</button>
            <button class="btn btn-primary" id="confirmLabTransfer" data-ui-pending="" form="backend-form-2" type="submit">تأكيد النقل</button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="editLabModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content border-0 rounded-4"><div class="modal-header"><div><h5 class="modal-title fw-bold">إعدادات تعامل العيادة مع المختبر</h5><small class="text-secondary">الملاحظات وحالة التعامل خاصة بهذه العيادة. بيانات المختبر العامة يديرها مدير المنصة.</small></div><button class="btn-close" data-bs-dismiss="modal" type="button"></button></div><div class="modal-body"><div class="row g-3"><div class="col-12"><label class="form-label">ملاحظات داخلية</label><textarea class="form-control" id="editLabNotes" rows="3" name="edit_lab_notes" form="backend-form-3">متخصص بأعمال الزيركون والتيجان.</textarea></div></div><label class="form-label mt-3" for="clinicLabRelationshipStatus">حالة التعامل داخل العيادة</label><select class="form-select" id="clinicLabRelationshipStatus" name="relationship_status" form="backend-form-3"><option value="active">نشط</option><option value="archived">مؤرشف</option></select></div><div class="modal-footer"><button class="btn btn-light" data-bs-dismiss="modal" type="button">إلغاء</button><button class="btn btn-primary" id="saveClinicLabEdit" data-ui-pending="" form="backend-form-3" type="submit">حفظ التعديل</button></div></div></div></div>
    <%- include('../partials/clinic/footer') %>
    <div class="toast-container position-fixed bottom-0 start-0 p-3">
      <div class="toast align-items-center text-bg-primary border-0" id="appToast">
        <div class="d-flex">
          <div class="toast-body">تمت العملية</div>
          <button class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" type="button"></button>
        </div>
      </div>
    </div>
    <script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
  <!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="assets/app.js"></script>


<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button><div class="toast-container position-fixed bottom-0 start-0 p-3"><div id="backendPendingNotice" class="toast align-items-center text-bg-secondary border-0" role="status" aria-live="polite"><div class="d-flex"><div class="toast-body">هذه العملية بانتظار ربط الباك إند. لم تُحفظ أو تتغيّر أي بيانات.</div><button type="button" class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" aria-label="إغلاق"></button></div></div></div><form id="backend-form-1" method="get" data-ui-unbound="" data-backend-binding="filter" hidden=""></form><form id="backend-form-2" method="post" data-ui-unbound="" data-backend-binding="modal" hidden=""></form><form id="backend-form-3" method="post" data-ui-unbound="" data-backend-binding="modal" hidden=""></form></body></html>