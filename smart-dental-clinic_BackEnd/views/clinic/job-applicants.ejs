                <tr>
                  <th>المتقدم</th>
                  <th>الوظيفة</th>
                  <th>التخصص</th>
                  <th>الخبرة</th>
                  <th>تاريخ التقديم</th>
                  <th style="min-width: 190px">الحالة</th>
                  <th>الإجراءات</th>
                </tr>
              </thead>
              <tbody>
                <tr class="applicant-row" data-search="د. عمر ناصر J-101 • طبيب/ة تقويم أسنان تقويم الأسنان" data-status="review">
