                    <strong>د. عمر ناصر</strong>
                    <div class="small text-secondary">doctor@example.test</div>
                  </td>
                  <td data-label="الوظيفة">J-101 • طبيب/ة تقويم أسنان</td>
                  <td data-label="التخصص">تقويم الأسنان</td>
                  <td data-label="الخبرة">3 سنوات</td>
                  <td data-label="تاريخ التقديم">21 أكتوبر 2026</td>
                  <td data-label="الحالة">
                    <select class="form-select form-select-sm applicant-status-select" id="field-1" name="field_1" form="backend-form-3">
                      <option selected value="review">قيد المراجعة</option>
                      <option value="accepted">مقبول</option>
                      <option value="rejected">مرفوض</option>
                    </select>
                  </td>
                  <td data-label="الإجراءات" class="table-actions-cell">
                    <div class="d-flex gap-2 table-action-grid">
                      <button class="btn btn-sm btn-primary" data-applicant-save="" data-ui-pending="" form="backend-form-3" type="submit">
                        حفظ</button><a class="btn btn-sm btn-outline-primary" href="application-details?id=JA-205">عرض الطلب</a>
