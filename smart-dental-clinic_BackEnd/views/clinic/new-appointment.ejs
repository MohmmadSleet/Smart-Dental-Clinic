<!DOCTYPE html>
<html data-style-sections="section-8" dir="rtl" lang="ar"><head>
    <meta charset="utf-8">
    <meta content="width=device-width,initial-scale=1" name="viewport">
    <title>إضافة موعد | Smart Dental Clinic</title>
    <link href="../assets/vendor/937abe4f713b-bootstrap.rtl.min.css" rel="stylesheet">
    <link href="../assets/vendor/28667e4f82c7-bootstrap-icons.css" rel="stylesheet">
    <!-- ملف CSS الوحيد الخاص بهذه المجموعة -->
<link rel="stylesheet" href="assets/styles.css">
  <link href="../assets/vendor/8c34d74036e9-css2-fonts.css" rel="stylesheet">

    
  </head>
  <body><a class="ux-skip" href="#main-content">تخطي إلى المحتوى</a>
    <%- include('../partials/clinic/header') %>
    
    <main class="page-shell" id="main-content">
      <section class="container py-4 py-lg-5">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item">
              <a href="appointments">المواعيد</a>
            </li>
            <li class="breadcrumb-item active">إضافة موعد</li>
          </ol>
        </nav>
        <div class="row justify-content-center">
          <div class="col-xl-9">
            <div class="mb-4">
              <span class="badge badge-soft mb-2">Clinic Booking</span>
              <h1 class="fw-bold">إضافة موعد من العيادة</h1>
              <p class="text-secondary mb-0">
                يمكن لموظف العيادة حجز موعد للمريض مباشرة حسب الطبيب والخدمة
                والأوقات المتاحة.
              </p>
            </div>
            <div class="soft-card p-4 p-lg-5">
              <div class="row g-4">
                <div class="col-md-6">
                  <label class="form-label fw-bold">المريض</label>
                  <select class="form-select" id="clinicBookingPatient" data-record-select="patient" name="patient_id" form="backend-form-1"><option value="P-2048" selected data-record-option="patient">أحمد خالد</option></select>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-bold">الطبيب</label>
                  <select class="form-select" id="clinicBookingDoctor" data-record-select="doctor" name="doctor_id" form="backend-form-1"><option value="D-108" selected data-record-option="doctor">د. عمر ناصر</option></select>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-bold">الخدمة</label>
                  <select class="form-select" id="clinicBookingService" data-record-select="service" name="service_id" form="backend-form-1"><option selected value="S-001" data-record-option="service">علاج جذور — 500 ₪ — 60 دقيقة</option></select><div class="small text-secondary mt-2">خدمات هذه العيادة المخصصة للطبيب المختار فقط؛ السعر والمدة من كتالوج العيادة.</div>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-bold">التاريخ</label>
                  <input class="form-control" id="clinicBookingDate" type="date" value="2026-10-21" name="clinic_booking_date" form="backend-form-1">
                </div>
                <div class="col-12">
                  <label class="form-label fw-bold">الوقت</label>
                  <div class="slot-grid"><div class="slot-choice"><input type="radio" name="appointment_time" value="09:00" id="booking-time-0-9" class="visually-hidden" required="" form="backend-form-1"><label class="time-slot available btn btn-light w-100" for="booking-time-0-9">9:00 ص</label></div><div class="slot-choice"><input type="radio" name="appointment_time" value="10:00" id="booking-time-0-10" class="visually-hidden" required="" form="backend-form-1"><label class="time-slot available btn btn-light w-100" for="booking-time-0-10">10:00 ص</label></div><div class="slot-choice"><input type="radio" name="appointment_time" value="11:00" id="booking-time-0-11" class="visually-hidden" required="" form="backend-form-1"><label class="time-slot available btn btn-light w-100" for="booking-time-0-11">11:00 ص</label></div><div class="slot-choice"><input type="radio" name="appointment_time" value="12:00" id="booking-time-0-12" class="visually-hidden" required="" form="backend-form-1"><label class="time-slot available btn btn-light w-100" for="booking-time-0-12">12:00 م</label></div><div class="slot-choice"><input type="radio" name="appointment_time" value="13:00" id="booking-time-0-13" class="visually-hidden" required="" form="backend-form-1"><label class="time-slot available btn btn-light w-100" for="booking-time-0-13">1:00 م</label></div><div class="slot-choice"><input type="radio" name="appointment_time" value="14:00" id="booking-time-0-14" class="visually-hidden" required="" form="backend-form-1"><label class="time-slot available btn btn-light w-100" for="booking-time-0-14">2:00 م</label></div><div class="slot-choice"><input type="radio" name="appointment_time" value="15:00" id="booking-time-0-15" class="visually-hidden" required="" form="backend-form-1"><label class="time-slot available btn btn-light w-100" for="booking-time-0-15">3:00 م</label></div><div class="slot-choice"><input type="radio" name="appointment_time" value="16:00" id="booking-time-0-16" class="visually-hidden" required="" form="backend-form-1"><label class="time-slot available btn btn-light w-100" for="booking-time-0-16">4:00 م</label></div></div>
                  <div class="small text-secondary mt-2">
                    الأوقات المشطوبة غير متاحة.
                  </div>
                </div>
                <div class="col-12">
                  <label class="form-label fw-bold">ملاحظات إدارية / ملاحظات المريض</label>
                  <textarea class="form-control" id="clinicBookingNotes" placeholder="ملاحظة اختيارية..." rows="4" name="clinic_booking_notes" form="backend-form-1"></textarea>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-bold">حالة الموعد</label>
                  <select class="form-select" id="clinicBookingStatus" name="clinic_booking_status" form="backend-form-1">
                    <option selected>مؤكد</option>
                    <option>بانتظار الموافقة</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-bold">نوع الحجز</label>
                  <select class="form-select" id="clinicBookingType" data-record-select="clinic" name="clinic_booking_type" form="backend-form-1"><option value="C-008" selected data-record-option="clinic">عيادة الابتسامة الحديثة</option></select>
                </div>
              </div>
              <div class="d-flex justify-content-end gap-2 mt-4">
                <a class="btn btn-light" href="appointments">إلغاء</a>
                <button class="btn btn-primary" id="saveClinicAppointmentBtn" data-ui-pending="" form="backend-form-1" type="submit">
                  حفظ الموعد
                </button>
              </div>
              <div class="d-none alert alert-success rounded-4 mt-4 mb-0" id="clinicBookingResult"></div>
            </div>
          </div>
        </div>
      </section>
    </main>
    <%- include('../partials/clinic/footer') %>
    <div class="toast-container position-fixed bottom-0 start-0 p-3">
      <div class="toast align-items-center text-bg-primary border-0" id="appToast">
        <div class="d-flex">
          <div class="toast-body">تمت العملية</div>
          <button class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" type="button"></button>
        </div>
      </div>
    </div>
    <script src="../assets/vendor/8d95173bee2e-bootstrap.bundle.min.js"></script>
    
  <!-- تفاعلات هذا الدور فقط؛ Bootstrap محمّل قبله. -->
<script src="assets/app.js"></script>


<button type="button" class="ux-top" aria-label="العودة للأعلى"><i class="bi bi-arrow-up"></i></button><div class="toast-container position-fixed bottom-0 start-0 p-3"><div id="backendPendingNotice" class="toast align-items-center text-bg-secondary border-0" role="status" aria-live="polite"><div class="d-flex"><div class="toast-body">هذه العملية بانتظار ربط الباك إند. لم تُحفظ أو تتغيّر أي بيانات.</div><button type="button" class="btn-close btn-close-white m-auto ms-2" data-bs-dismiss="toast" aria-label="إغلاق"></button></div></div></div><form id="backend-form-1" method="post" data-ui-unbound="" data-backend-binding="section" hidden=""></form></body></html>